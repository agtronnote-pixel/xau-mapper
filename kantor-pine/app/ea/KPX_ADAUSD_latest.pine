//@version=6
indicator("KPX Mapping ADAUSD 202611250031", overlay=true, max_lines_count=100, max_boxes_count=20, max_labels_count=60)
// Dibuat otomatis oleh Kantor Pine (ADAUSD) dari mapping 2026-11-24T17:31:24.330Z (harga 0.14530).
// Bukan nasihat keuangan. Konfirmasi di chart dan selalu gunakan stop loss.
offset = input.float(0.0, "Selisih harga broker - mapping (USD)", group="Umum", tooltip="Isi bila harga broker berbeda dari harga mapping")
showLevels = input.bool(true, "Tampilkan level kunci", group="Tampilan")
showPlans = input.bool(true, "Tampilkan rencana entry", group="Tampilan")

drawLine(float p, color c, string t, bool solid) =>
    line.new(bar_index - 1, p + offset, bar_index, p + offset, extend=extend.both, color=c, style=solid ? line.style_solid : line.style_dashed, width=1)
    label.new(bar_index + 3, p + offset, t + " " + str.tostring(p + offset, "#.00"), style=label.style_none, textcolor=c, size=size.small)

var bool drawn = false
if barstate.islast and not drawn
    drawn := true
    if showLevels
        drawLine(0.15640, color.red, "R High kemarin (PDH)", false)
        drawLine(0.15090, color.red, "R Swing high H1", false)
        drawLine(0.14990, color.red, "R Swing high H1", false)
        drawLine(0.14900, color.gray, "P Pivot harian", false)
        drawLine(0.14750, color.red, "R Swing high H1", false)
        drawLine(0.14650, color.red, "R Swing low H1", false)
        drawLine(0.14560, color.red, "R Swing low H1", false)
        drawLine(0.14490, color.green, "S Swing low H1", false)
        drawLine(0.14400, color.green, "S Angka bulat", false)
        drawLine(0.14200, color.green, "S Low kemarin (PDL)", false)
    if showPlans
        box.new(bar_index - 20, 0.14688 + offset, bar_index + 40, 0.14612 + offset, border_color=color.red, bgcolor=color.new(color.red, 85), text="SELL Utama 70%", text_color=color.red, text_size=size.small)
        drawLine(0.14860, color.red, "SL SELL", true)
        drawLine(0.14400, color.blue, "TP1 SELL", true)
        drawLine(0.14200, color.blue, "TP2 SELL", true)
        box.new(bar_index - 20, 0.14528 + offset, bar_index + 40, 0.14452 + offset, border_color=color.green, bgcolor=color.new(color.green, 85), text="BUY Alternatif 19%", text_color=color.green, text_size=size.small)
        drawLine(0.14280, color.red, "SL BUY", true)
        drawLine(0.14750, color.blue, "TP1 BUY", true)
        drawLine(0.14900, color.blue, "TP2 BUY", true)

inZone0 = close >= 0.14612 + offset and close <= 0.14688 + offset
alertcondition(inZone0 and not inZone0[1], "KPX SELL Utama: masuk zona", "ADAUSD masuk zona SELL {{close}} - EA entry")
inZone1 = close >= 0.14452 + offset and close <= 0.14528 + offset
alertcondition(inZone1 and not inZone1[1], "KPX BUY Alternatif: masuk zona", "ADAUSD masuk zona BUY {{close}} - EA entry")
plot(na, "KPX")
