//@version=6
indicator("KPX Mapping ADAUSD 202611230004", overlay=true, max_lines_count=100, max_boxes_count=20, max_labels_count=60)
// Dibuat otomatis oleh Kantor Pine (ADAUSD) dari mapping 2026-11-22T17:04:08.257Z (harga 0.14470).
// Bukan nasihat keuangan. Konfirmasi di chart dan selalu gunakan stop loss.
offset = input.float(0.0, "Selisih harga broker - mapping (USD)", group="Umum", tooltip="Isi bila harga broker berbeda dari harga mapping")
showLevels = input.bool(true, "Tampilkan level kunci", group="Tampilan")
showPlans = input.bool(true, "Tampilkan rencana entry", group="Tampilan")

drawLine(float p, color c, string t, bool solid) =>
    line.new(bar_index - 1, p + offset, bar_index, p + offset, extend=extend.both, color=c, style=solid ? line.style_solid : line.style_dashed, width=1)
    label.new(bar_index + 3, p + offset, t + " " + str.tostring(p + offset, "#.00"), style=label.style_none, textcolor=c, size=size.small)

var bool drawn = false
if barstate.islast and not drawn
    drawn := true
    if showLevels
        drawLine(0.14930, color.red, "R R1 harian", false)
        drawLine(0.14750, color.red, "R Swing high H1", false)
        drawLine(0.14670, color.red, "R Swing high H1", false)
        drawLine(0.14620, color.red, "R High kemarin (PDH)", false)
        drawLine(0.14530, color.red, "R Swing high H1", false)
        drawLine(0.14390, color.green, "S Swing low H1", false)
        drawLine(0.14130, color.gray, "P Pivot harian", false)
        drawLine(0.14090, color.green, "S Swing low H1", false)
        drawLine(0.13640, color.green, "S S1 harian", false)
        drawLine(0.13330, color.green, "S Low kemarin (PDL)", false)
    if showPlans
        box.new(bar_index - 20, 0.14561 + offset, bar_index + 40, 0.14499 + offset, border_color=color.red, bgcolor=color.new(color.red, 85), text="SELL Range 55%", text_color=color.red, text_size=size.small)
        drawLine(0.14699, color.red, "SL SELL", true)
        drawLine(0.14276, color.blue, "TP1 SELL", true)
        drawLine(0.14130, color.blue, "TP2 SELL", true)
        box.new(bar_index - 20, 0.14421 + offset, bar_index + 40, 0.14359 + offset, border_color=color.green, bgcolor=color.new(color.green, 85), text="BUY Range 47%", text_color=color.green, text_size=size.small)
        drawLine(0.14221, color.red, "SL BUY", true)
        drawLine(0.14620, color.blue, "TP1 BUY", true)
        drawLine(0.14750, color.blue, "TP2 BUY", true)

inZone0 = close >= 0.14499 + offset and close <= 0.14561 + offset
alertcondition(inZone0 and not inZone0[1], "KPX SELL Range: masuk zona", "ADAUSD masuk zona SELL {{close}} - EA entry")
inZone1 = close >= 0.14359 + offset and close <= 0.14421 + offset
alertcondition(inZone1 and not inZone1[1], "KPX BUY Range: masuk zona", "ADAUSD masuk zona BUY {{close}} - EA entry")
plot(na, "KPX")
