//@version=6
indicator("KPX Mapping ADAUSD 202611270607", overlay=true, max_lines_count=100, max_boxes_count=20, max_labels_count=60)
// Dibuat otomatis oleh Kantor Pine (ADAUSD) dari mapping 2026-11-26T23:07:24.038Z (harga 0.14830).
// Bukan nasihat keuangan. Konfirmasi di chart dan selalu gunakan stop loss.
offset = input.float(0.0, "Selisih harga broker - mapping (USD)", group="Umum", tooltip="Isi bila harga broker berbeda dari harga mapping")
showLevels = input.bool(true, "Tampilkan level kunci", group="Tampilan")
showPlans = input.bool(true, "Tampilkan rencana entry", group="Tampilan")

drawLine(float p, color c, string t, bool solid) =>
    line.new(bar_index - 1, p + offset, bar_index, p + offset, extend=extend.both, color=c, style=solid ? line.style_solid : line.style_dashed, width=1)
    label.new(bar_index + 3, p + offset, t + " " + str.tostring(p + offset, "#.00"), style=label.style_none, textcolor=c, size=size.small)

var bool drawn = false
if barstate.islast and not drawn
    drawn := true
    if showLevels
        drawLine(0.15140, color.red, "R Swing high H1", false)
        drawLine(0.15073, color.red, "R R1 harian", false)
        drawLine(0.15000, color.red, "R Swing high H1", false)
        drawLine(0.14950, color.red, "R Swing high H1", false)
        drawLine(0.14900, color.red, "R Angka bulat", false)
        drawLine(0.14800, color.green, "S High kemarin (PDH)", false)
        drawLine(0.14730, color.green, "S Swing low H1", false)
        drawLine(0.14580, color.green, "S Swing low H1", false)
        drawLine(0.14490, color.green, "S Swing low H1", false)
        drawLine(0.14317, color.gray, "P Pivot harian", false)
        drawLine(0.13833, color.green, "S S1 harian", false)
        drawLine(0.13560, color.green, "S Low kemarin (PDL)", false)
    if showPlans
        box.new(bar_index - 20, 0.14826 + offset, bar_index + 40, 0.14774 + offset, border_color=color.green, bgcolor=color.new(color.green, 85), text="BUY Range 53%", text_color=color.green, text_size=size.small)
        drawLine(0.14659, color.red, "SL BUY", true)
        drawLine(0.14950, color.blue, "TP1 BUY", true)
        drawLine(0.15073, color.blue, "TP2 BUY", true)
        box.new(bar_index - 20, 0.14926 + offset, bar_index + 40, 0.14874 + offset, border_color=color.red, bgcolor=color.new(color.red, 85), text="SELL Range 47%", text_color=color.red, text_size=size.small)
        drawLine(0.15041, color.red, "SL SELL", true)
        drawLine(0.14730, color.blue, "TP1 SELL", true)
        drawLine(0.14580, color.blue, "TP2 SELL", true)

inZone0 = close >= 0.14774 + offset and close <= 0.14826 + offset
alertcondition(inZone0 and not inZone0[1], "KPX BUY Range: masuk zona", "ADAUSD masuk zona BUY {{close}} - EA entry")
inZone1 = close >= 0.14874 + offset and close <= 0.14926 + offset
alertcondition(inZone1 and not inZone1[1], "KPX SELL Range: masuk zona", "ADAUSD masuk zona SELL {{close}} - EA entry")
plot(na, "KPX")
