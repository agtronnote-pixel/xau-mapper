//@version=6
indicator("KPX Mapping ADAUSD 202611280107", overlay=true, max_lines_count=100, max_boxes_count=20, max_labels_count=60)
// Dibuat otomatis oleh Kantor Pine (ADAUSD) dari mapping 2026-11-27T18:07:26.961Z (harga 0.14940).
// Bukan nasihat keuangan. Konfirmasi di chart dan selalu gunakan stop loss.
offset = input.float(0.0, "Selisih harga broker - mapping (USD)", group="Umum", tooltip="Isi bila harga broker berbeda dari harga mapping")
showLevels = input.bool(true, "Tampilkan level kunci", group="Tampilan")
showPlans = input.bool(true, "Tampilkan rencana entry", group="Tampilan")

drawLine(float p, color c, string t, bool solid) =>
    line.new(bar_index - 1, p + offset, bar_index, p + offset, extend=extend.both, color=c, style=solid ? line.style_solid : line.style_dashed, width=1)
    label.new(bar_index + 3, p + offset, t + " " + str.tostring(p + offset, "#.00"), style=label.style_none, textcolor=c, size=size.small)

var bool drawn = false
if barstate.islast and not drawn
    drawn := true
    if showLevels
        drawLine(0.15390, color.red, "R Swing high H1", false)
        drawLine(0.15230, color.red, "R Swing high H1", false)
        drawLine(0.15140, color.red, "R High kemarin (PDH)", false)
        drawLine(0.15000, color.red, "R Angka bulat", false)
        drawLine(0.14900, color.green, "S Angka bulat", false)
        drawLine(0.14853, color.gray, "P Pivot harian", false)
        drawLine(0.14790, color.green, "S Swing low H1", false)
        drawLine(0.14730, color.green, "S Swing low H1", false)
        drawLine(0.14560, color.green, "S Low kemarin (PDL)", false)
    if showPlans
        box.new(bar_index - 20, 0.15036 + offset, bar_index + 40, 0.14964 + offset, border_color=color.red, bgcolor=color.new(color.red, 85), text="SELL Utama 59%", text_color=color.red, text_size=size.small)
        drawLine(0.15200, color.red, "SL SELL", true)
        drawLine(0.14790, color.blue, "TP1 SELL", true)
        drawLine(0.14560, color.blue, "TP2 SELL", true)
        box.new(bar_index - 20, 0.14936 + offset, bar_index + 40, 0.14864 + offset, border_color=color.green, bgcolor=color.new(color.green, 85), text="BUY Alternatif 41%", text_color=color.green, text_size=size.small)
        drawLine(0.14700, color.red, "SL BUY", true)
        drawLine(0.15140, color.blue, "TP1 BUY", true)
        drawLine(0.15390, color.blue, "TP2 BUY", true)

inZone0 = close >= 0.14964 + offset and close <= 0.15036 + offset
alertcondition(inZone0 and not inZone0[1], "KPX SELL Utama: masuk zona", "ADAUSD masuk zona SELL {{close}} - EA entry")
inZone1 = close >= 0.14864 + offset and close <= 0.14936 + offset
alertcondition(inZone1 and not inZone1[1], "KPX BUY Alternatif: masuk zona", "ADAUSD masuk zona BUY {{close}} - EA entry")
plot(na, "KPX")
