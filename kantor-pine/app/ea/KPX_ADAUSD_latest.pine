//@version=6
indicator("KPX Mapping ADAUSD 202611221617", overlay=true, max_lines_count=100, max_boxes_count=20, max_labels_count=60)
// Dibuat otomatis oleh Kantor Pine (ADAUSD) dari mapping 2026-11-22T09:17:49.783Z (harga 0.14390).
// Bukan nasihat keuangan. Konfirmasi di chart dan selalu gunakan stop loss.
offset = input.float(0.0, "Selisih harga broker - mapping (USD)", group="Umum", tooltip="Isi bila harga broker berbeda dari harga mapping")
showLevels = input.bool(true, "Tampilkan level kunci", group="Tampilan")
showPlans = input.bool(true, "Tampilkan rencana entry", group="Tampilan")

drawLine(float p, color c, string t, bool solid) =>
    line.new(bar_index - 1, p + offset, bar_index, p + offset, extend=extend.both, color=c, style=solid ? line.style_solid : line.style_dashed, width=1)
    label.new(bar_index + 3, p + offset, t + " " + str.tostring(p + offset, "#.00"), style=label.style_none, textcolor=c, size=size.small)

var bool drawn = false
if barstate.islast and not drawn
    drawn := true
    if showLevels
        drawLine(0.14943, color.red, "R R1 harian", false)
        drawLine(0.14620, color.red, "R High kemarin (PDH)", false)
        drawLine(0.14530, color.red, "R Swing high H1", false)
        drawLine(0.14380, color.green, "S Swing high H1", false)
        drawLine(0.14300, color.green, "S Angka bulat", false)
        drawLine(0.14137, color.gray, "P Pivot harian", false)
        drawLine(0.14090, color.green, "S Swing low H1", false)
        drawLine(0.13790, color.green, "S Swing low H1", false)
        drawLine(0.13653, color.green, "S S1 harian", false)
        drawLine(0.13330, color.green, "S Low kemarin (PDL)", false)
    if showPlans
        box.new(bar_index - 20, 0.14554 + offset, bar_index + 40, 0.14506 + offset, border_color=color.red, bgcolor=color.new(color.red, 85), text="SELL Utama 73%", text_color=color.red, text_size=size.small)
        drawLine(0.14663, color.red, "SL SELL", true)
        drawLine(0.14300, color.blue, "TP1 SELL", true)
        drawLine(0.14137, color.blue, "TP2 SELL", true)
        box.new(bar_index - 20, 0.14324 + offset, bar_index + 40, 0.14276 + offset, border_color=color.green, bgcolor=color.new(color.green, 85), text="BUY Alternatif 31%", text_color=color.green, text_size=size.small)
        drawLine(0.14167, color.red, "SL BUY", true)
        drawLine(0.14530, color.blue, "TP1 BUY", true)
        drawLine(0.14620, color.blue, "TP2 BUY", true)

inZone0 = close >= 0.14506 + offset and close <= 0.14554 + offset
alertcondition(inZone0 and not inZone0[1], "KPX SELL Utama: masuk zona", "ADAUSD masuk zona SELL {{close}} - tunggu konfirmasi")
inZone1 = close >= 0.14276 + offset and close <= 0.14324 + offset
alertcondition(inZone1 and not inZone1[1], "KPX BUY Alternatif: masuk zona", "ADAUSD masuk zona BUY {{close}} - tunggu konfirmasi")
plot(na, "KPX")
