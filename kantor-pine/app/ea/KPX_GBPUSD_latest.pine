//@version=6
indicator("KPX Mapping GBPUSD 202611240607", overlay=true, max_lines_count=100, max_boxes_count=20, max_labels_count=60)
// Dibuat otomatis oleh Kantor Pine (GBPUSD) dari mapping 2026-11-23T23:07:29.242Z (harga 1.31003).
// Bukan nasihat keuangan. Konfirmasi di chart dan selalu gunakan stop loss.
offset = input.float(0.0, "Selisih harga broker - mapping (USD)", group="Umum", tooltip="Isi bila harga broker berbeda dari harga mapping")
showLevels = input.bool(true, "Tampilkan level kunci", group="Tampilan")
showPlans = input.bool(true, "Tampilkan rencana entry", group="Tampilan")

drawLine(float p, color c, string t, bool solid) =>
    line.new(bar_index - 1, p + offset, bar_index, p + offset, extend=extend.both, color=c, style=solid ? line.style_solid : line.style_dashed, width=1)
    label.new(bar_index + 3, p + offset, t + " " + str.tostring(p + offset, "#.00"), style=label.style_none, textcolor=c, size=size.small)

var bool drawn = false
if barstate.islast and not drawn
    drawn := true
    if showLevels
        drawLine(1.31500, color.red, "R Angka bulat", false)
        drawLine(1.31442, color.red, "R High kemarin (PDH)", false)
        drawLine(1.31280, color.red, "R Swing high H1", false)
        drawLine(1.31220, color.red, "R Swing high H1", false)
        drawLine(1.31138, color.red, "R R1 harian", false)
        drawLine(1.31056, color.red, "R Swing high H1", false)
        drawLine(1.31000, color.green, "S Angka bulat", false)
        drawLine(1.30950, color.green, "S Swing low H1", false)
        drawLine(1.30763, color.green, "S Swing low H1", false)
        drawLine(1.30626, color.gray, "P Pivot harian", false)
        drawLine(1.30500, color.green, "S Angka bulat", false)
        drawLine(1.30115, color.green, "S Low kemarin (PDL)", false)
        drawLine(1.29811, color.green, "S S1 harian", false)
    if showPlans
        box.new(bar_index - 20, 1.31092 + offset, bar_index + 40, 1.31020 + offset, border_color=color.red, bgcolor=color.new(color.red, 85), text="SELL Utama 61%", text_color=color.red, text_size=size.small)
        drawLine(1.31253, color.red, "SL SELL", true)
        drawLine(1.30763, color.blue, "TP1 SELL", true)
        drawLine(1.30626, color.blue, "TP2 SELL", true)
        box.new(bar_index - 20, 1.30986 + offset, bar_index + 40, 1.30914 + offset, border_color=color.green, bgcolor=color.new(color.green, 85), text="BUY Alternatif 26%", text_color=color.green, text_size=size.small)
        drawLine(1.30753, color.red, "SL BUY", true)
        drawLine(1.31220, color.blue, "TP1 BUY", true)
        drawLine(1.31442, color.blue, "TP2 BUY", true)

inZone0 = close >= 1.31020 + offset and close <= 1.31092 + offset
alertcondition(inZone0 and not inZone0[1], "KPX SELL Utama: masuk zona", "GBPUSD masuk zona SELL {{close}} - EA entry")
inZone1 = close >= 1.30914 + offset and close <= 1.30986 + offset
alertcondition(inZone1 and not inZone1[1], "KPX BUY Alternatif: masuk zona", "GBPUSD masuk zona BUY {{close}} - EA entry")
plot(na, "KPX")
