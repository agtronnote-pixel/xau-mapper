//@version=6
indicator("KPX Mapping GBPUSD 202611270607", overlay=true, max_lines_count=100, max_boxes_count=20, max_labels_count=60)
// Dibuat otomatis oleh Kantor Pine (GBPUSD) dari mapping 2026-11-26T23:07:26.987Z (harga 1.31139).
// Bukan nasihat keuangan. Konfirmasi di chart dan selalu gunakan stop loss.
offset = input.float(0.0, "Selisih harga broker - mapping (USD)", group="Umum", tooltip="Isi bila harga broker berbeda dari harga mapping")
showLevels = input.bool(true, "Tampilkan level kunci", group="Tampilan")
showPlans = input.bool(true, "Tampilkan rencana entry", group="Tampilan")

drawLine(float p, color c, string t, bool solid) =>
    line.new(bar_index - 1, p + offset, bar_index, p + offset, extend=extend.both, color=c, style=solid ? line.style_solid : line.style_dashed, width=1)
    label.new(bar_index + 3, p + offset, t + " " + str.tostring(p + offset, "#.00"), style=label.style_none, textcolor=c, size=size.small)

var bool drawn = false
if barstate.islast and not drawn
    drawn := true
    if showLevels
        drawLine(1.31500, color.red, "R Angka bulat", false)
        drawLine(1.31297, color.red, "R Swing high H1", false)
        drawLine(1.31234, color.red, "R High kemarin (PDH)", false)
        drawLine(1.31196, color.red, "R Swing high H1", false)
        drawLine(1.31087, color.gray, "P Pivot harian", false)
        drawLine(1.31000, color.green, "S Angka bulat", false)
        drawLine(1.30964, color.green, "S Low kemarin (PDL)", false)
        drawLine(1.30500, color.green, "S Angka bulat", false)
        drawLine(1.30463, color.green, "S Swing low H1", false)
    if showPlans
        box.new(bar_index - 20, 1.31215 + offset, bar_index + 40, 1.31177 + offset, border_color=color.red, bgcolor=color.new(color.red, 85), text="SELL Range 51%", text_color=color.red, text_size=size.small)
        drawLine(1.31299, color.red, "SL SELL", true)
        drawLine(1.31087, color.blue, "TP1 SELL", true)
        drawLine(1.31000, color.blue, "TP2 SELL", true)
        box.new(bar_index - 20, 1.31106 + offset, bar_index + 40, 1.31068 + offset, border_color=color.green, bgcolor=color.new(color.green, 85), text="BUY Range 48%", text_color=color.green, text_size=size.small)
        drawLine(1.30984, color.red, "SL BUY", true)
        drawLine(1.31196, color.blue, "TP1 BUY", true)
        drawLine(1.31297, color.blue, "TP2 BUY", true)

inZone0 = close >= 1.31177 + offset and close <= 1.31215 + offset
alertcondition(inZone0 and not inZone0[1], "KPX SELL Range: masuk zona", "GBPUSD masuk zona SELL {{close}} - EA entry")
inZone1 = close >= 1.31068 + offset and close <= 1.31106 + offset
alertcondition(inZone1 and not inZone1[1], "KPX BUY Range: masuk zona", "GBPUSD masuk zona BUY {{close}} - EA entry")
plot(na, "KPX")
