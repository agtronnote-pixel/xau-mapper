//@version=6
indicator("KPX Mapping GBPUSD 202611242207", overlay=true, max_lines_count=100, max_boxes_count=20, max_labels_count=60)
// Dibuat otomatis oleh Kantor Pine (GBPUSD) dari mapping 2026-11-24T15:07:37.653Z (harga 1.30366).
// Bukan nasihat keuangan. Konfirmasi di chart dan selalu gunakan stop loss.
offset = input.float(0.0, "Selisih harga broker - mapping (USD)", group="Umum", tooltip="Isi bila harga broker berbeda dari harga mapping")
showLevels = input.bool(true, "Tampilkan level kunci", group="Tampilan")
showPlans = input.bool(true, "Tampilkan rencana entry", group="Tampilan")

drawLine(float p, color c, string t, bool solid) =>
    line.new(bar_index - 1, p + offset, bar_index, p + offset, extend=extend.both, color=c, style=solid ? line.style_solid : line.style_dashed, width=1)
    label.new(bar_index + 3, p + offset, t + " " + str.tostring(p + offset, "#.00"), style=label.style_none, textcolor=c, size=size.small)

var bool drawn = false
if barstate.islast and not drawn
    drawn := true
    if showLevels
        drawLine(1.31442, color.red, "R High kemarin (PDH)", false)
        drawLine(1.31280, color.red, "R Swing high H1", false)
        drawLine(1.31138, color.red, "R R1 harian", false)
        drawLine(1.31053, color.red, "R Swing low H1", false)
        drawLine(1.31000, color.red, "R Angka bulat", false)
        drawLine(1.30626, color.gray, "P Pivot harian", false)
        drawLine(1.30487, color.red, "R Swing high H1", false)
        drawLine(1.30298, color.green, "S Swing low H1", false)
        drawLine(1.30251, color.green, "S Swing low H1", false)
        drawLine(1.30115, color.green, "S Low kemarin (PDL)", false)
        drawLine(1.30000, color.green, "S Angka bulat", false)
        drawLine(1.29811, color.green, "S S1 harian", false)
    if showPlans
        box.new(bar_index - 20, 1.30324 + offset, bar_index + 40, 1.30272 + offset, border_color=color.green, bgcolor=color.new(color.green, 85), text="BUY Utama 43%", text_color=color.green, text_size=size.small)
        drawLine(1.30155, color.red, "SL BUY", true)
        drawLine(1.30487, color.blue, "TP1 BUY", true)
        drawLine(1.30626, color.blue, "TP2 BUY", true)
        box.new(bar_index - 20, 1.30513 + offset, bar_index + 40, 1.30461 + offset, border_color=color.red, bgcolor=color.new(color.red, 85), text="SELL Alternatif 35%", text_color=color.red, text_size=size.small)
        drawLine(1.30630, color.red, "SL SELL", true)
        drawLine(1.30298, color.blue, "TP1 SELL", true)
        drawLine(1.30115, color.blue, "TP2 SELL", true)

inZone0 = close >= 1.30272 + offset and close <= 1.30324 + offset
alertcondition(inZone0 and not inZone0[1], "KPX BUY Utama: masuk zona", "GBPUSD masuk zona BUY {{close}} - EA entry")
inZone1 = close >= 1.30461 + offset and close <= 1.30513 + offset
alertcondition(inZone1 and not inZone1[1], "KPX SELL Alternatif: masuk zona", "GBPUSD masuk zona SELL {{close}} - EA entry")
plot(na, "KPX")
