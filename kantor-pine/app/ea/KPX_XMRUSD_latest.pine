//@version=6
indicator("KPX Mapping XMRUSD 202611222001", overlay=true, max_lines_count=100, max_boxes_count=20, max_labels_count=60)
// Dibuat otomatis oleh Kantor Pine (XMRUSD) dari mapping 2026-11-22T13:01:03.157Z (harga 485.46).
// Bukan nasihat keuangan. Konfirmasi di chart dan selalu gunakan stop loss.
offset = input.float(0.0, "Selisih harga broker - mapping (USD)", group="Umum", tooltip="Isi bila harga broker berbeda dari harga mapping")
showLevels = input.bool(true, "Tampilkan level kunci", group="Tampilan")
showPlans = input.bool(true, "Tampilkan rencana entry", group="Tampilan")

drawLine(float p, color c, string t, bool solid) =>
    line.new(bar_index - 1, p + offset, bar_index, p + offset, extend=extend.both, color=c, style=solid ? line.style_solid : line.style_dashed, width=1)
    label.new(bar_index + 3, p + offset, t + " " + str.tostring(p + offset, "#.00"), style=label.style_none, textcolor=c, size=size.small)

var bool drawn = false
if barstate.islast and not drawn
    drawn := true
    if showLevels
        drawLine(515.23, color.red, "R R1 harian", false)
        drawLine(494.51, color.red, "R Swing high H1", false)
        drawLine(493.05, color.red, "R High kemarin (PDH)", false)
        drawLine(489.92, color.red, "R Swing high H1", false)
        drawLine(487.50, color.red, "R Angka bulat", false)
        drawLine(485.68, color.red, "R Swing high H1", false)
        drawLine(482.50, color.green, "S Angka bulat", false)
        drawLine(480.21, color.green, "S Swing low H1", false)
        drawLine(477.03, color.green, "S Swing low H1", false)
        drawLine(469.96, color.gray, "P Pivot harian", false)
        drawLine(460.62, color.green, "S Swing high H1", false)
        drawLine(446.88, color.green, "S S1 harian", false)
        drawLine(441.87, color.green, "S Swing low H1", false)
        drawLine(424.70, color.green, "S Low kemarin (PDL)", false)
    if showPlans
        box.new(bar_index - 20, 488.43 + offset, bar_index + 40, 486.57 + offset, border_color=color.red, bgcolor=color.new(color.red, 85), text="SELL Utama 69%", text_color=color.red, text_size=size.small)
        drawLine(492.63, color.red, "SL SELL", true)
        drawLine(480.21, color.blue, "TP1 SELL", true)
        drawLine(477.03, color.blue, "TP2 SELL", true)
        box.new(bar_index - 20, 483.43 + offset, bar_index + 40, 481.57 + offset, border_color=color.green, bgcolor=color.new(color.green, 85), text="BUY Alternatif 31%", text_color=color.green, text_size=size.small)
        drawLine(477.37, color.red, "SL BUY", true)
        drawLine(489.92, color.blue, "TP1 BUY", true)
        drawLine(493.05, color.blue, "TP2 BUY", true)

inZone0 = close >= 486.57 + offset and close <= 488.43 + offset
alertcondition(inZone0 and not inZone0[1], "KPX SELL Utama: masuk zona", "XMRUSD masuk zona SELL {{close}} - tunggu konfirmasi")
inZone1 = close >= 481.57 + offset and close <= 483.43 + offset
alertcondition(inZone1 and not inZone1[1], "KPX BUY Alternatif: masuk zona", "XMRUSD masuk zona BUY {{close}} - tunggu konfirmasi")
plot(na, "KPX")
