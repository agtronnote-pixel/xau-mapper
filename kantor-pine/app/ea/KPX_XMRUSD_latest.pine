//@version=6
indicator("KPX Mapping XMRUSD 202611241809", overlay=true, max_lines_count=100, max_boxes_count=20, max_labels_count=60)
// Dibuat otomatis oleh Kantor Pine (XMRUSD) dari mapping 2026-11-24T11:09:15.685Z (harga 498.24).
// Bukan nasihat keuangan. Konfirmasi di chart dan selalu gunakan stop loss.
offset = input.float(0.0, "Selisih harga broker - mapping (USD)", group="Umum", tooltip="Isi bila harga broker berbeda dari harga mapping")
showLevels = input.bool(true, "Tampilkan level kunci", group="Tampilan")
showPlans = input.bool(true, "Tampilkan rencana entry", group="Tampilan")

drawLine(float p, color c, string t, bool solid) =>
    line.new(bar_index - 1, p + offset, bar_index, p + offset, extend=extend.both, color=c, style=solid ? line.style_solid : line.style_dashed, width=1)
    label.new(bar_index + 3, p + offset, t + " " + str.tostring(p + offset, "#.00"), style=label.style_none, textcolor=c, size=size.small)

var bool drawn = false
if barstate.islast and not drawn
    drawn := true
    if showLevels
        drawLine(516.85, color.red, "R High kemarin (PDH)", false)
        drawLine(507.73, color.red, "R R1 harian", false)
        drawLine(501.92, color.red, "R Swing high H1", false)
        drawLine(500.00, color.red, "R Angka bulat", false)
        drawLine(497.50, color.green, "S Angka bulat", false)
        drawLine(495.70, color.gray, "P Pivot harian", false)
        drawLine(483.68, color.green, "S Low kemarin (PDL)", false)
        drawLine(479.21, color.green, "S Swing low H1", false)
        drawLine(474.56, color.green, "S S1 harian", false)
    if showPlans
        box.new(bar_index - 20, 501.36 + offset, bar_index + 40, 498.65 + offset, border_color=color.red, bgcolor=color.new(color.red, 85), text="SELL Range 52%", text_color=color.red, text_size=size.small)
        drawLine(507.46, color.red, "SL SELL", true)
        drawLine(488.82, color.blue, "TP1 SELL", true)
        drawLine(483.68, color.blue, "TP2 SELL", true)
        box.new(bar_index - 20, 497.06 + offset, bar_index + 40, 494.35 + offset, border_color=color.green, bgcolor=color.new(color.green, 85), text="BUY Range 47%", text_color=color.green, text_size=size.small)
        drawLine(488.25, color.red, "SL BUY", true)
        drawLine(507.73, color.blue, "TP1 BUY", true)
        drawLine(516.85, color.blue, "TP2 BUY", true)

inZone0 = close >= 498.65 + offset and close <= 501.36 + offset
alertcondition(inZone0 and not inZone0[1], "KPX SELL Range: masuk zona", "XMRUSD masuk zona SELL {{close}} - EA entry")
inZone1 = close >= 494.35 + offset and close <= 497.06 + offset
alertcondition(inZone1 and not inZone1[1], "KPX BUY Range: masuk zona", "XMRUSD masuk zona BUY {{close}} - EA entry")
plot(na, "KPX")
