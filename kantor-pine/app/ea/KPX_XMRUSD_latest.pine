//@version=6
indicator("KPX Mapping XMRUSD 202611242307", overlay=true, max_lines_count=100, max_boxes_count=20, max_labels_count=60)
// Dibuat otomatis oleh Kantor Pine (XMRUSD) dari mapping 2026-11-24T16:07:28.744Z (harga 492.30).
// Bukan nasihat keuangan. Konfirmasi di chart dan selalu gunakan stop loss.
offset = input.float(0.0, "Selisih harga broker - mapping (USD)", group="Umum", tooltip="Isi bila harga broker berbeda dari harga mapping")
showLevels = input.bool(true, "Tampilkan level kunci", group="Tampilan")
showPlans = input.bool(true, "Tampilkan rencana entry", group="Tampilan")

drawLine(float p, color c, string t, bool solid) =>
    line.new(bar_index - 1, p + offset, bar_index, p + offset, extend=extend.both, color=c, style=solid ? line.style_solid : line.style_dashed, width=1)
    label.new(bar_index + 3, p + offset, t + " " + str.tostring(p + offset, "#.00"), style=label.style_none, textcolor=c, size=size.small)

var bool drawn = false
if barstate.islast and not drawn
    drawn := true
    if showLevels
        drawLine(516.85, color.red, "R High kemarin (PDH)", false)
        drawLine(508.42, color.red, "R R1 harian", false)
        drawLine(501.92, color.red, "R Swing high H1", false)
        drawLine(500.43, color.red, "R Swing high H1", false)
        drawLine(496.05, color.gray, "P Pivot harian", false)
        drawLine(492.50, color.red, "R Angka bulat", false)
        drawLine(490.00, color.green, "S Angka bulat", false)
        drawLine(483.68, color.green, "S Low kemarin (PDL)", false)
        drawLine(479.21, color.green, "S Swing low H1", false)
        drawLine(475.25, color.green, "S S1 harian", false)
    if showPlans
        box.new(bar_index - 20, 497.14 + offset, bar_index + 40, 494.96 + offset, border_color=color.red, bgcolor=color.new(color.red, 85), text="SELL Utama 60%", text_color=color.red, text_size=size.small)
        drawLine(502.03, color.red, "SL SELL", true)
        drawLine(490.00, color.blue, "TP1 SELL", true)
        drawLine(483.68, color.blue, "TP2 SELL", true)
        box.new(bar_index - 20, 491.09 + offset, bar_index + 40, 488.91 + offset, border_color=color.green, bgcolor=color.new(color.green, 85), text="BUY Alternatif 28%", text_color=color.green, text_size=size.small)
        drawLine(484.02, color.red, "SL BUY", true)
        drawLine(496.05, color.blue, "TP1 BUY", true)
        drawLine(500.43, color.blue, "TP2 BUY", true)

inZone0 = close >= 494.96 + offset and close <= 497.14 + offset
alertcondition(inZone0 and not inZone0[1], "KPX SELL Utama: masuk zona", "XMRUSD masuk zona SELL {{close}} - EA entry")
inZone1 = close >= 488.91 + offset and close <= 491.09 + offset
alertcondition(inZone1 and not inZone1[1], "KPX BUY Alternatif: masuk zona", "XMRUSD masuk zona BUY {{close}} - EA entry")
plot(na, "KPX")
