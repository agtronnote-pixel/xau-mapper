//@version=6
indicator("KPX Mapping XMRUSD 202611232307", overlay=true, max_lines_count=100, max_boxes_count=20, max_labels_count=60)
// Dibuat otomatis oleh Kantor Pine (XMRUSD) dari mapping 2026-11-23T16:07:29.662Z (harga 509.73).
// Bukan nasihat keuangan. Konfirmasi di chart dan selalu gunakan stop loss.
offset = input.float(0.0, "Selisih harga broker - mapping (USD)", group="Umum", tooltip="Isi bila harga broker berbeda dari harga mapping")
showLevels = input.bool(true, "Tampilkan level kunci", group="Tampilan")
showPlans = input.bool(true, "Tampilkan rencana entry", group="Tampilan")

drawLine(float p, color c, string t, bool solid) =>
    line.new(bar_index - 1, p + offset, bar_index, p + offset, extend=extend.both, color=c, style=solid ? line.style_solid : line.style_dashed, width=1)
    label.new(bar_index + 3, p + offset, t + " " + str.tostring(p + offset, "#.00"), style=label.style_none, textcolor=c, size=size.small)

var bool drawn = false
if barstate.islast and not drawn
    drawn := true
    if showLevels
        drawLine(516.80, color.red, "R Swing high H1", false)
        drawLine(515.00, color.red, "R Angka bulat", false)
        drawLine(508.40, color.green, "S Swing high H1", false)
        drawLine(504.57, color.green, "S R1 harian", false)
        drawLine(499.45, color.green, "S High kemarin (PDH)", false)
        drawLine(496.56, color.green, "S Swing low H1", false)
        drawLine(490.80, color.gray, "P Pivot harian", false)
        drawLine(482.15, color.green, "S S1 harian", false)
        drawLine(477.03, color.green, "S Low kemarin (PDL)", false)
    if showPlans
        box.new(bar_index - 20, 509.69 + offset, bar_index + 40, 507.11 + offset, border_color=color.green, bgcolor=color.new(color.green, 85), text="BUY Utama 67%", text_color=color.green, text_size=size.small)
        drawLine(501.29, color.red, "SL BUY", true)
        drawLine(516.80, color.blue, "TP1 BUY", true)
        drawLine(529.73, color.blue, "TP2 BUY", true)
        box.new(bar_index - 20, 516.29 + offset, bar_index + 40, 513.71 + offset, border_color=color.red, bgcolor=color.new(color.red, 85), text="SELL Alternatif 33%", text_color=color.red, text_size=size.small)
        drawLine(522.11, color.red, "SL SELL", true)
        drawLine(504.57, color.blue, "TP1 SELL", true)
        drawLine(499.45, color.blue, "TP2 SELL", true)

inZone0 = close >= 507.11 + offset and close <= 509.69 + offset
alertcondition(inZone0 and not inZone0[1], "KPX BUY Utama: masuk zona", "XMRUSD masuk zona BUY {{close}} - EA entry")
inZone1 = close >= 513.71 + offset and close <= 516.29 + offset
alertcondition(inZone1 and not inZone1[1], "KPX SELL Alternatif: masuk zona", "XMRUSD masuk zona SELL {{close}} - EA entry")
plot(na, "KPX")
