//@version=6
indicator("KPX Mapping XMRUSD 202611271907", overlay=true, max_lines_count=100, max_boxes_count=20, max_labels_count=60)
// Dibuat otomatis oleh Kantor Pine (XMRUSD) dari mapping 2026-11-27T12:07:27.021Z (harga 440.00).
// Bukan nasihat keuangan. Konfirmasi di chart dan selalu gunakan stop loss.
offset = input.float(0.0, "Selisih harga broker - mapping (USD)", group="Umum", tooltip="Isi bila harga broker berbeda dari harga mapping")
showLevels = input.bool(true, "Tampilkan level kunci", group="Tampilan")
showPlans = input.bool(true, "Tampilkan rencana entry", group="Tampilan")

drawLine(float p, color c, string t, bool solid) =>
    line.new(bar_index - 1, p + offset, bar_index, p + offset, extend=extend.both, color=c, style=solid ? line.style_solid : line.style_dashed, width=1)
    label.new(bar_index + 3, p + offset, t + " " + str.tostring(p + offset, "#.00"), style=label.style_none, textcolor=c, size=size.small)

var bool drawn = false
if barstate.islast and not drawn
    drawn := true
    if showLevels
        drawLine(475.81, color.red, "R Swing high H1", false)
        drawLine(473.05, color.gray, "P Pivot harian", false)
        drawLine(466.76, color.red, "R Swing high H1", false)
        drawLine(458.63, color.red, "R Swing low H1", false)
        drawLine(442.50, color.red, "R Angka bulat", false)
        drawLine(440.00, color.green, "S Angka bulat", false)
        drawLine(437.22, color.green, "S Swing low H1", false)
        drawLine(430.00, color.green, "S Low kemarin (PDL)", false)
        drawLine(417.13, color.green, "S S1 harian", false)
    if showPlans
        box.new(bar_index - 20, 444.34 + offset, bar_index + 40, 440.66 + offset, border_color=color.red, bgcolor=color.new(color.red, 85), text="SELL Utama 62%", text_color=color.red, text_size=size.small)
        drawLine(452.63, color.red, "SL SELL", true)
        drawLine(430.00, color.blue, "TP1 SELL", true)
        drawLine(417.13, color.blue, "TP2 SELL", true)
        box.new(bar_index - 20, 439.06 + offset, bar_index + 40, 435.38 + offset, border_color=color.green, bgcolor=color.new(color.green, 85), text="BUY Alternatif 39%", text_color=color.green, text_size=size.small)
        drawLine(427.09, color.red, "SL BUY", true)
        drawLine(452.42, color.blue, "TP1 BUY", true)
        drawLine(458.63, color.blue, "TP2 BUY", true)

inZone0 = close >= 440.66 + offset and close <= 444.34 + offset
alertcondition(inZone0 and not inZone0[1], "KPX SELL Utama: masuk zona", "XMRUSD masuk zona SELL {{close}} - EA entry")
inZone1 = close >= 435.38 + offset and close <= 439.06 + offset
alertcondition(inZone1 and not inZone1[1], "KPX BUY Alternatif: masuk zona", "XMRUSD masuk zona BUY {{close}} - EA entry")
plot(na, "KPX")
