//@version=6
indicator("KPX Mapping XMRUSD 202611271207", overlay=true, max_lines_count=100, max_boxes_count=20, max_labels_count=60)
// Dibuat otomatis oleh Kantor Pine (XMRUSD) dari mapping 2026-11-27T05:07:27.770Z (harga 468.41).
// Bukan nasihat keuangan. Konfirmasi di chart dan selalu gunakan stop loss.
offset = input.float(0.0, "Selisih harga broker - mapping (USD)", group="Umum", tooltip="Isi bila harga broker berbeda dari harga mapping")
showLevels = input.bool(true, "Tampilkan level kunci", group="Tampilan")
showPlans = input.bool(true, "Tampilkan rencana entry", group="Tampilan")

drawLine(float p, color c, string t, bool solid) =>
    line.new(bar_index - 1, p + offset, bar_index, p + offset, extend=extend.both, color=c, style=solid ? line.style_solid : line.style_dashed, width=1)
    label.new(bar_index + 3, p + offset, t + " " + str.tostring(p + offset, "#.00"), style=label.style_none, textcolor=c, size=size.small)

var bool drawn = false
if barstate.islast and not drawn
    drawn := true
    if showLevels
        drawLine(528.97, color.red, "R High kemarin (PDH)", false)
        drawLine(519.39, color.red, "R Swing low H1", false)
        drawLine(516.10, color.red, "R R1 harian", false)
        drawLine(511.63, color.red, "R Swing low H1", false)
        drawLine(473.05, color.gray, "P Pivot harian", false)
        drawLine(466.76, color.green, "S Swing high H1", false)
        drawLine(437.22, color.green, "S Swing low H1", false)
        drawLine(430.00, color.green, "S Low kemarin (PDL)", false)
        drawLine(417.13, color.green, "S S1 harian", false)
    if showPlans
        box.new(bar_index - 20, 475.54 + offset, bar_index + 40, 470.56 + offset, border_color=color.red, bgcolor=color.new(color.red, 85), text="SELL Utama 53%", text_color=color.red, text_size=size.small)
        drawLine(486.75, color.red, "SL SELL", true)
        drawLine(452.50, color.blue, "TP1 SELL", true)
        drawLine(437.22, color.blue, "TP2 SELL", true)
        box.new(bar_index - 20, 439.71 + offset, bar_index + 40, 434.73 + offset, border_color=color.green, bgcolor=color.new(color.green, 85), text="BUY Alternatif 49%", text_color=color.green, text_size=size.small)
        drawLine(423.52, color.red, "SL BUY", true)
        drawLine(457.77, color.blue, "TP1 BUY", true)
        drawLine(473.05, color.blue, "TP2 BUY", true)

inZone0 = close >= 470.56 + offset and close <= 475.54 + offset
alertcondition(inZone0 and not inZone0[1], "KPX SELL Utama: masuk zona", "XMRUSD masuk zona SELL {{close}} - EA entry")
inZone1 = close >= 434.73 + offset and close <= 439.71 + offset
alertcondition(inZone1 and not inZone1[1], "KPX BUY Alternatif: masuk zona", "XMRUSD masuk zona BUY {{close}} - EA entry")
plot(na, "KPX")
