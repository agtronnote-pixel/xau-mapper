//@version=6
indicator("KPX Mapping XMRUSD 202611262159", overlay=true, max_lines_count=100, max_boxes_count=20, max_labels_count=60)
// Dibuat otomatis oleh Kantor Pine (XMRUSD) dari mapping 2026-11-26T14:59:15.271Z (harga 447.03).
// Bukan nasihat keuangan. Konfirmasi di chart dan selalu gunakan stop loss.
offset = input.float(0.0, "Selisih harga broker - mapping (USD)", group="Umum", tooltip="Isi bila harga broker berbeda dari harga mapping")
showLevels = input.bool(true, "Tampilkan level kunci", group="Tampilan")
showPlans = input.bool(true, "Tampilkan rencana entry", group="Tampilan")

drawLine(float p, color c, string t, bool solid) =>
    line.new(bar_index - 1, p + offset, bar_index, p + offset, extend=extend.both, color=c, style=solid ? line.style_solid : line.style_dashed, width=1)
    label.new(bar_index + 3, p + offset, t + " " + str.tostring(p + offset, "#.00"), style=label.style_none, textcolor=c, size=size.small)

var bool drawn = false
if barstate.islast and not drawn
    drawn := true
    if showLevels
        drawLine(513.53, color.gray, "P Pivot harian", false)
        drawLine(500.00, color.red, "R S1 harian", false)
        drawLine(494.35, color.red, "R Low kemarin (PDL)", false)
        drawLine(450.00, color.red, "R Angka bulat", false)
        drawLine(447.50, color.red, "R Angka bulat", false)
        drawLine(445.00, color.green, "S Angka bulat", false)
    if showPlans
        box.new(bar_index - 20, 451.64 + offset, bar_index + 40, 448.37 + offset, border_color=color.red, bgcolor=color.new(color.red, 85), text="SELL Utama 74%", text_color=color.red, text_size=size.small)
        drawLine(459.00, color.red, "SL SELL", true)
        drawLine(436.51, color.blue, "TP1 SELL", true)
        drawLine(423.02, color.blue, "TP2 SELL", true)
        box.new(bar_index - 20, 446.64 + offset, bar_index + 40, 443.37 + offset, border_color=color.green, bgcolor=color.new(color.green, 85), text="BUY Alternatif 27%", text_color=color.green, text_size=size.small)
        drawLine(436.01, color.red, "SL BUY", true)
        drawLine(458.50, color.blue, "TP1 BUY", true)
        drawLine(494.35, color.blue, "TP2 BUY", true)

inZone0 = close >= 448.37 + offset and close <= 451.64 + offset
alertcondition(inZone0 and not inZone0[1], "KPX SELL Utama: masuk zona", "XMRUSD masuk zona SELL {{close}} - EA entry")
inZone1 = close >= 443.37 + offset and close <= 446.64 + offset
alertcondition(inZone1 and not inZone1[1], "KPX BUY Alternatif: masuk zona", "XMRUSD masuk zona BUY {{close}} - EA entry")
plot(na, "KPX")
