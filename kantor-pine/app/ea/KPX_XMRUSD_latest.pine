//@version=6
indicator("KPX Mapping XMRUSD 202611230307", overlay=true, max_lines_count=100, max_boxes_count=20, max_labels_count=60)
// Dibuat otomatis oleh Kantor Pine (XMRUSD) dari mapping 2026-11-22T20:07:24.723Z (harga 495.08).
// Bukan nasihat keuangan. Konfirmasi di chart dan selalu gunakan stop loss.
offset = input.float(0.0, "Selisih harga broker - mapping (USD)", group="Umum", tooltip="Isi bila harga broker berbeda dari harga mapping")
showLevels = input.bool(true, "Tampilkan level kunci", group="Tampilan")
showPlans = input.bool(true, "Tampilkan rencana entry", group="Tampilan")

drawLine(float p, color c, string t, bool solid) =>
    line.new(bar_index - 1, p + offset, bar_index, p + offset, extend=extend.both, color=c, style=solid ? line.style_solid : line.style_dashed, width=1)
    label.new(bar_index + 3, p + offset, t + " " + str.tostring(p + offset, "#.00"), style=label.style_none, textcolor=c, size=size.small)

var bool drawn = false
if barstate.islast and not drawn
    drawn := true
    if showLevels
        drawLine(515.54, color.red, "R R1 harian", false)
        drawLine(497.50, color.red, "R Angka bulat", false)
        drawLine(494.51, color.green, "S Swing high H1", false)
        drawLine(493.05, color.green, "S High kemarin (PDH)", false)
        drawLine(489.92, color.green, "S Swing high H1", false)
        drawLine(480.21, color.green, "S Swing low H1", false)
        drawLine(477.03, color.green, "S Swing low H1", false)
        drawLine(470.12, color.gray, "P Pivot harian", false)
        drawLine(460.62, color.green, "S Swing high H1", false)
        drawLine(447.19, color.green, "S S1 harian", false)
    if showPlans
        box.new(bar_index - 20, 494.02 + offset, bar_index + 40, 492.08 + offset, border_color=color.green, bgcolor=color.new(color.green, 85), text="BUY Utama 67%", text_color=color.green, text_size=size.small)
        drawLine(487.71, color.red, "SL BUY", true)
        drawLine(501.06, color.blue, "TP1 BUY", true)
        drawLine(515.54, color.blue, "TP2 BUY", true)
        box.new(bar_index - 20, 498.47 + offset, bar_index + 40, 496.53 + offset, border_color=color.red, bgcolor=color.new(color.red, 85), text="SELL Alternatif 34%", text_color=color.red, text_size=size.small)
        drawLine(502.84, color.red, "SL SELL", true)
        drawLine(489.92, color.blue, "TP1 SELL", true)
        drawLine(480.21, color.blue, "TP2 SELL", true)

inZone0 = close >= 492.08 + offset and close <= 494.02 + offset
alertcondition(inZone0 and not inZone0[1], "KPX BUY Utama: masuk zona", "XMRUSD masuk zona BUY {{close}} - EA entry")
inZone1 = close >= 496.53 + offset and close <= 498.47 + offset
alertcondition(inZone1 and not inZone1[1], "KPX SELL Alternatif: masuk zona", "XMRUSD masuk zona SELL {{close}} - EA entry")
plot(na, "KPX")
