//@version=6
indicator("KPX Mapping XMRUSD 202611251807", overlay=true, max_lines_count=100, max_boxes_count=20, max_labels_count=60)
// Dibuat otomatis oleh Kantor Pine (XMRUSD) dari mapping 2026-11-25T11:07:29.614Z (harga 505.41).
// Bukan nasihat keuangan. Konfirmasi di chart dan selalu gunakan stop loss.
offset = input.float(0.0, "Selisih harga broker - mapping (USD)", group="Umum", tooltip="Isi bila harga broker berbeda dari harga mapping")
showLevels = input.bool(true, "Tampilkan level kunci", group="Tampilan")
showPlans = input.bool(true, "Tampilkan rencana entry", group="Tampilan")

drawLine(float p, color c, string t, bool solid) =>
    line.new(bar_index - 1, p + offset, bar_index, p + offset, extend=extend.both, color=c, style=solid ? line.style_solid : line.style_dashed, width=1)
    label.new(bar_index + 3, p + offset, t + " " + str.tostring(p + offset, "#.00"), style=label.style_none, textcolor=c, size=size.small)

var bool drawn = false
if barstate.islast and not drawn
    drawn := true
    if showLevels
        drawLine(522.42, color.red, "R R1 harian", false)
        drawLine(514.75, color.red, "R High kemarin (PDH)", false)
        drawLine(510.00, color.red, "R Angka bulat", false)
        drawLine(507.36, color.red, "R Swing high H1", false)
        drawLine(505.00, color.green, "S Angka bulat", false)
        drawLine(503.65, color.green, "S Swing low H1", false)
        drawLine(500.82, color.gray, "P Pivot harian", false)
        drawLine(498.92, color.green, "S Swing low H1", false)
        drawLine(490.91, color.green, "S Swing low H1", false)
        drawLine(486.88, color.green, "S S1 harian", false)
        drawLine(479.21, color.green, "S Low kemarin (PDL)", false)
    if showPlans
        box.new(bar_index - 20, 508.44 + offset, bar_index + 40, 506.28 + offset, border_color=color.red, bgcolor=color.new(color.red, 85), text="SELL Utama 51%", text_color=color.red, text_size=size.small)
        drawLine(513.29, color.red, "SL SELL", true)
        drawLine(500.82, color.blue, "TP1 SELL", true)
        drawLine(490.91, color.blue, "TP2 SELL", true)
        box.new(bar_index - 20, 504.73 + offset, bar_index + 40, 502.57 + offset, border_color=color.green, bgcolor=color.new(color.green, 85), text="BUY Alternatif 38%", text_color=color.green, text_size=size.small)
        drawLine(497.72, color.red, "SL BUY", true)
        drawLine(510.00, color.blue, "TP1 BUY", true)
        drawLine(514.75, color.blue, "TP2 BUY", true)

inZone0 = close >= 506.28 + offset and close <= 508.44 + offset
alertcondition(inZone0 and not inZone0[1], "KPX SELL Utama: masuk zona", "XMRUSD masuk zona SELL {{close}} - EA entry")
inZone1 = close >= 502.57 + offset and close <= 504.73 + offset
alertcondition(inZone1 and not inZone1[1], "KPX BUY Alternatif: masuk zona", "XMRUSD masuk zona BUY {{close}} - EA entry")
plot(na, "KPX")
