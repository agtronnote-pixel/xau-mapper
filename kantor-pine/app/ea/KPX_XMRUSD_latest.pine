//@version=6
indicator("KPX Mapping XMRUSD 202611230907", overlay=true, max_lines_count=100, max_boxes_count=20, max_labels_count=60)
// Dibuat otomatis oleh Kantor Pine (XMRUSD) dari mapping 2026-11-23T02:07:28.021Z (harga 494.55).
// Bukan nasihat keuangan. Konfirmasi di chart dan selalu gunakan stop loss.
offset = input.float(0.0, "Selisih harga broker - mapping (USD)", group="Umum", tooltip="Isi bila harga broker berbeda dari harga mapping")
showLevels = input.bool(true, "Tampilkan level kunci", group="Tampilan")
showPlans = input.bool(true, "Tampilkan rencana entry", group="Tampilan")

drawLine(float p, color c, string t, bool solid) =>
    line.new(bar_index - 1, p + offset, bar_index, p + offset, extend=extend.both, color=c, style=solid ? line.style_solid : line.style_dashed, width=1)
    label.new(bar_index + 3, p + offset, t + " " + str.tostring(p + offset, "#.00"), style=label.style_none, textcolor=c, size=size.small)

var bool drawn = false
if barstate.islast and not drawn
    drawn := true
    if showLevels
        drawLine(504.31, color.red, "R R1 harian", false)
        drawLine(499.45, color.red, "R High kemarin (PDH)", false)
        drawLine(497.50, color.red, "R Angka bulat", false)
        drawLine(494.51, color.green, "S Swing high H1", false)
        drawLine(492.35, color.green, "S Swing low H1", false)
        drawLine(490.67, color.gray, "P Pivot harian", false)
        drawLine(481.89, color.green, "S S1 harian", false)
        drawLine(480.21, color.green, "S Swing low H1", false)
        drawLine(477.03, color.green, "S Low kemarin (PDL)", false)
    if showPlans
        box.new(bar_index - 20, 493.24 + offset, bar_index + 40, 491.46 + offset, border_color=color.green, bgcolor=color.new(color.green, 85), text="BUY Range 55%", text_color=color.green, text_size=size.small)
        drawLine(487.46, color.red, "SL BUY", true)
        drawLine(497.50, color.blue, "TP1 BUY", true)
        drawLine(504.31, color.blue, "TP2 BUY", true)
        box.new(bar_index - 20, 498.39 + offset, bar_index + 40, 496.61 + offset, border_color=color.red, bgcolor=color.new(color.red, 85), text="SELL Range 43%", text_color=color.red, text_size=size.small)
        drawLine(502.39, color.red, "SL SELL", true)
        drawLine(492.35, color.blue, "TP1 SELL", true)
        drawLine(481.89, color.blue, "TP2 SELL", true)

inZone0 = close >= 491.46 + offset and close <= 493.24 + offset
alertcondition(inZone0 and not inZone0[1], "KPX BUY Range: masuk zona", "XMRUSD masuk zona BUY {{close}} - EA entry")
inZone1 = close >= 496.61 + offset and close <= 498.39 + offset
alertcondition(inZone1 and not inZone1[1], "KPX SELL Range: masuk zona", "XMRUSD masuk zona SELL {{close}} - EA entry")
plot(na, "KPX")
