//@version=6
indicator("KPX Mapping XMRUSD 202611240507", overlay=true, max_lines_count=100, max_boxes_count=20, max_labels_count=60)
// Dibuat otomatis oleh Kantor Pine (XMRUSD) dari mapping 2026-11-23T22:07:25.181Z (harga 491.33).
// Bukan nasihat keuangan. Konfirmasi di chart dan selalu gunakan stop loss.
offset = input.float(0.0, "Selisih harga broker - mapping (USD)", group="Umum", tooltip="Isi bila harga broker berbeda dari harga mapping")
showLevels = input.bool(true, "Tampilkan level kunci", group="Tampilan")
showPlans = input.bool(true, "Tampilkan rencana entry", group="Tampilan")

drawLine(float p, color c, string t, bool solid) =>
    line.new(bar_index - 1, p + offset, bar_index, p + offset, extend=extend.both, color=c, style=solid ? line.style_solid : line.style_dashed, width=1)
    label.new(bar_index + 3, p + offset, t + " " + str.tostring(p + offset, "#.00"), style=label.style_none, textcolor=c, size=size.small)

var bool drawn = false
if barstate.islast and not drawn
    drawn := true
    if showLevels
        drawLine(516.80, color.red, "R Swing high H1", false)
        drawLine(508.40, color.red, "R Swing high H1", false)
        drawLine(504.57, color.red, "R R1 harian", false)
        drawLine(499.45, color.red, "R High kemarin (PDH)", false)
        drawLine(496.56, color.red, "R Swing low H1", false)
        drawLine(490.80, color.gray, "P Pivot harian", false)
        drawLine(482.15, color.green, "S S1 harian", false)
        drawLine(477.03, color.green, "S Low kemarin (PDL)", false)
    if showPlans
        box.new(bar_index - 20, 498.17 + offset, bar_index + 40, 494.95 + offset, border_color=color.red, bgcolor=color.new(color.red, 85), text="SELL Utama 57%", text_color=color.red, text_size=size.small)
        drawLine(505.40, color.red, "SL SELL", true)
        drawLine(482.15, color.blue, "TP1 SELL", true)
        drawLine(477.03, color.blue, "TP2 SELL", true)
        box.new(bar_index - 20, 483.76 + offset, bar_index + 40, 480.54 + offset, border_color=color.green, bgcolor=color.new(color.green, 85), text="BUY Alternatif 46%", text_color=color.green, text_size=size.small)
        drawLine(473.31, color.red, "SL BUY", true)
        drawLine(496.56, color.blue, "TP1 BUY", true)
        drawLine(504.57, color.blue, "TP2 BUY", true)

inZone0 = close >= 494.95 + offset and close <= 498.17 + offset
alertcondition(inZone0 and not inZone0[1], "KPX SELL Utama: masuk zona", "XMRUSD masuk zona SELL {{close}} - EA entry")
inZone1 = close >= 480.54 + offset and close <= 483.76 + offset
alertcondition(inZone1 and not inZone1[1], "KPX BUY Alternatif: masuk zona", "XMRUSD masuk zona BUY {{close}} - EA entry")
plot(na, "KPX")
