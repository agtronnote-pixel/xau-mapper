//@version=6
indicator("KPX Mapping XMRUSD 202611261307", overlay=true, max_lines_count=100, max_boxes_count=20, max_labels_count=60)
// Dibuat otomatis oleh Kantor Pine (XMRUSD) dari mapping 2026-11-26T06:07:28.420Z (harga 523.36).
// Bukan nasihat keuangan. Konfirmasi di chart dan selalu gunakan stop loss.
offset = input.float(0.0, "Selisih harga broker - mapping (USD)", group="Umum", tooltip="Isi bila harga broker berbeda dari harga mapping")
showLevels = input.bool(true, "Tampilkan level kunci", group="Tampilan")
showPlans = input.bool(true, "Tampilkan rencana entry", group="Tampilan")

drawLine(float p, color c, string t, bool solid) =>
    line.new(bar_index - 1, p + offset, bar_index, p + offset, extend=extend.both, color=c, style=solid ? line.style_solid : line.style_dashed, width=1)
    label.new(bar_index + 3, p + offset, t + " " + str.tostring(p + offset, "#.00"), style=label.style_none, textcolor=c, size=size.small)

var bool drawn = false
if barstate.islast and not drawn
    drawn := true
    if showLevels
        drawLine(532.92, color.red, "R R1 harian", false)
        drawLine(530.00, color.red, "R Angka bulat", false)
        drawLine(527.05, color.red, "R High kemarin (PDH)", false)
        drawLine(525.00, color.red, "R Angka bulat", false)
        drawLine(520.00, color.green, "S Angka bulat", false)
        drawLine(513.63, color.gray, "P Pivot harian", false)
        drawLine(511.63, color.green, "S Swing low H1", false)
        drawLine(503.65, color.green, "S Swing low H1", false)
        drawLine(500.22, color.green, "S S1 harian", false)
        drawLine(494.35, color.green, "S Low kemarin (PDL)", false)
    if showPlans
        box.new(bar_index - 20, 521.35 + offset, bar_index + 40, 518.65 + offset, border_color=color.green, bgcolor=color.new(color.green, 85), text="BUY Utama 69%", text_color=color.green, text_size=size.small)
        drawLine(512.58, color.red, "SL BUY", true)
        drawLine(530.00, color.blue, "TP1 BUY", true)
        drawLine(542.26, color.blue, "TP2 BUY", true)
        box.new(bar_index - 20, 526.35 + offset, bar_index + 40, 523.65 + offset, border_color=color.red, bgcolor=color.new(color.red, 85), text="SELL Alternatif 32%", text_color=color.red, text_size=size.small)
        drawLine(532.42, color.red, "SL SELL", true)
        drawLine(513.63, color.blue, "TP1 SELL", true)
        drawLine(503.65, color.blue, "TP2 SELL", true)

inZone0 = close >= 518.65 + offset and close <= 521.35 + offset
alertcondition(inZone0 and not inZone0[1], "KPX BUY Utama: masuk zona", "XMRUSD masuk zona BUY {{close}} - EA entry")
inZone1 = close >= 523.65 + offset and close <= 526.35 + offset
alertcondition(inZone1 and not inZone1[1], "KPX SELL Alternatif: masuk zona", "XMRUSD masuk zona SELL {{close}} - EA entry")
plot(na, "KPX")
