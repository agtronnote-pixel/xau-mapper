//@version=6
indicator("KPX Mapping XMRUSD 202611260525", overlay=true, max_lines_count=100, max_boxes_count=20, max_labels_count=60)
// Dibuat otomatis oleh Kantor Pine (XMRUSD) dari mapping 2026-11-25T22:25:04.704Z (harga 521.32).
// Bukan nasihat keuangan. Konfirmasi di chart dan selalu gunakan stop loss.
offset = input.float(0.0, "Selisih harga broker - mapping (USD)", group="Umum", tooltip="Isi bila harga broker berbeda dari harga mapping")
showLevels = input.bool(true, "Tampilkan level kunci", group="Tampilan")
showPlans = input.bool(true, "Tampilkan rencana entry", group="Tampilan")

drawLine(float p, color c, string t, bool solid) =>
    line.new(bar_index - 1, p + offset, bar_index, p + offset, extend=extend.both, color=c, style=solid ? line.style_solid : line.style_dashed, width=1)
    label.new(bar_index + 3, p + offset, t + " " + str.tostring(p + offset, "#.00"), style=label.style_none, textcolor=c, size=size.small)

var bool drawn = false
if barstate.islast and not drawn
    drawn := true
    if showLevels
        drawLine(525.00, color.red, "R Angka bulat", false)
        drawLine(523.18, color.red, "R R1 harian", false)
        drawLine(520.00, color.green, "S Angka bulat", false)
        drawLine(514.75, color.green, "S High kemarin (PDH)", false)
        drawLine(507.36, color.green, "S Swing high H1", false)
        drawLine(503.65, color.green, "S Swing low H1", false)
        drawLine(501.19, color.gray, "P Pivot harian", false)
        drawLine(498.92, color.green, "S Swing low H1", false)
        drawLine(494.35, color.green, "S Swing low H1", false)
        drawLine(487.64, color.green, "S S1 harian", false)
        drawLine(479.21, color.green, "S Low kemarin (PDL)", false)
    if showPlans
        box.new(bar_index - 20, 516.14 + offset, bar_index + 40, 513.36 + offset, border_color=color.green, bgcolor=color.new(color.green, 85), text="BUY Range 58%", text_color=color.green, text_size=size.small)
        drawLine(507.09, color.red, "SL BUY", true)
        drawLine(523.18, color.blue, "TP1 BUY", true)
        drawLine(537.73, color.blue, "TP2 BUY", true)
        box.new(bar_index - 20, 524.57 + offset, bar_index + 40, 521.79 + offset, border_color=color.red, bgcolor=color.new(color.red, 85), text="SELL Range 41%", text_color=color.red, text_size=size.small)
        drawLine(530.84, color.red, "SL SELL", true)
        drawLine(514.75, color.blue, "TP1 SELL", true)
        drawLine(507.36, color.blue, "TP2 SELL", true)

inZone0 = close >= 513.36 + offset and close <= 516.14 + offset
alertcondition(inZone0 and not inZone0[1], "KPX BUY Range: masuk zona", "XMRUSD masuk zona BUY {{close}} - EA entry")
inZone1 = close >= 521.79 + offset and close <= 524.57 + offset
alertcondition(inZone1 and not inZone1[1], "KPX SELL Range: masuk zona", "XMRUSD masuk zona SELL {{close}} - EA entry")
plot(na, "KPX")
