//@version=6
indicator("KPX Mapping XMRUSD 202611280853", overlay=true, max_lines_count=100, max_boxes_count=20, max_labels_count=60)
// Dibuat otomatis oleh Kantor Pine (XMRUSD) dari mapping 2026-11-28T01:53:04.802Z (harga 409.39).
// Bukan nasihat keuangan. Konfirmasi di chart dan selalu gunakan stop loss.
offset = input.float(0.0, "Selisih harga broker - mapping (USD)", group="Umum", tooltip="Isi bila harga broker berbeda dari harga mapping")
showLevels = input.bool(true, "Tampilkan level kunci", group="Tampilan")
showPlans = input.bool(true, "Tampilkan rencana entry", group="Tampilan")

drawLine(float p, color c, string t, bool solid) =>
    line.new(bar_index - 1, p + offset, bar_index, p + offset, extend=extend.both, color=c, style=solid ? line.style_solid : line.style_dashed, width=1)
    label.new(bar_index + 3, p + offset, t + " " + str.tostring(p + offset, "#.00"), style=label.style_none, textcolor=c, size=size.small)

var bool drawn = false
if barstate.islast and not drawn
    drawn := true
    if showLevels
        drawLine(475.81, color.red, "R High kemarin (PDH)", false)
        drawLine(466.76, color.red, "R Swing high H1", false)
        drawLine(457.78, color.red, "R R1 harian", false)
        drawLine(437.22, color.red, "R Swing low H1", false)
        drawLine(430.00, color.red, "R Swing low H1", false)
        drawLine(426.92, color.gray, "P Pivot harian", false)
        drawLine(412.70, color.red, "R Swing high H1", false)
        drawLine(410.00, color.red, "R Angka bulat", false)
        drawLine(407.50, color.green, "S Angka bulat", false)
        drawLine(396.07, color.green, "S Low kemarin (PDL)", false)
        drawLine(378.04, color.green, "S S1 harian", false)
    if showPlans
        box.new(bar_index - 20, 414.58 + offset, bar_index + 40, 410.82 + offset, border_color=color.red, bgcolor=color.new(color.red, 85), text="SELL Utama 71%", text_color=color.red, text_size=size.small)
        drawLine(423.06, color.red, "SL SELL", true)
        drawLine(396.07, color.blue, "TP1 SELL", true)
        drawLine(378.04, color.blue, "TP2 SELL", true)
        box.new(bar_index - 20, 409.38 + offset, bar_index + 40, 405.62 + offset, border_color=color.green, bgcolor=color.new(color.green, 85), text="BUY Alternatif 32%", text_color=color.green, text_size=size.small)
        drawLine(397.14, color.red, "SL BUY", true)
        drawLine(426.92, color.blue, "TP1 BUY", true)
        drawLine(437.22, color.blue, "TP2 BUY", true)

inZone0 = close >= 410.82 + offset and close <= 414.58 + offset
alertcondition(inZone0 and not inZone0[1], "KPX SELL Utama: masuk zona", "XMRUSD masuk zona SELL {{close}} - EA entry")
inZone1 = close >= 405.62 + offset and close <= 409.38 + offset
alertcondition(inZone1 and not inZone1[1], "KPX BUY Alternatif: masuk zona", "XMRUSD masuk zona BUY {{close}} - EA entry")
plot(na, "KPX")
