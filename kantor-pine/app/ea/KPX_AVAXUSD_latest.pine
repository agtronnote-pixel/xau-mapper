//@version=6
indicator("KPX Mapping AVAXUSD 202611241207", overlay=true, max_lines_count=100, max_boxes_count=20, max_labels_count=60)
// Dibuat otomatis oleh Kantor Pine (AVAXUSD) dari mapping 2026-11-24T05:07:27.692Z (harga 6.8020).
// Bukan nasihat keuangan. Konfirmasi di chart dan selalu gunakan stop loss.
offset = input.float(0.0, "Selisih harga broker - mapping (USD)", group="Umum", tooltip="Isi bila harga broker berbeda dari harga mapping")
showLevels = input.bool(true, "Tampilkan level kunci", group="Tampilan")
showPlans = input.bool(true, "Tampilkan rencana entry", group="Tampilan")

drawLine(float p, color c, string t, bool solid) =>
    line.new(bar_index - 1, p + offset, bar_index, p + offset, extend=extend.both, color=c, style=solid ? line.style_solid : line.style_dashed, width=1)
    label.new(bar_index + 3, p + offset, t + " " + str.tostring(p + offset, "#.00"), style=label.style_none, textcolor=c, size=size.small)

var bool drawn = false
if barstate.islast and not drawn
    drawn := true
    if showLevels
        drawLine(7.2290, color.red, "R High kemarin (PDH)", false)
        drawLine(7.1557, color.red, "R R1 harian", false)
        drawLine(6.8583, color.gray, "P Pivot harian", false)
        drawLine(6.8000, color.green, "S Angka bulat", false)
        drawLine(6.7620, color.green, "S Swing high H1", false)
        drawLine(6.7280, color.green, "S Swing high H1", false)
        drawLine(6.6770, color.green, "S Swing low H1", false)
        drawLine(6.5610, color.green, "S Low kemarin (PDL)", false)
        drawLine(6.4877, color.green, "S S1 harian", false)
    if showPlans
        box.new(bar_index - 20, 6.8774 + offset, bar_index + 40, 6.8392 + offset, border_color=color.red, bgcolor=color.new(color.red, 85), text="SELL Range 57%", text_color=color.red, text_size=size.small)
        drawLine(6.9632, color.red, "SL SELL", true)
        drawLine(6.7280, color.blue, "TP1 SELL", true)
        drawLine(6.5610, color.blue, "TP2 SELL", true)
        box.new(bar_index - 20, 6.7811 + offset, bar_index + 40, 6.7429 + offset, border_color=color.green, bgcolor=color.new(color.green, 85), text="BUY Range 44%", text_color=color.green, text_size=size.small)
        drawLine(6.6571, color.red, "SL BUY", true)
        drawLine(6.9194, color.blue, "TP1 BUY", true)
        drawLine(7.1557, color.blue, "TP2 BUY", true)

inZone0 = close >= 6.8392 + offset and close <= 6.8774 + offset
alertcondition(inZone0 and not inZone0[1], "KPX SELL Range: masuk zona", "AVAXUSD masuk zona SELL {{close}} - EA entry")
inZone1 = close >= 6.7429 + offset and close <= 6.7811 + offset
alertcondition(inZone1 and not inZone1[1], "KPX BUY Range: masuk zona", "AVAXUSD masuk zona BUY {{close}} - EA entry")
plot(na, "KPX")
