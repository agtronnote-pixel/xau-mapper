//@version=6
indicator("KPX Mapping AVAXUSD 202611252207", overlay=true, max_lines_count=100, max_boxes_count=20, max_labels_count=60)
// Dibuat otomatis oleh Kantor Pine (AVAXUSD) dari mapping 2026-11-25T15:07:24.330Z (harga 6.3610).
// Bukan nasihat keuangan. Konfirmasi di chart dan selalu gunakan stop loss.
offset = input.float(0.0, "Selisih harga broker - mapping (USD)", group="Umum", tooltip="Isi bila harga broker berbeda dari harga mapping")
showLevels = input.bool(true, "Tampilkan level kunci", group="Tampilan")
showPlans = input.bool(true, "Tampilkan rencana entry", group="Tampilan")

drawLine(float p, color c, string t, bool solid) =>
    line.new(bar_index - 1, p + offset, bar_index, p + offset, extend=extend.both, color=c, style=solid ? line.style_solid : line.style_dashed, width=1)
    label.new(bar_index + 3, p + offset, t + " " + str.tostring(p + offset, "#.00"), style=label.style_none, textcolor=c, size=size.small)

var bool drawn = false
if barstate.islast and not drawn
    drawn := true
    if showLevels
        drawLine(6.8720, color.red, "R High kemarin (PDH)", false)
        drawLine(6.8080, color.red, "R R1 harian", false)
        drawLine(6.7610, color.red, "R Swing high H1", false)
        drawLine(6.6410, color.gray, "P Pivot harian", false)
        drawLine(6.6230, color.red, "R Swing high H1", false)
        drawLine(6.5580, color.red, "R Swing high H1", false)
        drawLine(6.5220, color.red, "R Swing low H1", false)
        drawLine(6.4740, color.red, "R Low kemarin (PDL)", false)
        drawLine(6.4500, color.red, "R Swing low H1", false)
        drawLine(6.4100, color.red, "R S1 harian", false)
        drawLine(6.3500, color.green, "S Angka bulat", false)
        drawLine(6.3000, color.green, "S Angka bulat", false)
    if showPlans
        box.new(bar_index - 20, 6.4241 + offset, bar_index + 40, 6.3959 + offset, border_color=color.red, bgcolor=color.new(color.red, 85), text="SELL Utama 78%", text_color=color.red, text_size=size.small)
        drawLine(6.4876, color.red, "SL SELL", true)
        drawLine(6.3000, color.blue, "TP1 SELL", true)
        drawLine(6.1772, color.blue, "TP2 SELL", true)
        box.new(bar_index - 20, 6.3141 + offset, bar_index + 40, 6.2859 + offset, border_color=color.green, bgcolor=color.new(color.green, 85), text="BUY Alternatif 23%", text_color=color.green, text_size=size.small)
        drawLine(6.2225, color.red, "SL BUY", true)
        drawLine(6.4100, color.blue, "TP1 BUY", true)
        drawLine(6.4500, color.blue, "TP2 BUY", true)

inZone0 = close >= 6.3959 + offset and close <= 6.4241 + offset
alertcondition(inZone0 and not inZone0[1], "KPX SELL Utama: masuk zona", "AVAXUSD masuk zona SELL {{close}} - EA entry")
inZone1 = close >= 6.2859 + offset and close <= 6.3141 + offset
alertcondition(inZone1 and not inZone1[1], "KPX BUY Alternatif: masuk zona", "AVAXUSD masuk zona BUY {{close}} - EA entry")
plot(na, "KPX")
