//@version=6
indicator("KPX Mapping AVAXUSD 202611232207", overlay=true, max_lines_count=100, max_boxes_count=20, max_labels_count=60)
// Dibuat otomatis oleh Kantor Pine (AVAXUSD) dari mapping 2026-11-23T15:07:22.017Z (harga 7.0640).
// Bukan nasihat keuangan. Konfirmasi di chart dan selalu gunakan stop loss.
offset = input.float(0.0, "Selisih harga broker - mapping (USD)", group="Umum", tooltip="Isi bila harga broker berbeda dari harga mapping")
showLevels = input.bool(true, "Tampilkan level kunci", group="Tampilan")
showPlans = input.bool(true, "Tampilkan rencana entry", group="Tampilan")

drawLine(float p, color c, string t, bool solid) =>
    line.new(bar_index - 1, p + offset, bar_index, p + offset, extend=extend.both, color=c, style=solid ? line.style_solid : line.style_dashed, width=1)
    label.new(bar_index + 3, p + offset, t + " " + str.tostring(p + offset, "#.00"), style=label.style_none, textcolor=c, size=size.small)

var bool drawn = false
if barstate.islast and not drawn
    drawn := true
    if showLevels
        drawLine(7.1000, color.red, "R Angka bulat", false)
        drawLine(7.0500, color.green, "S Angka bulat", false)
        drawLine(7.0000, color.green, "S Angka bulat", false)
        drawLine(6.8193, color.green, "S R1 harian", false)
        drawLine(6.7780, color.green, "S High kemarin (PDH)", false)
        drawLine(6.7050, color.green, "S Swing high H1", false)
        drawLine(6.6487, color.gray, "P Pivot harian", false)
        drawLine(6.5610, color.green, "S Swing low H1", false)
        drawLine(6.5193, color.green, "S S1 harian", false)
        drawLine(6.4780, color.green, "S Low kemarin (PDL)", false)
    if showPlans
        box.new(bar_index - 20, 7.0230 + offset, bar_index + 40, 6.9770 + offset, border_color=color.green, bgcolor=color.new(color.green, 85), text="BUY Utama 72%", text_color=color.green, text_size=size.small)
        drawLine(6.8736, color.red, "SL BUY", true)
        drawLine(7.1896, color.blue, "TP1 BUY", true)
        drawLine(7.3792, color.blue, "TP2 BUY", true)
        box.new(bar_index - 20, 7.1230 + offset, bar_index + 40, 7.0770 + offset, border_color=color.red, bgcolor=color.new(color.red, 85), text="SELL Alternatif 30%", text_color=color.red, text_size=size.small)
        drawLine(7.2264, color.red, "SL SELL", true)
        drawLine(6.9104, color.blue, "TP1 SELL", true)
        drawLine(6.8193, color.blue, "TP2 SELL", true)

inZone0 = close >= 6.9770 + offset and close <= 7.0230 + offset
alertcondition(inZone0 and not inZone0[1], "KPX BUY Utama: masuk zona", "AVAXUSD masuk zona BUY {{close}} - EA entry")
inZone1 = close >= 7.0770 + offset and close <= 7.1230 + offset
alertcondition(inZone1 and not inZone1[1], "KPX SELL Alternatif: masuk zona", "AVAXUSD masuk zona SELL {{close}} - EA entry")
plot(na, "KPX")
