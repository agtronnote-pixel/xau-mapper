//@version=6
indicator("KPX Mapping AVAXUSD 202611272007", overlay=true, max_lines_count=100, max_boxes_count=20, max_labels_count=60)
// Dibuat otomatis oleh Kantor Pine (AVAXUSD) dari mapping 2026-11-27T13:07:26.478Z (harga 6.7750).
// Bukan nasihat keuangan. Konfirmasi di chart dan selalu gunakan stop loss.
offset = input.float(0.0, "Selisih harga broker - mapping (USD)", group="Umum", tooltip="Isi bila harga broker berbeda dari harga mapping")
showLevels = input.bool(true, "Tampilkan level kunci", group="Tampilan")
showPlans = input.bool(true, "Tampilkan rencana entry", group="Tampilan")

drawLine(float p, color c, string t, bool solid) =>
    line.new(bar_index - 1, p + offset, bar_index, p + offset, extend=extend.both, color=c, style=solid ? line.style_solid : line.style_dashed, width=1)
    label.new(bar_index + 3, p + offset, t + " " + str.tostring(p + offset, "#.00"), style=label.style_none, textcolor=c, size=size.small)

var bool drawn = false
if barstate.islast and not drawn
    drawn := true
    if showLevels
        drawLine(6.8500, color.red, "R Angka bulat", false)
        drawLine(6.8220, color.red, "R Swing high H1", false)
        drawLine(6.8000, color.red, "R Angka bulat", false)
        drawLine(6.7500, color.green, "S High kemarin (PDH)", false)
        drawLine(6.7290, color.green, "S Swing low H1", false)
        drawLine(6.6990, color.green, "S Swing high H1", false)
        drawLine(6.6860, color.green, "S Swing high H1", false)
        drawLine(6.6180, color.green, "S Swing low H1", false)
        drawLine(6.6050, color.gray, "P Pivot harian", false)
        drawLine(6.5730, color.green, "S Swing low H1", false)
        drawLine(6.4700, color.green, "S Low kemarin (PDL)", false)
    if showPlans
        box.new(bar_index - 20, 6.7599 + offset, bar_index + 40, 6.7401 + offset, border_color=color.green, bgcolor=color.new(color.green, 85), text="BUY Utama 78%", text_color=color.green, text_size=size.small)
        drawLine(6.6954, color.red, "SL BUY", true)
        drawLine(6.8220, color.blue, "TP1 BUY", true)
        drawLine(6.8500, color.blue, "TP2 BUY", true)
        box.new(bar_index - 20, 6.8099 + offset, bar_index + 40, 6.7901 + offset, border_color=color.red, bgcolor=color.new(color.red, 85), text="SELL Alternatif 23%", text_color=color.red, text_size=size.small)
        drawLine(6.8546, color.red, "SL SELL", true)
        drawLine(6.7290, color.blue, "TP1 SELL", true)
        drawLine(6.6990, color.blue, "TP2 SELL", true)

inZone0 = close >= 6.7401 + offset and close <= 6.7599 + offset
alertcondition(inZone0 and not inZone0[1], "KPX BUY Utama: masuk zona", "AVAXUSD masuk zona BUY {{close}} - EA entry")
inZone1 = close >= 6.7901 + offset and close <= 6.8099 + offset
alertcondition(inZone1 and not inZone1[1], "KPX SELL Alternatif: masuk zona", "AVAXUSD masuk zona SELL {{close}} - EA entry")
plot(na, "KPX")
