//@version=6
indicator("KPX Mapping XAUUSD 202611232307", overlay=true, max_lines_count=100, max_boxes_count=20, max_labels_count=60)
// Dibuat otomatis oleh Kantor Pine (XAUUSD) dari mapping 2026-11-23T16:07:12.508Z (harga 3674.05).
// Bukan nasihat keuangan. Konfirmasi di chart dan selalu gunakan stop loss.
offset = input.float(0.0, "Selisih harga broker - mapping (USD)", group="Umum", tooltip="Isi bila harga broker berbeda dari harga mapping")
showLevels = input.bool(true, "Tampilkan level kunci", group="Tampilan")
showPlans = input.bool(true, "Tampilkan rencana entry", group="Tampilan")

drawLine(float p, color c, string t, bool solid) =>
    line.new(bar_index - 1, p + offset, bar_index, p + offset, extend=extend.both, color=c, style=solid ? line.style_solid : line.style_dashed, width=1)
    label.new(bar_index + 3, p + offset, t + " " + str.tostring(p + offset, "#.00"), style=label.style_none, textcolor=c, size=size.small)

var bool drawn = false
if barstate.islast and not drawn
    drawn := true
    if showLevels
        drawLine(3700.00, color.red, "R Angka bulat", false)
        drawLine(3691.20, color.red, "R Swing high H1", false)
        drawLine(3675.00, color.red, "R Angka bulat", false)
        drawLine(3650.00, color.green, "S Angka bulat", false)
        drawLine(3638.30, color.green, "S High kemarin (PDH)", false)
        drawLine(3629.80, color.green, "S Swing high H1", false)
        drawLine(3612.00, color.green, "S Swing low H1", false)
        drawLine(3601.57, color.green, "S R1 harian", false)
        drawLine(3552.33, color.gray, "P Pivot harian", false)
        drawLine(3515.10, color.green, "S Swing low H1", false)
    if showPlans
        box.new(bar_index - 20, 3655.00 + offset, bar_index + 40, 3645.00 + offset, border_color=color.green, bgcolor=color.new(color.green, 85), text="BUY Utama 64%", text_color=color.green, text_size=size.small)
        drawLine(3622.48, color.red, "SL BUY", true)
        drawLine(3691.20, color.blue, "TP1 BUY", true)
        drawLine(3732.56, color.blue, "TP2 BUY", true)
        box.new(bar_index - 20, 3696.20 + offset, bar_index + 40, 3686.20 + offset, border_color=color.red, bgcolor=color.new(color.red, 85), text="SELL Alternatif 40%", text_color=color.red, text_size=size.small)
        drawLine(3718.72, color.red, "SL SELL", true)
        drawLine(3650.00, color.blue, "TP1 SELL", true)
        drawLine(3629.80, color.blue, "TP2 SELL", true)

inZone0 = close >= 3645.00 + offset and close <= 3655.00 + offset
alertcondition(inZone0 and not inZone0[1], "KPX BUY Utama: masuk zona", "XAUUSD masuk zona BUY {{close}} - EA entry")
inZone1 = close >= 3686.20 + offset and close <= 3696.20 + offset
alertcondition(inZone1 and not inZone1[1], "KPX SELL Alternatif: masuk zona", "XAUUSD masuk zona SELL {{close}} - EA entry")
plot(na, "KPX")
