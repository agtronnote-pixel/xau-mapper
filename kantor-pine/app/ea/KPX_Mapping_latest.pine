//@version=6
indicator("KPX Mapping XAUUSD 202611272307", overlay=true, max_lines_count=100, max_boxes_count=20, max_labels_count=60)
// Dibuat otomatis oleh Kantor Pine (XAUUSD) dari mapping 2026-11-27T16:07:11.597Z (harga 3620.90).
// Bukan nasihat keuangan. Konfirmasi di chart dan selalu gunakan stop loss.
offset = input.float(0.0, "Selisih harga broker - mapping (USD)", group="Umum", tooltip="Isi bila harga broker berbeda dari harga mapping")
showLevels = input.bool(true, "Tampilkan level kunci", group="Tampilan")
showPlans = input.bool(true, "Tampilkan rencana entry", group="Tampilan")

drawLine(float p, color c, string t, bool solid) =>
    line.new(bar_index - 1, p + offset, bar_index, p + offset, extend=extend.both, color=c, style=solid ? line.style_solid : line.style_dashed, width=1)
    label.new(bar_index + 3, p + offset, t + " " + str.tostring(p + offset, "#.00"), style=label.style_none, textcolor=c, size=size.small)

var bool drawn = false
if barstate.islast and not drawn
    drawn := true
    if showLevels
        drawLine(3683.40, color.red, "R Swing high H1", false)
        drawLine(3650.00, color.red, "R Angka bulat", false)
        drawLine(3625.00, color.red, "R Angka bulat", false)
        drawLine(3605.20, color.green, "S High kemarin (PDH)", false)
        drawLine(3597.83, color.green, "S R1 harian", false)
        drawLine(3590.30, color.green, "S Swing high H1", false)
        drawLine(3582.90, color.green, "S Swing high H1", false)
        drawLine(3573.57, color.gray, "P Pivot harian", false)
        drawLine(3564.00, color.green, "S Swing low H1", false)
        drawLine(3557.90, color.green, "S Swing low H1", false)
        drawLine(3549.30, color.green, "S Low kemarin (PDL)", false)
        drawLine(3541.93, color.green, "S S1 harian", false)
    if showPlans
        box.new(bar_index - 20, 3608.67 + offset, bar_index + 40, 3601.73 + offset, border_color=color.green, bgcolor=color.new(color.green, 85), text="BUY Range 54%", text_color=color.green, text_size=size.small)
        drawLine(3586.13, color.red, "SL BUY", true)
        drawLine(3625.00, color.blue, "TP1 BUY", true)
        drawLine(3650.00, color.blue, "TP2 BUY", true)
        box.new(bar_index - 20, 3628.47 + offset, bar_index + 40, 3621.53 + offset, border_color=color.red, bgcolor=color.new(color.red, 85), text="SELL Range 45%", text_color=color.red, text_size=size.small)
        drawLine(3644.07, color.red, "SL SELL", true)
        drawLine(3605.20, color.blue, "TP1 SELL", true)
        drawLine(3590.30, color.blue, "TP2 SELL", true)

inZone0 = close >= 3601.73 + offset and close <= 3608.67 + offset
alertcondition(inZone0 and not inZone0[1], "KPX BUY Range: masuk zona", "XAUUSD masuk zona BUY {{close}} - EA entry")
inZone1 = close >= 3621.53 + offset and close <= 3628.47 + offset
alertcondition(inZone1 and not inZone1[1], "KPX SELL Range: masuk zona", "XAUUSD masuk zona SELL {{close}} - EA entry")
plot(na, "KPX")
