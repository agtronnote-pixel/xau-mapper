//@version=6
indicator("KPX Mapping XAUUSD 202611252207", overlay=true, max_lines_count=100, max_boxes_count=20, max_labels_count=60)
// Dibuat otomatis oleh Kantor Pine (XAUUSD) dari mapping 2026-11-25T15:07:12.165Z (harga 3470.70).
// Bukan nasihat keuangan. Konfirmasi di chart dan selalu gunakan stop loss.
offset = input.float(0.0, "Selisih harga broker - mapping (USD)", group="Umum", tooltip="Isi bila harga broker berbeda dari harga mapping")
showLevels = input.bool(true, "Tampilkan level kunci", group="Tampilan")
showPlans = input.bool(true, "Tampilkan rencana entry", group="Tampilan")

drawLine(float p, color c, string t, bool solid) =>
    line.new(bar_index - 1, p + offset, bar_index, p + offset, extend=extend.both, color=c, style=solid ? line.style_solid : line.style_dashed, width=1)
    label.new(bar_index + 3, p + offset, t + " " + str.tostring(p + offset, "#.00"), style=label.style_none, textcolor=c, size=size.small)

var bool drawn = false
if barstate.islast and not drawn
    drawn := true
    if showLevels
        drawLine(3637.98, color.red, "R R1 harian", false)
        drawLine(3606.25, color.red, "R Swing low H1", false)
        drawLine(3591.62, color.gray, "P Pivot harian", false)
        drawLine(3566.65, color.red, "R Swing high H1", false)
        drawLine(3545.25, color.red, "R Low kemarin (PDL)", false)
        drawLine(3532.25, color.red, "R Swing low H1", false)
        drawLine(3506.68, color.red, "R S1 harian", false)
        drawLine(3475.00, color.red, "R Angka bulat", false)
        drawLine(3450.00, color.green, "S Angka bulat", false)
    if showPlans
        box.new(bar_index - 20, 3514.29 + offset, bar_index + 40, 3499.07 + offset, border_color=color.red, bgcolor=color.new(color.red, 85), text="SELL Utama 78%", text_color=color.red, text_size=size.small)
        drawLine(3548.54, color.red, "SL SELL", true)
        drawLine(3450.00, color.blue, "TP1 SELL", true)
        drawLine(3381.10, color.blue, "TP2 SELL", true)
        box.new(bar_index - 20, 3457.61 + offset, bar_index + 40, 3442.39 + offset, border_color=color.green, bgcolor=color.new(color.green, 85), text="BUY Alternatif 17%", text_color=color.green, text_size=size.small)
        drawLine(3408.14, color.red, "SL BUY", true)
        drawLine(3506.68, color.blue, "TP1 BUY", true)
        drawLine(3532.25, color.blue, "TP2 BUY", true)

inZone0 = close >= 3499.07 + offset and close <= 3514.29 + offset
alertcondition(inZone0 and not inZone0[1], "KPX SELL Utama: masuk zona", "XAUUSD masuk zona SELL {{close}} - EA entry")
inZone1 = close >= 3442.39 + offset and close <= 3457.61 + offset
alertcondition(inZone1 and not inZone1[1], "KPX BUY Alternatif: masuk zona", "XAUUSD masuk zona BUY {{close}} - EA entry")
plot(na, "KPX")
