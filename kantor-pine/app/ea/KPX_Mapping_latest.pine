//@version=6
indicator("KPX Mapping XAUUSD 202611252107", overlay=true, max_lines_count=100, max_boxes_count=20, max_labels_count=60)
// Dibuat otomatis oleh Kantor Pine (XAUUSD) dari mapping 2026-11-25T14:07:14.344Z (harga 3481.80).
// Bukan nasihat keuangan. Konfirmasi di chart dan selalu gunakan stop loss.
offset = input.float(0.0, "Selisih harga broker - mapping (USD)", group="Umum", tooltip="Isi bila harga broker berbeda dari harga mapping")
showLevels = input.bool(true, "Tampilkan level kunci", group="Tampilan")
showPlans = input.bool(true, "Tampilkan rencana entry", group="Tampilan")

drawLine(float p, color c, string t, bool solid) =>
    line.new(bar_index - 1, p + offset, bar_index, p + offset, extend=extend.both, color=c, style=solid ? line.style_solid : line.style_dashed, width=1)
    label.new(bar_index + 3, p + offset, t + " " + str.tostring(p + offset, "#.00"), style=label.style_none, textcolor=c, size=size.small)

var bool drawn = false
if barstate.islast and not drawn
    drawn := true
    if showLevels
        drawLine(3651.30, color.red, "R Swing high H1", false)
        drawLine(3638.00, color.red, "R R1 harian", false)
        drawLine(3606.30, color.red, "R Swing low H1", false)
        drawLine(3591.65, color.gray, "P Pivot harian", false)
        drawLine(3566.70, color.red, "R Swing high H1", false)
        drawLine(3545.30, color.red, "R Low kemarin (PDL)", false)
        drawLine(3532.30, color.red, "R Swing low H1", false)
        drawLine(3506.70, color.red, "R S1 harian", false)
        drawLine(3475.00, color.green, "S Angka bulat", false)
        drawLine(3450.00, color.green, "S Angka bulat", false)
    if showPlans
        box.new(bar_index - 20, 3513.68 + offset, bar_index + 40, 3499.72 + offset, border_color=color.red, bgcolor=color.new(color.red, 85), text="SELL Utama 70%", text_color=color.red, text_size=size.small)
        drawLine(3545.07, color.red, "SL SELL", true)
        drawLine(3450.00, color.blue, "TP1 SELL", true)
        drawLine(3391.59, color.blue, "TP2 SELL", true)
        box.new(bar_index - 20, 3456.98 + offset, bar_index + 40, 3443.02 + offset, border_color=color.green, bgcolor=color.new(color.green, 85), text="BUY Alternatif 16%", text_color=color.green, text_size=size.small)
        drawLine(3411.63, color.red, "SL BUY", true)
        drawLine(3506.70, color.blue, "TP1 BUY", true)
        drawLine(3532.30, color.blue, "TP2 BUY", true)

inZone0 = close >= 3499.72 + offset and close <= 3513.68 + offset
alertcondition(inZone0 and not inZone0[1], "KPX SELL Utama: masuk zona", "XAUUSD masuk zona SELL {{close}} - EA entry")
inZone1 = close >= 3443.02 + offset and close <= 3456.98 + offset
alertcondition(inZone1 and not inZone1[1], "KPX BUY Alternatif: masuk zona", "XAUUSD masuk zona BUY {{close}} - EA entry")
plot(na, "KPX")
