//@version=6
indicator("KPX Mapping XAUUSD 202611260907", overlay=true, max_lines_count=100, max_boxes_count=20, max_labels_count=60)
// Dibuat otomatis oleh Kantor Pine (XAUUSD) dari mapping 2026-11-26T02:07:13.627Z (harga 3569.10).
// Bukan nasihat keuangan. Konfirmasi di chart dan selalu gunakan stop loss.
offset = input.float(0.0, "Selisih harga broker - mapping (USD)", group="Umum", tooltip="Isi bila harga broker berbeda dari harga mapping")
showLevels = input.bool(true, "Tampilkan level kunci", group="Tampilan")
showPlans = input.bool(true, "Tampilkan rencana entry", group="Tampilan")

drawLine(float p, color c, string t, bool solid) =>
    line.new(bar_index - 1, p + offset, bar_index, p + offset, extend=extend.both, color=c, style=solid ? line.style_solid : line.style_dashed, width=1)
    label.new(bar_index + 3, p + offset, t + " " + str.tostring(p + offset, "#.00"), style=label.style_none, textcolor=c, size=size.small)

var bool drawn = false
if barstate.islast and not drawn
    drawn := true
    if showLevels
        drawLine(3654.43, color.red, "R R1 harian", false)
        drawLine(3616.20, color.red, "R High kemarin (PDH)", false)
        drawLine(3600.00, color.red, "R Angka bulat", false)
        drawLine(3565.20, color.green, "S Swing high H1", false)
        drawLine(3542.02, color.gray, "P Pivot harian", false)
        drawLine(3509.70, color.green, "S Swing low H1", false)
        drawLine(3467.83, color.green, "S S1 harian", false)
        drawLine(3429.60, color.green, "S Low kemarin (PDL)", false)
    if showPlans
        box.new(bar_index - 20, 3611.82 + offset, bar_index + 40, 3588.18 + offset, border_color=color.red, bgcolor=color.new(color.red, 85), text="SELL Utama 53%", text_color=color.red, text_size=size.small)
        drawLine(3665.00, color.red, "SL SELL", true)
        drawLine(3509.70, color.blue, "TP1 SELL", true)
        drawLine(3467.83, color.blue, "TP2 SELL", true)
        box.new(bar_index - 20, 3553.84 + offset, bar_index + 40, 3530.20 + offset, border_color=color.green, bgcolor=color.new(color.green, 85), text="BUY Alternatif 41%", text_color=color.green, text_size=size.small)
        drawLine(3477.02, color.red, "SL BUY", true)
        drawLine(3616.20, color.blue, "TP1 BUY", true)
        drawLine(3654.43, color.blue, "TP2 BUY", true)

inZone0 = close >= 3588.18 + offset and close <= 3611.82 + offset
alertcondition(inZone0 and not inZone0[1], "KPX SELL Utama: masuk zona", "XAUUSD masuk zona SELL {{close}} - EA entry")
inZone1 = close >= 3530.20 + offset and close <= 3553.84 + offset
alertcondition(inZone1 and not inZone1[1], "KPX BUY Alternatif: masuk zona", "XAUUSD masuk zona BUY {{close}} - EA entry")
plot(na, "KPX")
