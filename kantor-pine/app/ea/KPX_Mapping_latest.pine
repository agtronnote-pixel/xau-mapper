//@version=6
indicator("KPX Mapping XAUUSD 202611230600", overlay=true, max_lines_count=100, max_boxes_count=20, max_labels_count=60)
// Dibuat otomatis oleh Kantor Pine XAUUSD dari mapping 2026-11-22T23:00:00.000Z (harga 3539.00).
// Bukan nasihat keuangan. Konfirmasi di chart dan selalu gunakan stop loss.
offset = input.float(0.0, "Selisih harga broker - mapping (USD)", group="Umum", tooltip="Isi bila harga broker berbeda dari harga mapping")
showLevels = input.bool(true, "Tampilkan level kunci", group="Tampilan")
showPlans = input.bool(true, "Tampilkan rencana entry", group="Tampilan")

drawLine(float p, color c, string t, bool solid) =>
    line.new(bar_index - 1, p + offset, bar_index, p + offset, extend=extend.both, color=c, style=solid ? line.style_solid : line.style_dashed, width=1)
    label.new(bar_index + 3, p + offset, t + " " + str.tostring(p + offset, "#.00"), style=label.style_none, textcolor=c, size=size.small)

var bool drawn = false
if barstate.islast and not drawn
    drawn := true
    if showLevels
        drawLine(3638.10, color.red, "R High kemarin (PDH)", false)
        drawLine(3601.37, color.red, "R R1 harian", false)
        drawLine(3595.50, color.red, "R Swing high H1", false)
        drawLine(3575.00, color.red, "R Angka bulat", false)
        drawLine(3552.13, color.gray, "P Pivot harian", false)
        drawLine(3525.00, color.green, "S Angka bulat", false)
        drawLine(3502.90, color.green, "S Low kemarin (PDL)", false)
        drawLine(3466.17, color.green, "S S1 harian", false)
    if showPlans
        box.new(bar_index - 20, 3556.40 + offset, bar_index + 40, 3547.86 + offset, border_color=color.red, bgcolor=color.new(color.red, 85), text="SELL Utama", text_color=color.red, text_size=size.small)
        drawLine(3575.62, color.red, "SL SELL", true)
        drawLine(3525.00, color.blue, "TP1 SELL", true)
        drawLine(3502.90, color.blue, "TP2 SELL", true)
        box.new(bar_index - 20, 3529.27 + offset, bar_index + 40, 3520.73 + offset, border_color=color.green, bgcolor=color.new(color.green, 85), text="BUY Alternatif", text_color=color.green, text_size=size.small)
        drawLine(3501.51, color.red, "SL BUY", true)
        drawLine(3552.13, color.blue, "TP1 BUY", true)
        drawLine(3575.00, color.blue, "TP2 BUY", true)

inZone0 = close >= 3547.86 + offset and close <= 3556.40 + offset
alertcondition(inZone0 and not inZone0[1], "KPX SELL Utama: masuk zona", "XAUUSD masuk zona SELL {{close}} - tunggu konfirmasi")
inZone1 = close >= 3520.73 + offset and close <= 3529.27 + offset
alertcondition(inZone1 and not inZone1[1], "KPX BUY Alternatif: masuk zona", "XAUUSD masuk zona BUY {{close}} - tunggu konfirmasi")
plot(na, "KPX")
