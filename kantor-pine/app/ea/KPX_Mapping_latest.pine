//@version=6
indicator("KPX Mapping XAUUSD 202611231007", overlay=true, max_lines_count=100, max_boxes_count=20, max_labels_count=60)
// Dibuat otomatis oleh Kantor Pine (XAUUSD) dari mapping 2026-11-23T03:07:17.541Z (harga 3592.60).
// Bukan nasihat keuangan. Konfirmasi di chart dan selalu gunakan stop loss.
offset = input.float(0.0, "Selisih harga broker - mapping (USD)", group="Umum", tooltip="Isi bila harga broker berbeda dari harga mapping")
showLevels = input.bool(true, "Tampilkan level kunci", group="Tampilan")
showPlans = input.bool(true, "Tampilkan rencana entry", group="Tampilan")

drawLine(float p, color c, string t, bool solid) =>
    line.new(bar_index - 1, p + offset, bar_index, p + offset, extend=extend.both, color=c, style=solid ? line.style_solid : line.style_dashed, width=1)
    label.new(bar_index + 3, p + offset, t + " " + str.tostring(p + offset, "#.00"), style=label.style_none, textcolor=c, size=size.small)

var bool drawn = false
if barstate.islast and not drawn
    drawn := true
    if showLevels
        drawLine(3744.40, color.red, "R Swing high H1", false)
        drawLine(3722.40, color.red, "R Swing low H1", false)
        drawLine(3695.10, color.red, "R Swing low H1", false)
        drawLine(3638.70, color.red, "R High kemarin (PDH)", false)
        drawLine(3625.00, color.red, "R Angka bulat", false)
        drawLine(3601.97, color.red, "R R1 harian", false)
        drawLine(3587.60, color.green, "S Swing high H1", false)
        drawLine(3575.00, color.green, "S Angka bulat", false)
        drawLine(3552.73, color.gray, "P Pivot harian", false)
        drawLine(3515.50, color.green, "S Swing low H1", false)
        drawLine(3503.50, color.green, "S Low kemarin (PDL)", false)
        drawLine(3466.77, color.green, "S S1 harian", false)
    if showPlans
        box.new(bar_index - 20, 3608.87 + offset, bar_index + 40, 3595.07 + offset, border_color=color.red, bgcolor=color.new(color.red, 85), text="SELL Range 54%", text_color=color.red, text_size=size.small)
        drawLine(3639.94, color.red, "SL SELL", true)
        drawLine(3552.73, color.blue, "TP1 SELL", true)
        drawLine(3515.50, color.blue, "TP2 SELL", true)
        box.new(bar_index - 20, 3581.90 + offset, bar_index + 40, 3568.10 + offset, border_color=color.green, bgcolor=color.new(color.green, 85), text="BUY Range 40%", text_color=color.green, text_size=size.small)
        drawLine(3537.03, color.red, "SL BUY", true)
        drawLine(3625.00, color.blue, "TP1 BUY", true)
        drawLine(3695.10, color.blue, "TP2 BUY", true)

inZone0 = close >= 3595.07 + offset and close <= 3608.87 + offset
alertcondition(inZone0 and not inZone0[1], "KPX SELL Range: masuk zona", "XAUUSD masuk zona SELL {{close}} - EA entry")
inZone1 = close >= 3568.10 + offset and close <= 3581.90 + offset
alertcondition(inZone1 and not inZone1[1], "KPX BUY Range: masuk zona", "XAUUSD masuk zona BUY {{close}} - EA entry")
plot(na, "KPX")
