//@version=6
indicator("KPX Mapping XAUUSD 202611240707", overlay=true, max_lines_count=100, max_boxes_count=20, max_labels_count=60)
// Dibuat otomatis oleh Kantor Pine (XAUUSD) dari mapping 2026-11-24T00:07:14.627Z (harga 3636.40).
// Bukan nasihat keuangan. Konfirmasi di chart dan selalu gunakan stop loss.
offset = input.float(0.0, "Selisih harga broker - mapping (USD)", group="Umum", tooltip="Isi bila harga broker berbeda dari harga mapping")
showLevels = input.bool(true, "Tampilkan level kunci", group="Tampilan")
showPlans = input.bool(true, "Tampilkan rencana entry", group="Tampilan")

drawLine(float p, color c, string t, bool solid) =>
    line.new(bar_index - 1, p + offset, bar_index, p + offset, extend=extend.both, color=c, style=solid ? line.style_solid : line.style_dashed, width=1)
    label.new(bar_index + 3, p + offset, t + " " + str.tostring(p + offset, "#.00"), style=label.style_none, textcolor=c, size=size.small)

var bool drawn = false
if barstate.islast and not drawn
    drawn := true
    if showLevels
        drawLine(3703.13, color.red, "R R1 harian", false)
        drawLine(3691.15, color.red, "R High kemarin (PDH)", false)
        drawLine(3650.00, color.red, "R Angka bulat", false)
        drawLine(3636.55, color.red, "R Swing high H1", false)
        drawLine(3629.75, color.green, "S Swing high H1", false)
        drawLine(3621.07, color.gray, "P Pivot harian", false)
        drawLine(3611.95, color.green, "S Swing low H1", false)
        drawLine(3600.05, color.green, "S Swing low H1", false)
        drawLine(3550.98, color.green, "S S1 harian", false)
        drawLine(3539.00, color.green, "S Low kemarin (PDL)", false)
        drawLine(3503.05, color.green, "S Swing low H1", false)
    if showPlans
        box.new(bar_index - 20, 3634.26 + offset, bar_index + 40, 3625.24 + offset, border_color=color.green, bgcolor=color.new(color.green, 85), text="BUY Utama 61%", text_color=color.green, text_size=size.small)
        drawLine(3604.94, color.red, "SL BUY", true)
        drawLine(3666.97, color.blue, "TP1 BUY", true)
        drawLine(3691.15, color.blue, "TP2 BUY", true)
        box.new(bar_index - 20, 3654.51 + offset, bar_index + 40, 3645.49 + offset, border_color=color.red, bgcolor=color.new(color.red, 85), text="SELL Alternatif 41%", text_color=color.red, text_size=size.small)
        drawLine(3674.81, color.red, "SL SELL", true)
        drawLine(3621.07, color.blue, "TP1 SELL", true)
        drawLine(3600.05, color.blue, "TP2 SELL", true)

inZone0 = close >= 3625.24 + offset and close <= 3634.26 + offset
alertcondition(inZone0 and not inZone0[1], "KPX BUY Utama: masuk zona", "XAUUSD masuk zona BUY {{close}} - EA entry")
inZone1 = close >= 3645.49 + offset and close <= 3654.51 + offset
alertcondition(inZone1 and not inZone1[1], "KPX SELL Alternatif: masuk zona", "XAUUSD masuk zona SELL {{close}} - EA entry")
plot(na, "KPX")
