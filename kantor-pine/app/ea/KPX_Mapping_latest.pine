//@version=6
indicator("KPX Mapping XAUUSD 202611231607", overlay=true, max_lines_count=100, max_boxes_count=20, max_labels_count=60)
// Dibuat otomatis oleh Kantor Pine (XAUUSD) dari mapping 2026-11-23T09:07:13.334Z (harga 3613.85).
// Bukan nasihat keuangan. Konfirmasi di chart dan selalu gunakan stop loss.
offset = input.float(0.0, "Selisih harga broker - mapping (USD)", group="Umum", tooltip="Isi bila harga broker berbeda dari harga mapping")
showLevels = input.bool(true, "Tampilkan level kunci", group="Tampilan")
showPlans = input.bool(true, "Tampilkan rencana entry", group="Tampilan")

drawLine(float p, color c, string t, bool solid) =>
    line.new(bar_index - 1, p + offset, bar_index, p + offset, extend=extend.both, color=c, style=solid ? line.style_solid : line.style_dashed, width=1)
    label.new(bar_index + 3, p + offset, t + " " + str.tostring(p + offset, "#.00"), style=label.style_none, textcolor=c, size=size.small)

var bool drawn = false
if barstate.islast and not drawn
    drawn := true
    if showLevels
        drawLine(3722.10, color.red, "R Swing low H1", false)
        drawLine(3694.80, color.red, "R Swing low H1", false)
        drawLine(3650.00, color.red, "R Angka bulat", false)
        drawLine(3638.40, color.red, "R High kemarin (PDH)", false)
        drawLine(3629.90, color.red, "R Swing high H1", false)
        drawLine(3601.67, color.green, "S R1 harian", false)
        drawLine(3587.30, color.green, "S Swing high H1", false)
        drawLine(3552.43, color.gray, "P Pivot harian", false)
        drawLine(3515.20, color.green, "S Swing low H1", false)
        drawLine(3503.20, color.green, "S Low kemarin (PDL)", false)
        drawLine(3466.47, color.green, "S S1 harian", false)
    if showPlans
        box.new(bar_index - 20, 3635.70 + offset, bar_index + 40, 3624.10 + offset, border_color=color.red, bgcolor=color.new(color.red, 85), text="SELL Range 58%", text_color=color.red, text_size=size.small)
        drawLine(3661.80, color.red, "SL SELL", true)
        drawLine(3587.30, color.blue, "TP1 SELL", true)
        drawLine(3552.43, color.blue, "TP2 SELL", true)
        box.new(bar_index - 20, 3607.47 + offset, bar_index + 40, 3595.87 + offset, border_color=color.green, bgcolor=color.new(color.green, 85), text="BUY Range 44%", text_color=color.green, text_size=size.small)
        drawLine(3569.77, color.red, "SL BUY", true)
        drawLine(3638.40, color.blue, "TP1 BUY", true)
        drawLine(3694.80, color.blue, "TP2 BUY", true)

inZone0 = close >= 3624.10 + offset and close <= 3635.70 + offset
alertcondition(inZone0 and not inZone0[1], "KPX SELL Range: masuk zona", "XAUUSD masuk zona SELL {{close}} - EA entry")
inZone1 = close >= 3595.87 + offset and close <= 3607.47 + offset
alertcondition(inZone1 and not inZone1[1], "KPX BUY Range: masuk zona", "XAUUSD masuk zona BUY {{close}} - EA entry")
plot(na, "KPX")
