//@version=6
indicator("KPX Mapping XAUUSD 202611251007", overlay=true, max_lines_count=100, max_boxes_count=20, max_labels_count=60)
// Dibuat otomatis oleh Kantor Pine (XAUUSD) dari mapping 2026-11-25T03:07:13.015Z (harga 3548.15).
// Bukan nasihat keuangan. Konfirmasi di chart dan selalu gunakan stop loss.
offset = input.float(0.0, "Selisih harga broker - mapping (USD)", group="Umum", tooltip="Isi bila harga broker berbeda dari harga mapping")
showLevels = input.bool(true, "Tampilkan level kunci", group="Tampilan")
showPlans = input.bool(true, "Tampilkan rencana entry", group="Tampilan")

drawLine(float p, color c, string t, bool solid) =>
    line.new(bar_index - 1, p + offset, bar_index, p + offset, extend=extend.both, color=c, style=solid ? line.style_solid : line.style_dashed, width=1)
    label.new(bar_index + 3, p + offset, t + " " + str.tostring(p + offset, "#.00"), style=label.style_none, textcolor=c, size=size.small)

var bool drawn = false
if barstate.islast and not drawn
    drawn := true
    if showLevels
        drawLine(3691.15, color.red, "R Swing high H1", false)
        drawLine(3676.85, color.red, "R High kemarin (PDH)", false)
        drawLine(3651.55, color.red, "R Swing high H1", false)
        drawLine(3638.08, color.red, "R R1 harian", false)
        drawLine(3618.65, color.red, "R Swing low H1", false)
        drawLine(3606.55, color.red, "R Swing low H1", false)
        drawLine(3591.82, color.gray, "P Pivot harian", false)
        drawLine(3575.00, color.red, "R Angka bulat", false)
        drawLine(3566.95, color.red, "R Swing high H1", false)
        drawLine(3545.55, color.green, "S Low kemarin (PDL)", false)
        drawLine(3532.55, color.green, "S Swing low H1", false)
        drawLine(3525.00, color.green, "S Angka bulat", false)
        drawLine(3506.78, color.green, "S S1 harian", false)
    if showPlans
        box.new(bar_index - 20, 3571.07 + offset, bar_index + 40, 3562.83 + offset, border_color=color.red, bgcolor=color.new(color.red, 85), text="SELL Utama 72%", text_color=color.red, text_size=size.small)
        drawLine(3589.60, color.red, "SL SELL", true)
        drawLine(3532.55, color.blue, "TP1 SELL", true)
        drawLine(3506.78, color.blue, "TP2 SELL", true)
        box.new(bar_index - 20, 3536.67 + offset, bar_index + 40, 3528.43 + offset, border_color=color.green, bgcolor=color.new(color.green, 85), text="BUY Alternatif 22%", text_color=color.green, text_size=size.small)
        drawLine(3509.90, color.red, "SL BUY", true)
        drawLine(3566.95, color.blue, "TP1 BUY", true)
        drawLine(3591.82, color.blue, "TP2 BUY", true)

inZone0 = close >= 3562.83 + offset and close <= 3571.07 + offset
alertcondition(inZone0 and not inZone0[1], "KPX SELL Utama: masuk zona", "XAUUSD masuk zona SELL {{close}} - EA entry")
inZone1 = close >= 3528.43 + offset and close <= 3536.67 + offset
alertcondition(inZone1 and not inZone1[1], "KPX BUY Alternatif: masuk zona", "XAUUSD masuk zona BUY {{close}} - EA entry")
plot(na, "KPX")
