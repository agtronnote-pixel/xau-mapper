//@version=6
indicator("KPX Mapping DOTUSD 202611260407", overlay=true, max_lines_count=100, max_boxes_count=20, max_labels_count=60)
// Dibuat otomatis oleh Kantor Pine (DOTUSD) dari mapping 2026-11-25T21:07:29.074Z (harga 0.66300).
// Bukan nasihat keuangan. Konfirmasi di chart dan selalu gunakan stop loss.
offset = input.float(0.0, "Selisih harga broker - mapping (USD)", group="Umum", tooltip="Isi bila harga broker berbeda dari harga mapping")
showLevels = input.bool(true, "Tampilkan level kunci", group="Tampilan")
showPlans = input.bool(true, "Tampilkan rencana entry", group="Tampilan")

drawLine(float p, color c, string t, bool solid) =>
    line.new(bar_index - 1, p + offset, bar_index, p + offset, extend=extend.both, color=c, style=solid ? line.style_solid : line.style_dashed, width=1)
    label.new(bar_index + 3, p + offset, t + " " + str.tostring(p + offset, "#.00"), style=label.style_none, textcolor=c, size=size.small)

var bool drawn = false
if barstate.islast and not drawn
    drawn := true
    if showLevels
        drawLine(0.69400, color.red, "R High kemarin (PDH)", false)
        drawLine(0.68300, color.red, "R R1 harian", false)
        drawLine(0.66900, color.red, "R Swing high H1", false)
        drawLine(0.66400, color.gray, "P Pivot harian", false)
        drawLine(0.66000, color.green, "S Angka bulat", false)
        drawLine(0.65600, color.green, "S Swing high H1", false)
        drawLine(0.65000, color.green, "S Swing low H1", false)
        drawLine(0.64500, color.green, "S Low kemarin (PDL)", false)
        drawLine(0.63400, color.green, "S S1 harian", false)
        drawLine(0.61900, color.green, "S Swing low H1", false)
    if showPlans
        box.new(bar_index - 20, 0.66213 + offset, bar_index + 40, 0.65787 + offset, border_color=color.green, bgcolor=color.new(color.green, 85), text="BUY Range 54%", text_color=color.green, text_size=size.small)
        drawLine(0.64829, color.red, "SL BUY", true)
        drawLine(0.68300, color.blue, "TP1 BUY", true)
        drawLine(0.69400, color.blue, "TP2 BUY", true)
        box.new(bar_index - 20, 0.67113 + offset, bar_index + 40, 0.66687 + offset, border_color=color.red, bgcolor=color.new(color.red, 85), text="SELL Range 48%", text_color=color.red, text_size=size.small)
        drawLine(0.68071, color.red, "SL SELL", true)
        drawLine(0.65600, color.blue, "TP1 SELL", true)
        drawLine(0.65000, color.blue, "TP2 SELL", true)

inZone0 = close >= 0.65787 + offset and close <= 0.66213 + offset
alertcondition(inZone0 and not inZone0[1], "KPX BUY Range: masuk zona", "DOTUSD masuk zona BUY {{close}} - EA entry")
inZone1 = close >= 0.66687 + offset and close <= 0.67113 + offset
alertcondition(inZone1 and not inZone1[1], "KPX SELL Range: masuk zona", "DOTUSD masuk zona SELL {{close}} - EA entry")
plot(na, "KPX")
