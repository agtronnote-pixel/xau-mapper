//@version=6
indicator("KPX Mapping SNP500 202611230607", overlay=true, max_lines_count=100, max_boxes_count=20, max_labels_count=60)
// Dibuat otomatis oleh Kantor Pine (SNP500) dari mapping 2026-11-22T23:07:29.144Z (harga 6935.00).
// Bukan nasihat keuangan. Konfirmasi di chart dan selalu gunakan stop loss.
offset = input.float(0.0, "Selisih harga broker - mapping (USD)", group="Umum", tooltip="Isi bila harga broker berbeda dari harga mapping")
showLevels = input.bool(true, "Tampilkan level kunci", group="Tampilan")
showPlans = input.bool(true, "Tampilkan rencana entry", group="Tampilan")

drawLine(float p, color c, string t, bool solid) =>
    line.new(bar_index - 1, p + offset, bar_index, p + offset, extend=extend.both, color=c, style=solid ? line.style_solid : line.style_dashed, width=1)
    label.new(bar_index + 3, p + offset, t + " " + str.tostring(p + offset, "#.00"), style=label.style_none, textcolor=c, size=size.small)

var bool drawn = false
if barstate.islast and not drawn
    drawn := true
    if showLevels
        drawLine(7216.75, color.red, "R High kemarin (PDH)", false)
        drawLine(7183.25, color.red, "R Swing high H1", false)
        drawLine(7167.75, color.red, "R Swing low H1", false)
        drawLine(7135.17, color.red, "R R1 harian", false)
        drawLine(7016.58, color.gray, "P Pivot harian", false)
        drawLine(6950.00, color.red, "R Angka bulat", false)
        drawLine(6925.00, color.green, "S Angka bulat", false)
        drawLine(6898.00, color.green, "S Low kemarin (PDL)", false)
        drawLine(6816.42, color.green, "S S1 harian", false)

plot(na, "KPX")
