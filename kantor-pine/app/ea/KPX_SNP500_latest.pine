//@version=6
indicator("KPX Mapping SNP500 202611231507", overlay=true, max_lines_count=100, max_boxes_count=20, max_labels_count=60)
// Dibuat otomatis oleh Kantor Pine (SNP500) dari mapping 2026-11-23T08:07:38.983Z (harga 7087.50).
// Bukan nasihat keuangan. Konfirmasi di chart dan selalu gunakan stop loss.
offset = input.float(0.0, "Selisih harga broker - mapping (USD)", group="Umum", tooltip="Isi bila harga broker berbeda dari harga mapping")
showLevels = input.bool(true, "Tampilkan level kunci", group="Tampilan")
showPlans = input.bool(true, "Tampilkan rencana entry", group="Tampilan")

drawLine(float p, color c, string t, bool solid) =>
    line.new(bar_index - 1, p + offset, bar_index, p + offset, extend=extend.both, color=c, style=solid ? line.style_solid : line.style_dashed, width=1)
    label.new(bar_index + 3, p + offset, t + " " + str.tostring(p + offset, "#.00"), style=label.style_none, textcolor=c, size=size.small)

var bool drawn = false
if barstate.islast and not drawn
    drawn := true
    if showLevels
        drawLine(7216.75, color.red, "R High kemarin (PDH)", false)
        drawLine(7183.25, color.red, "R Swing high H1", false)
        drawLine(7167.75, color.red, "R Swing low H1", false)
        drawLine(7135.17, color.red, "R R1 harian", false)
        drawLine(7104.25, color.red, "R Swing high H1", false)
        drawLine(7075.00, color.green, "S Angka bulat", false)
        drawLine(7052.50, color.green, "S Swing low H1", false)
        drawLine(7016.58, color.gray, "P Pivot harian", false)
        drawLine(6898.00, color.green, "S Low kemarin (PDL)", false)
        drawLine(6816.42, color.green, "S S1 harian", false)
    if showPlans
        box.new(bar_index - 20, 7113.74 + offset, bar_index + 40, 7094.76 + offset, border_color=color.red, bgcolor=color.new(color.red, 85), text="SELL Utama 66%", text_color=color.red, text_size=size.small)
        drawLine(7156.46, color.red, "SL SELL", true)
        drawLine(7016.58, color.blue, "TP1 SELL", true)
        drawLine(6898.00, color.blue, "TP2 SELL", true)
        box.new(bar_index - 20, 7084.49 + offset, bar_index + 40, 7065.51 + offset, border_color=color.green, bgcolor=color.new(color.green, 85), text="BUY Alternatif 36%", text_color=color.green, text_size=size.small)
        drawLine(7022.79, color.red, "SL BUY", true)
        drawLine(7135.17, color.blue, "TP1 BUY", true)
        drawLine(7167.75, color.blue, "TP2 BUY", true)

inZone0 = close >= 7094.76 + offset and close <= 7113.74 + offset
alertcondition(inZone0 and not inZone0[1], "KPX SELL Utama: masuk zona", "SNP500 masuk zona SELL {{close}} - EA entry")
inZone1 = close >= 7065.51 + offset and close <= 7084.49 + offset
alertcondition(inZone1 and not inZone1[1], "KPX BUY Alternatif: masuk zona", "SNP500 masuk zona BUY {{close}} - EA entry")
plot(na, "KPX")
