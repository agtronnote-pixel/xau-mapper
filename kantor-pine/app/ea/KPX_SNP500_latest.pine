//@version=6
indicator("KPX Mapping SNP500 202611280107", overlay=true, max_lines_count=100, max_boxes_count=20, max_labels_count=60)
// Dibuat otomatis oleh Kantor Pine (SNP500) dari mapping 2026-11-27T18:07:31.876Z (harga 7258.00).
// Bukan nasihat keuangan. Konfirmasi di chart dan selalu gunakan stop loss.
offset = input.float(0.0, "Selisih harga broker - mapping (USD)", group="Umum", tooltip="Isi bila harga broker berbeda dari harga mapping")
showLevels = input.bool(true, "Tampilkan level kunci", group="Tampilan")
showPlans = input.bool(true, "Tampilkan rencana entry", group="Tampilan")

drawLine(float p, color c, string t, bool solid) =>
    line.new(bar_index - 1, p + offset, bar_index, p + offset, extend=extend.both, color=c, style=solid ? line.style_solid : line.style_dashed, width=1)
    label.new(bar_index + 3, p + offset, t + " " + str.tostring(p + offset, "#.00"), style=label.style_none, textcolor=c, size=size.small)

var bool drawn = false
if barstate.islast and not drawn
    drawn := true
    if showLevels
        drawLine(7280.17, color.red, "R R1 harian", false)
        drawLine(7250.25, color.green, "S Swing high H1", false)
        drawLine(7240.75, color.green, "S Swing high H1", false)
        drawLine(7224.00, color.green, "S High kemarin (PDH)", false)
        drawLine(7182.75, color.green, "S Swing low H1", false)
        drawLine(7172.00, color.green, "S Swing high H1", false)
        drawLine(7144.75, color.green, "S Swing low H1", false)
        drawLine(7131.33, color.gray, "P Pivot harian", false)
        drawLine(7038.67, color.green, "S S1 harian", false)
        drawLine(6982.50, color.green, "S Low kemarin (PDL)", false)
    if showPlans
        box.new(bar_index - 20, 7256.31 + offset, bar_index + 40, 7244.19 + offset, border_color=color.green, bgcolor=color.new(color.green, 85), text="BUY Utama 87%", text_color=color.green, text_size=size.small)
        drawLine(7216.90, color.red, "SL BUY", true)
        drawLine(7300.28, color.blue, "TP1 BUY", true)
        drawLine(7350.30, color.blue, "TP2 BUY", true)
        box.new(bar_index - 20, 7286.23 + offset, bar_index + 40, 7274.11 + offset, border_color=color.red, bgcolor=color.new(color.red, 85), text="SELL Alternatif 14%", text_color=color.red, text_size=size.small)
        drawLine(7313.52, color.red, "SL SELL", true)
        drawLine(7240.75, color.blue, "TP1 SELL", true)
        drawLine(7224.00, color.blue, "TP2 SELL", true)

inZone0 = close >= 7244.19 + offset and close <= 7256.31 + offset
alertcondition(inZone0 and not inZone0[1], "KPX BUY Utama: masuk zona", "SNP500 masuk zona BUY {{close}} - EA entry")
inZone1 = close >= 7274.11 + offset and close <= 7286.23 + offset
alertcondition(inZone1 and not inZone1[1], "KPX SELL Alternatif: masuk zona", "SNP500 masuk zona SELL {{close}} - EA entry")
plot(na, "KPX")
