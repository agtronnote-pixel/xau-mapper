//@version=6
indicator("KPX Mapping SNP500 202611231907", overlay=true, max_lines_count=100, max_boxes_count=20, max_labels_count=60)
// Dibuat otomatis oleh Kantor Pine (SNP500) dari mapping 2026-11-23T12:07:28.477Z (harga 7087.50).
// Bukan nasihat keuangan. Konfirmasi di chart dan selalu gunakan stop loss.
offset = input.float(0.0, "Selisih harga broker - mapping (USD)", group="Umum", tooltip="Isi bila harga broker berbeda dari harga mapping")
showLevels = input.bool(true, "Tampilkan level kunci", group="Tampilan")
showPlans = input.bool(true, "Tampilkan rencana entry", group="Tampilan")

drawLine(float p, color c, string t, bool solid) =>
    line.new(bar_index - 1, p + offset, bar_index, p + offset, extend=extend.both, color=c, style=solid ? line.style_solid : line.style_dashed, width=1)
    label.new(bar_index + 3, p + offset, t + " " + str.tostring(p + offset, "#.00"), style=label.style_none, textcolor=c, size=size.small)

var bool drawn = false
if barstate.islast and not drawn
    drawn := true
    if showLevels
        drawLine(7216.75, color.red, "R High kemarin (PDH)", false)
        drawLine(7183.25, color.red, "R Swing high H1", false)
        drawLine(7135.17, color.red, "R R1 harian", false)
        drawLine(7125.00, color.red, "R Angka bulat", false)
        drawLine(7104.25, color.red, "R Swing high H1", false)
        drawLine(7071.00, color.green, "S Swing low H1", false)
        drawLine(7052.50, color.green, "S Swing low H1", false)
        drawLine(7016.58, color.gray, "P Pivot harian", false)
        drawLine(6898.00, color.green, "S Low kemarin (PDL)", false)
        drawLine(6816.42, color.green, "S S1 harian", false)
    if showPlans
        box.new(bar_index - 20, 7111.13 + offset, bar_index + 40, 7097.37 + offset, border_color=color.red, bgcolor=color.new(color.red, 85), text="SELL Range 52%", text_color=color.red, text_size=size.small)
        drawLine(7142.10, color.red, "SL SELL", true)
        drawLine(7052.50, color.blue, "TP1 SELL", true)
        drawLine(7016.58, color.blue, "TP2 SELL", true)
        box.new(bar_index - 20, 7077.88 + offset, bar_index + 40, 7064.12 + offset, border_color=color.green, bgcolor=color.new(color.green, 85), text="BUY Range 50%", text_color=color.green, text_size=size.small)
        drawLine(7033.15, color.red, "SL BUY", true)
        drawLine(7125.00, color.blue, "TP1 BUY", true)
        drawLine(7183.25, color.blue, "TP2 BUY", true)

inZone0 = close >= 7097.37 + offset and close <= 7111.13 + offset
alertcondition(inZone0 and not inZone0[1], "KPX SELL Range: masuk zona", "SNP500 masuk zona SELL {{close}} - EA entry")
inZone1 = close >= 7064.12 + offset and close <= 7077.88 + offset
alertcondition(inZone1 and not inZone1[1], "KPX BUY Range: masuk zona", "SNP500 masuk zona BUY {{close}} - EA entry")
plot(na, "KPX")
