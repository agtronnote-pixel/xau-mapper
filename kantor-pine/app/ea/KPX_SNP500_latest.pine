//@version=6
indicator("KPX Mapping SNP500 202611261407", overlay=true, max_lines_count=100, max_boxes_count=20, max_labels_count=60)
// Dibuat otomatis oleh Kantor Pine (SNP500) dari mapping 2026-11-26T07:07:30.461Z (harga 7216.75).
// Bukan nasihat keuangan. Konfirmasi di chart dan selalu gunakan stop loss.
offset = input.float(0.0, "Selisih harga broker - mapping (USD)", group="Umum", tooltip="Isi bila harga broker berbeda dari harga mapping")
showLevels = input.bool(true, "Tampilkan level kunci", group="Tampilan")
showPlans = input.bool(true, "Tampilkan rencana entry", group="Tampilan")

drawLine(float p, color c, string t, bool solid) =>
    line.new(bar_index - 1, p + offset, bar_index, p + offset, extend=extend.both, color=c, style=solid ? line.style_solid : line.style_dashed, width=1)
    label.new(bar_index + 3, p + offset, t + " " + str.tostring(p + offset, "#.00"), style=label.style_none, textcolor=c, size=size.small)

var bool drawn = false
if barstate.islast and not drawn
    drawn := true
    if showLevels
        drawLine(7280.17, color.red, "R R1 harian", false)
        drawLine(7240.75, color.red, "R Swing high H1", false)
        drawLine(7224.00, color.red, "R High kemarin (PDH)", false)
        drawLine(7200.00, color.green, "S Angka bulat", false)
        drawLine(7172.00, color.green, "S Swing high H1", false)
        drawLine(7144.75, color.green, "S Swing low H1", false)
        drawLine(7131.33, color.gray, "P Pivot harian", false)
        drawLine(7038.67, color.green, "S S1 harian", false)
        drawLine(6982.50, color.green, "S Low kemarin (PDL)", false)
    if showPlans
        box.new(bar_index - 20, 7209.47 + offset, bar_index + 40, 7190.53 + offset, border_color=color.green, bgcolor=color.new(color.green, 85), text="BUY Utama 58%", text_color=color.green, text_size=size.small)
        drawLine(7147.91, color.red, "SL BUY", true)
        drawLine(7280.17, color.blue, "TP1 BUY", true)
        drawLine(7356.27, color.blue, "TP2 BUY", true)
        box.new(bar_index - 20, 7250.22 + offset, bar_index + 40, 7231.28 + offset, border_color=color.red, bgcolor=color.new(color.red, 85), text="SELL Alternatif 23%", text_color=color.red, text_size=size.small)
        drawLine(7292.84, color.red, "SL SELL", true)
        drawLine(7172.00, color.blue, "TP1 SELL", true)
        drawLine(7144.75, color.blue, "TP2 SELL", true)

inZone0 = close >= 7190.53 + offset and close <= 7209.47 + offset
alertcondition(inZone0 and not inZone0[1], "KPX BUY Utama: masuk zona", "SNP500 masuk zona BUY {{close}} - EA entry")
inZone1 = close >= 7231.28 + offset and close <= 7250.22 + offset
alertcondition(inZone1 and not inZone1[1], "KPX SELL Alternatif: masuk zona", "SNP500 masuk zona SELL {{close}} - EA entry")
plot(na, "KPX")
