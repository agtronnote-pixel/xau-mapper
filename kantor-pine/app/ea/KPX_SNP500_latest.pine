//@version=6
indicator("KPX Mapping SNP500 202611242307", overlay=true, max_lines_count=100, max_boxes_count=20, max_labels_count=60)
// Dibuat otomatis oleh Kantor Pine (SNP500) dari mapping 2026-11-24T16:07:33.146Z (harga 7274.50).
// Bukan nasihat keuangan. Konfirmasi di chart dan selalu gunakan stop loss.
offset = input.float(0.0, "Selisih harga broker - mapping (USD)", group="Umum", tooltip="Isi bila harga broker berbeda dari harga mapping")
showLevels = input.bool(true, "Tampilkan level kunci", group="Tampilan")
showPlans = input.bool(true, "Tampilkan rencana entry", group="Tampilan")

drawLine(float p, color c, string t, bool solid) =>
    line.new(bar_index - 1, p + offset, bar_index, p + offset, extend=extend.both, color=c, style=solid ? line.style_solid : line.style_dashed, width=1)
    label.new(bar_index + 3, p + offset, t + " " + str.tostring(p + offset, "#.00"), style=label.style_none, textcolor=c, size=size.small)

var bool drawn = false
if barstate.islast and not drawn
    drawn := true
    if showLevels
        drawLine(7391.83, color.red, "R R1 harian", false)
        drawLine(7313.25, color.red, "R High kemarin (PDH)", false)
        drawLine(7298.25, color.red, "R Swing high H1", false)
        drawLine(7284.25, color.red, "R Swing high H1", false)
        drawLine(7275.00, color.red, "R Angka bulat", false)
        drawLine(7250.00, color.green, "S Angka bulat", false)
        drawLine(7239.50, color.green, "S Swing low H1", false)
        drawLine(7191.92, color.gray, "P Pivot harian", false)
        drawLine(7144.75, color.green, "S Swing low H1", false)
        drawLine(7082.50, color.green, "S Swing low H1", false)
        drawLine(7070.58, color.green, "S S1 harian", false)
        drawLine(6992.00, color.green, "S Low kemarin (PDL)", false)
    if showPlans
        box.new(bar_index - 20, 7291.39 + offset, bar_index + 40, 7277.11 + offset, border_color=color.red, bgcolor=color.new(color.red, 85), text="SELL Utama 50%", text_color=color.red, text_size=size.small)
        drawLine(7323.50, color.red, "SL SELL", true)
        drawLine(7239.50, color.blue, "TP1 SELL", true)
        drawLine(7191.92, color.blue, "TP2 SELL", true)
        box.new(bar_index - 20, 7257.14 + offset, bar_index + 40, 7242.86 + offset, border_color=color.green, bgcolor=color.new(color.green, 85), text="BUY Alternatif 26%", text_color=color.green, text_size=size.small)
        drawLine(7210.75, color.red, "SL BUY", true)
        drawLine(7298.25, color.blue, "TP1 BUY", true)
        drawLine(7391.83, color.blue, "TP2 BUY", true)

inZone0 = close >= 7277.11 + offset and close <= 7291.39 + offset
alertcondition(inZone0 and not inZone0[1], "KPX SELL Utama: masuk zona", "SNP500 masuk zona SELL {{close}} - EA entry")
inZone1 = close >= 7242.86 + offset and close <= 7257.14 + offset
alertcondition(inZone1 and not inZone1[1], "KPX BUY Alternatif: masuk zona", "SNP500 masuk zona BUY {{close}} - EA entry")
plot(na, "KPX")
