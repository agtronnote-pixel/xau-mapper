//@version=6
indicator("KPX Mapping SNP500 202611250707", overlay=true, max_lines_count=100, max_boxes_count=20, max_labels_count=60)
// Dibuat otomatis oleh Kantor Pine (SNP500) dari mapping 2026-11-25T00:07:47.425Z (harga 7274.50).
// Bukan nasihat keuangan. Konfirmasi di chart dan selalu gunakan stop loss.
offset = input.float(0.0, "Selisih harga broker - mapping (USD)", group="Umum", tooltip="Isi bila harga broker berbeda dari harga mapping")
showLevels = input.bool(true, "Tampilkan level kunci", group="Tampilan")
showPlans = input.bool(true, "Tampilkan rencana entry", group="Tampilan")

drawLine(float p, color c, string t, bool solid) =>
    line.new(bar_index - 1, p + offset, bar_index, p + offset, extend=extend.both, color=c, style=solid ? line.style_solid : line.style_dashed, width=1)
    label.new(bar_index + 3, p + offset, t + " " + str.tostring(p + offset, "#.00"), style=label.style_none, textcolor=c, size=size.small)

var bool drawn = false
if barstate.islast and not drawn
    drawn := true
    if showLevels
        drawLine(7298.25, color.red, "R High kemarin (PDH)", false)
        drawLine(7284.25, color.red, "R Swing high H1", false)
        drawLine(7240.75, color.green, "S Swing high H1", false)
        drawLine(7217.92, color.gray, "P Pivot harian", false)
        drawLine(7182.75, color.green, "S Swing low H1", false)
        drawLine(7144.75, color.green, "S Low kemarin (PDL)", false)
    if showPlans
        box.new(bar_index - 20, 7249.49 + offset, bar_index + 40, 7232.01 + offset, border_color=color.green, bgcolor=color.new(color.green, 85), text="BUY Range 45%", text_color=color.green, text_size=size.small)
        drawLine(7192.67, color.red, "SL BUY", true)
        drawLine(7298.25, color.blue, "TP1 BUY", true)
        drawLine(7384.99, color.blue, "TP2 BUY", true)
        box.new(bar_index - 20, 7292.99 + offset, bar_index + 40, 7275.51 + offset, border_color=color.red, bgcolor=color.new(color.red, 85), text="SELL Range 45%", text_color=color.red, text_size=size.small)
        drawLine(7332.33, color.red, "SL SELL", true)
        drawLine(7217.92, color.blue, "TP1 SELL", true)
        drawLine(7182.75, color.blue, "TP2 SELL", true)

inZone0 = close >= 7232.01 + offset and close <= 7249.49 + offset
alertcondition(inZone0 and not inZone0[1], "KPX BUY Range: masuk zona", "SNP500 masuk zona BUY {{close}} - EA entry")
inZone1 = close >= 7275.51 + offset and close <= 7292.99 + offset
alertcondition(inZone1 and not inZone1[1], "KPX SELL Range: masuk zona", "SNP500 masuk zona SELL {{close}} - EA entry")
plot(na, "KPX")
