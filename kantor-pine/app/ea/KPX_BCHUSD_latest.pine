//@version=6
indicator("KPX Mapping BCHUSD 202611241609", overlay=true, max_lines_count=100, max_boxes_count=20, max_labels_count=60)
// Dibuat otomatis oleh Kantor Pine (BCHUSD) dari mapping 2026-11-24T09:09:57.406Z (harga 199.30).
// Bukan nasihat keuangan. Konfirmasi di chart dan selalu gunakan stop loss.
offset = input.float(0.0, "Selisih harga broker - mapping (USD)", group="Umum", tooltip="Isi bila harga broker berbeda dari harga mapping")
showLevels = input.bool(true, "Tampilkan level kunci", group="Tampilan")
showPlans = input.bool(true, "Tampilkan rencana entry", group="Tampilan")

drawLine(float p, color c, string t, bool solid) =>
    line.new(bar_index - 1, p + offset, bar_index, p + offset, extend=extend.both, color=c, style=solid ? line.style_solid : line.style_dashed, width=1)
    label.new(bar_index + 3, p + offset, t + " " + str.tostring(p + offset, "#.00"), style=label.style_none, textcolor=c, size=size.small)

var bool drawn = false
if barstate.islast and not drawn
    drawn := true
    if showLevels
        drawLine(213.00, color.red, "R High kemarin (PDH)", false)
        drawLine(211.03, color.red, "R R1 harian", false)
        drawLine(204.30, color.red, "R Swing high H1", false)
        drawLine(202.47, color.gray, "P Pivot harian", false)
        drawLine(201.10, color.red, "R Swing high H1", false)
        drawLine(200.00, color.red, "R Angka bulat", false)
        drawLine(198.40, color.green, "S Swing low H1", false)
        drawLine(197.10, color.green, "S Swing low H1", false)
        drawLine(193.90, color.green, "S Low kemarin (PDL)", false)
        drawLine(191.93, color.green, "S S1 harian", false)
    if showPlans
        box.new(bar_index - 20, 200.49 + offset, bar_index + 40, 199.51 + offset, border_color=color.red, bgcolor=color.new(color.red, 85), text="SELL Utama 69%", text_color=color.red, text_size=size.small)
        drawLine(202.70, color.red, "SL SELL", true)
        drawLine(197.10, color.blue, "TP1 SELL", true)
        drawLine(193.90, color.blue, "TP2 SELL", true)
        box.new(bar_index - 20, 198.89 + offset, bar_index + 40, 197.91 + offset, border_color=color.green, bgcolor=color.new(color.green, 85), text="BUY Alternatif 29%", text_color=color.green, text_size=size.small)
        drawLine(195.70, color.red, "SL BUY", true)
        drawLine(201.10, color.blue, "TP1 BUY", true)
        drawLine(202.47, color.blue, "TP2 BUY", true)

inZone0 = close >= 199.51 + offset and close <= 200.49 + offset
alertcondition(inZone0 and not inZone0[1], "KPX SELL Utama: masuk zona", "BCHUSD masuk zona SELL {{close}} - EA entry")
inZone1 = close >= 197.91 + offset and close <= 198.89 + offset
alertcondition(inZone1 and not inZone1[1], "KPX BUY Alternatif: masuk zona", "BCHUSD masuk zona BUY {{close}} - EA entry")
plot(na, "KPX")
