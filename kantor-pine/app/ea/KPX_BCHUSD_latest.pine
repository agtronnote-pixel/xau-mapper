//@version=6
indicator("KPX Mapping BCHUSD 202611280607", overlay=true, max_lines_count=100, max_boxes_count=20, max_labels_count=60)
// Dibuat otomatis oleh Kantor Pine (BCHUSD) dari mapping 2026-11-27T23:07:25.016Z (harga 206.50).
// Bukan nasihat keuangan. Konfirmasi di chart dan selalu gunakan stop loss.
offset = input.float(0.0, "Selisih harga broker - mapping (USD)", group="Umum", tooltip="Isi bila harga broker berbeda dari harga mapping")
showLevels = input.bool(true, "Tampilkan level kunci", group="Tampilan")
showPlans = input.bool(true, "Tampilkan rencana entry", group="Tampilan")

drawLine(float p, color c, string t, bool solid) =>
    line.new(bar_index - 1, p + offset, bar_index, p + offset, extend=extend.both, color=c, style=solid ? line.style_solid : line.style_dashed, width=1)
    label.new(bar_index + 3, p + offset, t + " " + str.tostring(p + offset, "#.00"), style=label.style_none, textcolor=c, size=size.small)

var bool drawn = false
if barstate.islast and not drawn
    drawn := true
    if showLevels
        drawLine(220.00, color.red, "R Swing high H1", false)
        drawLine(213.00, color.red, "R R1 harian", false)
        drawLine(211.60, color.red, "R High kemarin (PDH)", false)
        drawLine(209.50, color.red, "R Swing high H1", false)
        drawLine(208.60, color.gray, "P Pivot harian", false)
        drawLine(207.50, color.red, "R Swing high H1", false)
        drawLine(206.20, color.green, "S Swing low H1", false)
        drawLine(205.60, color.green, "S S1 harian", false)
        drawLine(204.20, color.green, "S Low kemarin (PDL)", false)
        drawLine(201.80, color.green, "S Swing low H1", false)
    if showPlans
        box.new(bar_index - 20, 207.95 + offset, bar_index + 40, 207.05 + offset, border_color=color.red, bgcolor=color.new(color.red, 85), text="SELL Utama 66%", text_color=color.red, text_size=size.small)
        drawLine(209.96, color.red, "SL SELL", true)
        drawLine(204.20, color.blue, "TP1 SELL", true)
        drawLine(201.80, color.blue, "TP2 SELL", true)
        box.new(bar_index - 20, 206.05 + offset, bar_index + 40, 205.15 + offset, border_color=color.green, bgcolor=color.new(color.green, 85), text="BUY Alternatif 35%", text_color=color.green, text_size=size.small)
        drawLine(203.14, color.red, "SL BUY", true)
        drawLine(208.60, color.blue, "TP1 BUY", true)
        drawLine(211.60, color.blue, "TP2 BUY", true)

inZone0 = close >= 207.05 + offset and close <= 207.95 + offset
alertcondition(inZone0 and not inZone0[1], "KPX SELL Utama: masuk zona", "BCHUSD masuk zona SELL {{close}} - EA entry")
inZone1 = close >= 205.15 + offset and close <= 206.05 + offset
alertcondition(inZone1 and not inZone1[1], "KPX BUY Alternatif: masuk zona", "BCHUSD masuk zona BUY {{close}} - EA entry")
plot(na, "KPX")
