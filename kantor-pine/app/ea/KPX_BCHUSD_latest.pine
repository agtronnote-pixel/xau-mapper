//@version=6
indicator("KPX Mapping BCHUSD 202611271607", overlay=true, max_lines_count=100, max_boxes_count=20, max_labels_count=60)
// Dibuat otomatis oleh Kantor Pine (BCHUSD) dari mapping 2026-11-27T09:07:33.607Z (harga 212.30).
// Bukan nasihat keuangan. Konfirmasi di chart dan selalu gunakan stop loss.
offset = input.float(0.0, "Selisih harga broker - mapping (USD)", group="Umum", tooltip="Isi bila harga broker berbeda dari harga mapping")
showLevels = input.bool(true, "Tampilkan level kunci", group="Tampilan")
showPlans = input.bool(true, "Tampilkan rencana entry", group="Tampilan")

drawLine(float p, color c, string t, bool solid) =>
    line.new(bar_index - 1, p + offset, bar_index, p + offset, extend=extend.both, color=c, style=solid ? line.style_solid : line.style_dashed, width=1)
    label.new(bar_index + 3, p + offset, t + " " + str.tostring(p + offset, "#.00"), style=label.style_none, textcolor=c, size=size.small)

var bool drawn = false
if barstate.islast and not drawn
    drawn := true
    if showLevels
        drawLine(220.00, color.red, "R Swing high H1", false)
        drawLine(214.00, color.red, "R Angka bulat", false)
        drawLine(212.87, color.red, "R R1 harian", false)
        drawLine(211.60, color.green, "S High kemarin (PDH)", false)
        drawLine(210.00, color.green, "S Swing high H1", false)
        drawLine(209.30, color.green, "S Swing low H1", false)
        drawLine(208.53, color.gray, "P Pivot harian", false)
        drawLine(206.20, color.green, "S Swing low H1", false)
        drawLine(205.47, color.green, "S S1 harian", false)
        drawLine(204.20, color.green, "S Low kemarin (PDL)", false)
        drawLine(203.20, color.green, "S Swing low H1", false)
    if showPlans
        box.new(bar_index - 20, 212.06 + offset, bar_index + 40, 211.14 + offset, border_color=color.green, bgcolor=color.new(color.green, 85), text="BUY Utama 68%", text_color=color.green, text_size=size.small)
        drawLine(209.08, color.red, "SL BUY", true)
        drawLine(215.38, color.blue, "TP1 BUY", true)
        drawLine(220.00, color.blue, "TP2 BUY", true)
        box.new(bar_index - 20, 213.33 + offset, bar_index + 40, 212.41 + offset, border_color=color.red, bgcolor=color.new(color.red, 85), text="SELL Alternatif 33%", text_color=color.red, text_size=size.small)
        drawLine(215.39, color.red, "SL SELL", true)
        drawLine(210.00, color.blue, "TP1 SELL", true)
        drawLine(208.53, color.blue, "TP2 SELL", true)

inZone0 = close >= 211.14 + offset and close <= 212.06 + offset
alertcondition(inZone0 and not inZone0[1], "KPX BUY Utama: masuk zona", "BCHUSD masuk zona BUY {{close}} - EA entry")
inZone1 = close >= 212.41 + offset and close <= 213.33 + offset
alertcondition(inZone1 and not inZone1[1], "KPX SELL Alternatif: masuk zona", "BCHUSD masuk zona SELL {{close}} - EA entry")
plot(na, "KPX")
