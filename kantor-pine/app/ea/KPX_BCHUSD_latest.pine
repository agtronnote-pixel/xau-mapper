//@version=6
indicator("KPX Mapping BCHUSD 202611232107", overlay=true, max_lines_count=100, max_boxes_count=20, max_labels_count=60)
// Dibuat otomatis oleh Kantor Pine (BCHUSD) dari mapping 2026-11-23T14:07:25.203Z (harga 206.70).
// Bukan nasihat keuangan. Konfirmasi di chart dan selalu gunakan stop loss.
offset = input.float(0.0, "Selisih harga broker - mapping (USD)", group="Umum", tooltip="Isi bila harga broker berbeda dari harga mapping")
showLevels = input.bool(true, "Tampilkan level kunci", group="Tampilan")
showPlans = input.bool(true, "Tampilkan rencana entry", group="Tampilan")

drawLine(float p, color c, string t, bool solid) =>
    line.new(bar_index - 1, p + offset, bar_index, p + offset, extend=extend.both, color=c, style=solid ? line.style_solid : line.style_dashed, width=1)
    label.new(bar_index + 3, p + offset, t + " " + str.tostring(p + offset, "#.00"), style=label.style_none, textcolor=c, size=size.small)

var bool drawn = false
if barstate.islast and not drawn
    drawn := true
    if showLevels
        drawLine(208.00, color.red, "R Angka bulat", false)
        drawLine(206.00, color.green, "S Angka bulat", false)
        drawLine(204.00, color.green, "S Angka bulat", false)
        drawLine(202.00, color.green, "S R1 harian", false)
        drawLine(200.50, color.green, "S High kemarin (PDH)", false)
        drawLine(199.70, color.green, "S Swing high H1", false)
        drawLine(198.10, color.gray, "P Pivot harian", false)
        drawLine(196.80, color.green, "S Swing low H1", false)
        drawLine(195.70, color.green, "S S1 harian", false)
        drawLine(194.20, color.green, "S Low kemarin (PDL)", false)
    if showPlans
        box.new(bar_index - 20, 206.51 + offset, bar_index + 40, 205.49 + offset, border_color=color.green, bgcolor=color.new(color.green, 85), text="BUY Utama 79%", text_color=color.green, text_size=size.small)
        drawLine(203.18, color.red, "SL BUY", true)
        drawLine(210.23, color.blue, "TP1 BUY", true)
        drawLine(214.46, color.blue, "TP2 BUY", true)
        box.new(bar_index - 20, 208.51 + offset, bar_index + 40, 207.49 + offset, border_color=color.red, bgcolor=color.new(color.red, 85), text="SELL Alternatif 24%", text_color=color.red, text_size=size.small)
        drawLine(210.82, color.red, "SL SELL", true)
        drawLine(204.00, color.blue, "TP1 SELL", true)
        drawLine(202.00, color.blue, "TP2 SELL", true)

inZone0 = close >= 205.49 + offset and close <= 206.51 + offset
alertcondition(inZone0 and not inZone0[1], "KPX BUY Utama: masuk zona", "BCHUSD masuk zona BUY {{close}} - EA entry")
inZone1 = close >= 207.49 + offset and close <= 208.51 + offset
alertcondition(inZone1 and not inZone1[1], "KPX SELL Alternatif: masuk zona", "BCHUSD masuk zona SELL {{close}} - EA entry")
plot(na, "KPX")
