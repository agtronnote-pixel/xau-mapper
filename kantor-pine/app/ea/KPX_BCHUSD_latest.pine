//@version=6
indicator("KPX Mapping BCHUSD 202611231707", overlay=true, max_lines_count=100, max_boxes_count=20, max_labels_count=60)
// Dibuat otomatis oleh Kantor Pine (BCHUSD) dari mapping 2026-11-23T10:07:34.328Z (harga 200.10).
// Bukan nasihat keuangan. Konfirmasi di chart dan selalu gunakan stop loss.
offset = input.float(0.0, "Selisih harga broker - mapping (USD)", group="Umum", tooltip="Isi bila harga broker berbeda dari harga mapping")
showLevels = input.bool(true, "Tampilkan level kunci", group="Tampilan")
showPlans = input.bool(true, "Tampilkan rencana entry", group="Tampilan")

drawLine(float p, color c, string t, bool solid) =>
    line.new(bar_index - 1, p + offset, bar_index, p + offset, extend=extend.both, color=c, style=solid ? line.style_solid : line.style_dashed, width=1)
    label.new(bar_index + 3, p + offset, t + " " + str.tostring(p + offset, "#.00"), style=label.style_none, textcolor=c, size=size.small)

var bool drawn = false
if barstate.islast and not drawn
    drawn := true
    if showLevels
        drawLine(201.87, color.red, "R R1 harian", false)
        drawLine(200.50, color.red, "R High kemarin (PDH)", false)
        drawLine(199.70, color.green, "S Swing high H1", false)
        drawLine(198.03, color.gray, "P Pivot harian", false)
        drawLine(197.40, color.green, "S Swing low H1", false)
        drawLine(196.80, color.green, "S Swing low H1", false)
        drawLine(195.57, color.green, "S S1 harian", false)
        drawLine(194.20, color.green, "S Low kemarin (PDL)", false)
    if showPlans
        box.new(bar_index - 20, 200.06 + offset, bar_index + 40, 199.34 + offset, border_color=color.green, bgcolor=color.new(color.green, 85), text="BUY Range 53%", text_color=color.green, text_size=size.small)
        drawLine(197.70, color.red, "SL BUY", true)
        drawLine(201.87, color.blue, "TP1 BUY", true)
        drawLine(205.70, color.blue, "TP2 BUY", true)
        box.new(bar_index - 20, 200.86 + offset, bar_index + 40, 200.14 + offset, border_color=color.red, bgcolor=color.new(color.red, 85), text="SELL Range 47%", text_color=color.red, text_size=size.small)
        drawLine(202.50, color.red, "SL SELL", true)
        drawLine(198.03, color.blue, "TP1 SELL", true)
        drawLine(196.80, color.blue, "TP2 SELL", true)

inZone0 = close >= 199.34 + offset and close <= 200.06 + offset
alertcondition(inZone0 and not inZone0[1], "KPX BUY Range: masuk zona", "BCHUSD masuk zona BUY {{close}} - EA entry")
inZone1 = close >= 200.14 + offset and close <= 200.86 + offset
alertcondition(inZone1 and not inZone1[1], "KPX SELL Range: masuk zona", "BCHUSD masuk zona SELL {{close}} - EA entry")
plot(na, "KPX")
