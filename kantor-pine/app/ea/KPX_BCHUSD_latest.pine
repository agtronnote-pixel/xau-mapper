//@version=6
indicator("KPX Mapping BCHUSD 202611282307", overlay=true, max_lines_count=100, max_boxes_count=20, max_labels_count=60)
// Dibuat otomatis oleh Kantor Pine (BCHUSD) dari mapping 2026-11-28T16:07:27.411Z (harga 205.70).
// Bukan nasihat keuangan. Konfirmasi di chart dan selalu gunakan stop loss.
offset = input.float(0.0, "Selisih harga broker - mapping (USD)", group="Umum", tooltip="Isi bila harga broker berbeda dari harga mapping")
showLevels = input.bool(true, "Tampilkan level kunci", group="Tampilan")
showPlans = input.bool(true, "Tampilkan rencana entry", group="Tampilan")

drawLine(float p, color c, string t, bool solid) =>
    line.new(bar_index - 1, p + offset, bar_index, p + offset, extend=extend.both, color=c, style=solid ? line.style_solid : line.style_dashed, width=1)
    label.new(bar_index + 3, p + offset, t + " " + str.tostring(p + offset, "#.00"), style=label.style_none, textcolor=c, size=size.small)

var bool drawn = false
if barstate.islast and not drawn
    drawn := true
    if showLevels
        drawLine(220.00, color.red, "R High kemarin (PDH)", false)
        drawLine(217.60, color.red, "R R1 harian", false)
        drawLine(210.20, color.red, "R Swing high H1", false)
        drawLine(209.70, color.gray, "P Pivot harian", false)
        drawLine(208.00, color.red, "R Angka bulat", false)
        drawLine(207.50, color.red, "R Swing high H1", false)
        drawLine(205.80, color.red, "R Swing low H1", false)
        drawLine(205.00, color.green, "S Swing low H1", false)
        drawLine(203.90, color.green, "S Swing low H1", false)
        drawLine(201.80, color.green, "S Low kemarin (PDL)", false)
        drawLine(199.40, color.green, "S S1 harian", false)
    if showPlans
        box.new(bar_index - 20, 207.82 + offset, bar_index + 40, 207.18 + offset, border_color=color.red, bgcolor=color.new(color.red, 85), text="SELL Utama 73%", text_color=color.red, text_size=size.small)
        drawLine(209.26, color.red, "SL SELL", true)
        drawLine(205.00, color.blue, "TP1 SELL", true)
        drawLine(203.90, color.blue, "TP2 SELL", true)
        box.new(bar_index - 20, 205.32 + offset, bar_index + 40, 204.68 + offset, border_color=color.green, bgcolor=color.new(color.green, 85), text="BUY Alternatif 29%", text_color=color.green, text_size=size.small)
        drawLine(203.24, color.red, "SL BUY", true)
        drawLine(207.50, color.blue, "TP1 BUY", true)
        drawLine(209.70, color.blue, "TP2 BUY", true)

inZone0 = close >= 207.18 + offset and close <= 207.82 + offset
alertcondition(inZone0 and not inZone0[1], "KPX SELL Utama: masuk zona", "BCHUSD masuk zona SELL {{close}} - EA entry")
inZone1 = close >= 204.68 + offset and close <= 205.32 + offset
alertcondition(inZone1 and not inZone1[1], "KPX BUY Alternatif: masuk zona", "BCHUSD masuk zona BUY {{close}} - EA entry")
plot(na, "KPX")
