//@version=6
indicator("KPX Mapping BCHUSD 202611252107", overlay=true, max_lines_count=100, max_boxes_count=20, max_labels_count=60)
// Dibuat otomatis oleh Kantor Pine (BCHUSD) dari mapping 2026-11-25T14:07:27.715Z (harga 193.30).
// Bukan nasihat keuangan. Konfirmasi di chart dan selalu gunakan stop loss.
offset = input.float(0.0, "Selisih harga broker - mapping (USD)", group="Umum", tooltip="Isi bila harga broker berbeda dari harga mapping")
showLevels = input.bool(true, "Tampilkan level kunci", group="Tampilan")
showPlans = input.bool(true, "Tampilkan rencana entry", group="Tampilan")

drawLine(float p, color c, string t, bool solid) =>
    line.new(bar_index - 1, p + offset, bar_index, p + offset, extend=extend.both, color=c, style=solid ? line.style_solid : line.style_dashed, width=1)
    label.new(bar_index + 3, p + offset, t + " " + str.tostring(p + offset, "#.00"), style=label.style_none, textcolor=c, size=size.small)

var bool drawn = false
if barstate.islast and not drawn
    drawn := true
    if showLevels
        drawLine(204.30, color.red, "R High kemarin (PDH)", false)
        drawLine(203.27, color.red, "R R1 harian", false)
        drawLine(200.20, color.red, "R Swing high H1", false)
        drawLine(198.73, color.gray, "P Pivot harian", false)
        drawLine(198.20, color.red, "R Swing high H1", false)
        drawLine(195.30, color.red, "R Swing low H1", false)
        drawLine(194.20, color.red, "R Low kemarin (PDL)", false)
        drawLine(193.17, color.green, "S S1 harian", false)
        drawLine(192.00, color.green, "S Angka bulat", false)
    if showPlans
        box.new(bar_index - 20, 194.61 + offset, bar_index + 40, 193.79 + offset, border_color=color.red, bgcolor=color.new(color.red, 85), text="SELL Utama 70%", text_color=color.red, text_size=size.small)
        drawLine(196.46, color.red, "SL SELL", true)
        drawLine(190.81, color.blue, "TP1 SELL", true)
        drawLine(187.42, color.blue, "TP2 SELL", true)
        box.new(bar_index - 20, 192.41 + offset, bar_index + 40, 191.59 + offset, border_color=color.green, bgcolor=color.new(color.green, 85), text="BUY Alternatif 23%", text_color=color.green, text_size=size.small)
        drawLine(189.75, color.red, "SL BUY", true)
        drawLine(195.30, color.blue, "TP1 BUY", true)
        drawLine(198.20, color.blue, "TP2 BUY", true)

inZone0 = close >= 193.79 + offset and close <= 194.61 + offset
alertcondition(inZone0 and not inZone0[1], "KPX SELL Utama: masuk zona", "BCHUSD masuk zona SELL {{close}} - EA entry")
inZone1 = close >= 191.59 + offset and close <= 192.41 + offset
alertcondition(inZone1 and not inZone1[1], "KPX BUY Alternatif: masuk zona", "BCHUSD masuk zona BUY {{close}} - EA entry")
plot(na, "KPX")
