//@version=6
indicator("KPX Mapping USA100 202611241611", overlay=true, max_lines_count=100, max_boxes_count=20, max_labels_count=60)
// Dibuat otomatis oleh Kantor Pine (USA100) dari mapping 2026-11-24T09:11:43.261Z (harga 26866.25).
// Bukan nasihat keuangan. Konfirmasi di chart dan selalu gunakan stop loss.
offset = input.float(0.0, "Selisih harga broker - mapping (USD)", group="Umum", tooltip="Isi bila harga broker berbeda dari harga mapping")
showLevels = input.bool(true, "Tampilkan level kunci", group="Tampilan")
showPlans = input.bool(true, "Tampilkan rencana entry", group="Tampilan")

drawLine(float p, color c, string t, bool solid) =>
    line.new(bar_index - 1, p + offset, bar_index, p + offset, extend=extend.both, color=c, style=solid ? line.style_solid : line.style_dashed, width=1)
    label.new(bar_index + 3, p + offset, t + " " + str.tostring(p + offset, "#.00"), style=label.style_none, textcolor=c, size=size.small)

var bool drawn = false
if barstate.islast and not drawn
    drawn := true
    if showLevels
        drawLine(27500.67, color.red, "R R1 harian", false)
        drawLine(27137.00, color.red, "R High kemarin (PDH)", false)
        drawLine(27036.00, color.red, "R Swing high H1", false)
        drawLine(26948.00, color.red, "R Swing high H1", false)
        drawLine(26900.00, color.red, "R Angka bulat", false)
        drawLine(26800.00, color.green, "S Angka bulat", false)
        drawLine(26684.00, color.green, "S Swing low H1", false)
        drawLine(26481.33, color.gray, "P Pivot harian", false)
        drawLine(26102.25, color.green, "S Swing high H1", false)
        drawLine(25825.67, color.green, "S S1 harian", false)
        drawLine(25462.00, color.green, "S Low kemarin (PDL)", false)
    if showPlans
        box.new(bar_index - 20, 26832.08 + offset, bar_index + 40, 26767.93 + offset, border_color=color.green, bgcolor=color.new(color.green, 85), text="BUY Range 57%", text_color=color.green, text_size=size.small)
        drawLine(26623.59, color.red, "SL BUY", true)
        drawLine(27036.00, color.blue, "TP1 BUY", true)
        drawLine(27137.00, color.blue, "TP2 BUY", true)
        box.new(bar_index - 20, 26932.08 + offset, bar_index + 40, 26867.93 + offset, border_color=color.red, bgcolor=color.new(color.red, 85), text="SELL Range 42%", text_color=color.red, text_size=size.small)
        drawLine(27076.42, color.red, "SL SELL", true)
        drawLine(26684.00, color.blue, "TP1 SELL", true)
        drawLine(26481.33, color.blue, "TP2 SELL", true)

inZone0 = close >= 26767.93 + offset and close <= 26832.08 + offset
alertcondition(inZone0 and not inZone0[1], "KPX BUY Range: masuk zona", "USA100 masuk zona BUY {{close}} - EA entry")
inZone1 = close >= 26867.93 + offset and close <= 26932.08 + offset
alertcondition(inZone1 and not inZone1[1], "KPX SELL Range: masuk zona", "USA100 masuk zona SELL {{close}} - EA entry")
plot(na, "KPX")
