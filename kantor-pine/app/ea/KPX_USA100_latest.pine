//@version=6
indicator("KPX Mapping USA100 202611272207", overlay=true, max_lines_count=100, max_boxes_count=20, max_labels_count=60)
// Dibuat otomatis oleh Kantor Pine (USA100) dari mapping 2026-11-27T15:07:32.638Z (harga 26376.50).
// Bukan nasihat keuangan. Konfirmasi di chart dan selalu gunakan stop loss.
offset = input.float(0.0, "Selisih harga broker - mapping (USD)", group="Umum", tooltip="Isi bila harga broker berbeda dari harga mapping")
showLevels = input.bool(true, "Tampilkan level kunci", group="Tampilan")
showPlans = input.bool(true, "Tampilkan rencana entry", group="Tampilan")

drawLine(float p, color c, string t, bool solid) =>
    line.new(bar_index - 1, p + offset, bar_index, p + offset, extend=extend.both, color=c, style=solid ? line.style_solid : line.style_dashed, width=1)
    label.new(bar_index + 3, p + offset, t + " " + str.tostring(p + offset, "#.00"), style=label.style_none, textcolor=c, size=size.small)

var bool drawn = false
if barstate.islast and not drawn
    drawn := true
    if showLevels
        drawLine(27036.00, color.red, "R Swing high H1", false)
        drawLine(26949.50, color.red, "R Swing high H1", false)
        drawLine(26707.00, color.red, "R Swing low H1", false)
        drawLine(26558.33, color.red, "R R1 harian", false)
        drawLine(26500.00, color.red, "R Angka bulat", false)
        drawLine(26350.75, color.green, "S High kemarin (PDH)", false)
        drawLine(26126.25, color.green, "S Swing low H1", false)
        drawLine(25998.00, color.green, "S Swing low H1", false)
        drawLine(25792.92, color.gray, "P Pivot harian", false)
        drawLine(25235.08, color.green, "S S1 harian", false)
        drawLine(25027.50, color.green, "S Low kemarin (PDL)", false)
    if showPlans
        box.new(bar_index - 20, 26542.90 + offset, bar_index + 40, 26457.10 + offset, border_color=color.red, bgcolor=color.new(color.red, 85), text="SELL Range 53%", text_color=color.red, text_size=size.small)
        drawLine(26735.93, color.red, "SL SELL", true)
        drawLine(26126.25, color.blue, "TP1 SELL", true)
        drawLine(25998.00, color.blue, "TP2 SELL", true)
        box.new(bar_index - 20, 26169.15 + offset, bar_index + 40, 26083.35 + offset, border_color=color.green, bgcolor=color.new(color.green, 85), text="BUY Range 51%", text_color=color.green, text_size=size.small)
        drawLine(25890.32, color.red, "SL BUY", true)
        drawLine(26500.00, color.blue, "TP1 BUY", true)
        drawLine(26707.00, color.blue, "TP2 BUY", true)

inZone0 = close >= 26457.10 + offset and close <= 26542.90 + offset
alertcondition(inZone0 and not inZone0[1], "KPX SELL Range: masuk zona", "USA100 masuk zona SELL {{close}} - EA entry")
inZone1 = close >= 26083.35 + offset and close <= 26169.15 + offset
alertcondition(inZone1 and not inZone1[1], "KPX BUY Range: masuk zona", "USA100 masuk zona BUY {{close}} - EA entry")
plot(na, "KPX")
