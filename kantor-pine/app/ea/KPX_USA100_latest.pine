//@version=6
indicator("KPX Mapping USA100 202611252207", overlay=true, max_lines_count=100, max_boxes_count=20, max_labels_count=60)
// Dibuat otomatis oleh Kantor Pine (USA100) dari mapping 2026-11-25T15:07:30.043Z (harga 25961.75).
// Bukan nasihat keuangan. Konfirmasi di chart dan selalu gunakan stop loss.
offset = input.float(0.0, "Selisih harga broker - mapping (USD)", group="Umum", tooltip="Isi bila harga broker berbeda dari harga mapping")
showLevels = input.bool(true, "Tampilkan level kunci", group="Tampilan")
showPlans = input.bool(true, "Tampilkan rencana entry", group="Tampilan")

drawLine(float p, color c, string t, bool solid) =>
    line.new(bar_index - 1, p + offset, bar_index, p + offset, extend=extend.both, color=c, style=solid ? line.style_solid : line.style_dashed, width=1)
    label.new(bar_index + 3, p + offset, t + " " + str.tostring(p + offset, "#.00"), style=label.style_none, textcolor=c, size=size.small)

var bool drawn = false
if barstate.islast and not drawn
    drawn := true
    if showLevels
        drawLine(27036.00, color.red, "R High kemarin (PDH)", false)
        drawLine(26949.50, color.red, "R Swing high H1", false)
        drawLine(26868.67, color.red, "R R1 harian", false)
        drawLine(26684.00, color.red, "R Swing low H1", false)
        drawLine(26509.75, color.red, "R Swing high H1", false)
        drawLine(26433.33, color.gray, "P Pivot harian", false)
        drawLine(26350.75, color.red, "R Swing high H1", false)
        drawLine(26126.25, color.red, "R Swing low H1", false)
        drawLine(25998.00, color.red, "R Low kemarin (PDL)", false)
        drawLine(25900.00, color.green, "S Angka bulat", false)
        drawLine(25830.67, color.green, "S S1 harian", false)
    if showPlans
        box.new(bar_index - 20, 26164.76 + offset, bar_index + 40, 26087.74 + offset, border_color=color.red, bgcolor=color.new(color.red, 85), text="SELL Utama 70%", text_color=color.red, text_size=size.small)
        drawLine(26338.06, color.red, "SL SELL", true)
        drawLine(25900.00, color.blue, "TP1 SELL", true)
        drawLine(25490.82, color.blue, "TP2 SELL", true)
        box.new(bar_index - 20, 25938.51 + offset, bar_index + 40, 25861.49 + offset, border_color=color.green, bgcolor=color.new(color.green, 85), text="BUY Alternatif 15%", text_color=color.green, text_size=size.small)
        drawLine(25688.19, color.red, "SL BUY", true)
        drawLine(26126.25, color.blue, "TP1 BUY", true)
        drawLine(26350.75, color.blue, "TP2 BUY", true)

inZone0 = close >= 26087.74 + offset and close <= 26164.76 + offset
alertcondition(inZone0 and not inZone0[1], "KPX SELL Utama: masuk zona", "USA100 masuk zona SELL {{close}} - EA entry")
inZone1 = close >= 25861.49 + offset and close <= 25938.51 + offset
alertcondition(inZone1 and not inZone1[1], "KPX BUY Alternatif: masuk zona", "USA100 masuk zona BUY {{close}} - EA entry")
plot(na, "KPX")
