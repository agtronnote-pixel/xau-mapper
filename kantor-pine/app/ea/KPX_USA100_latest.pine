//@version=6
indicator("KPX Mapping USA100 202611231557", overlay=true, max_lines_count=100, max_boxes_count=20, max_labels_count=60)
// Dibuat otomatis oleh Kantor Pine (USA100) dari mapping 2026-11-23T08:57:31.239Z (harga 25866.50).
// Bukan nasihat keuangan. Konfirmasi di chart dan selalu gunakan stop loss.
offset = input.float(0.0, "Selisih harga broker - mapping (USD)", group="Umum", tooltip="Isi bila harga broker berbeda dari harga mapping")
showLevels = input.bool(true, "Tampilkan level kunci", group="Tampilan")
showPlans = input.bool(true, "Tampilkan rencana entry", group="Tampilan")

drawLine(float p, color c, string t, bool solid) =>
    line.new(bar_index - 1, p + offset, bar_index, p + offset, extend=extend.both, color=c, style=solid ? line.style_solid : line.style_dashed, width=1)
    label.new(bar_index + 3, p + offset, t + " " + str.tostring(p + offset, "#.00"), style=label.style_none, textcolor=c, size=size.small)

var bool drawn = false
if barstate.islast and not drawn
    drawn := true
    if showLevels
        drawLine(26603.50, color.red, "R High kemarin (PDH)", false)
        drawLine(26447.75, color.red, "R Swing high H1", false)
        drawLine(26161.17, color.red, "R R1 harian", false)
        drawLine(25945.00, color.red, "R Swing high H1", false)
        drawLine(25805.50, color.green, "S Swing low H1", false)
        drawLine(25568.83, color.gray, "P Pivot harian", false)
        drawLine(24976.50, color.green, "S Low kemarin (PDL)", false)
        drawLine(24534.17, color.green, "S S1 harian", false)
    if showPlans
        box.new(bar_index - 20, 25994.77 + offset, bar_index + 40, 25895.23 + offset, border_color=color.red, bgcolor=color.new(color.red, 85), text="SELL Utama 63%", text_color=color.red, text_size=size.small)
        drawLine(26218.74, color.red, "SL SELL", true)
        drawLine(25568.83, color.blue, "TP1 SELL", true)
        drawLine(24976.50, color.blue, "TP2 SELL", true)
        box.new(bar_index - 20, 25855.27 + offset, bar_index + 40, 25755.73 + offset, border_color=color.green, bgcolor=color.new(color.green, 85), text="BUY Alternatif 38%", text_color=color.green, text_size=size.small)
        drawLine(25531.76, color.red, "SL BUY", true)
        drawLine(26161.17, color.blue, "TP1 BUY", true)
        drawLine(26447.75, color.blue, "TP2 BUY", true)

inZone0 = close >= 25895.23 + offset and close <= 25994.77 + offset
alertcondition(inZone0 and not inZone0[1], "KPX SELL Utama: masuk zona", "USA100 masuk zona SELL {{close}} - EA entry")
inZone1 = close >= 25755.73 + offset and close <= 25855.27 + offset
alertcondition(inZone1 and not inZone1[1], "KPX BUY Alternatif: masuk zona", "USA100 masuk zona BUY {{close}} - EA entry")
plot(na, "KPX")
