//@version=6
indicator("KPX Mapping USA100 202611240507", overlay=true, max_lines_count=100, max_boxes_count=20, max_labels_count=60)
// Dibuat otomatis oleh Kantor Pine (USA100) dari mapping 2026-11-23T22:07:27.762Z (harga 25866.50).
// Bukan nasihat keuangan. Konfirmasi di chart dan selalu gunakan stop loss.
offset = input.float(0.0, "Selisih harga broker - mapping (USD)", group="Umum", tooltip="Isi bila harga broker berbeda dari harga mapping")
showLevels = input.bool(true, "Tampilkan level kunci", group="Tampilan")
showPlans = input.bool(true, "Tampilkan rencana entry", group="Tampilan")

drawLine(float p, color c, string t, bool solid) =>
    line.new(bar_index - 1, p + offset, bar_index, p + offset, extend=extend.both, color=c, style=solid ? line.style_solid : line.style_dashed, width=1)
    label.new(bar_index + 3, p + offset, t + " " + str.tostring(p + offset, "#.00"), style=label.style_none, textcolor=c, size=size.small)

var bool drawn = false
if barstate.islast and not drawn
    drawn := true
    if showLevels
        drawLine(27493.67, color.red, "R R1 harian", false)
        drawLine(27137.00, color.red, "R High kemarin (PDH)", false)
        drawLine(26477.83, color.gray, "P Pivot harian", false)
        drawLine(26102.25, color.red, "R Swing high H1", false)
        drawLine(25945.00, color.red, "R Swing high H1", false)
        drawLine(25818.67, color.green, "S S1 harian", false)
        drawLine(25610.75, color.green, "S Swing low H1", false)
        drawLine(25462.00, color.green, "S Low kemarin (PDL)", false)
        drawLine(24976.50, color.green, "S Swing low H1", false)
    if showPlans
        box.new(bar_index - 20, 25664.74 + offset, bar_index + 40, 25556.76 + offset, border_color=color.green, bgcolor=color.new(color.green, 85), text="BUY Utama 65%", text_color=color.green, text_size=size.small)
        drawLine(25313.81, color.red, "SL BUY", true)
        drawLine(25945.00, color.blue, "TP1 BUY", true)
        drawLine(26102.25, color.blue, "TP2 BUY", true)
        box.new(bar_index - 20, 25998.99 + offset, bar_index + 40, 25891.01 + offset, border_color=color.red, bgcolor=color.new(color.red, 85), text="SELL Alternatif 20%", text_color=color.red, text_size=size.small)
        drawLine(26241.94, color.red, "SL SELL", true)
        drawLine(25610.75, color.blue, "TP1 SELL", true)
        drawLine(25462.00, color.blue, "TP2 SELL", true)

inZone0 = close >= 25556.76 + offset and close <= 25664.74 + offset
alertcondition(inZone0 and not inZone0[1], "KPX BUY Utama: masuk zona", "USA100 masuk zona BUY {{close}} - EA entry")
inZone1 = close >= 25891.01 + offset and close <= 25998.99 + offset
alertcondition(inZone1 and not inZone1[1], "KPX SELL Alternatif: masuk zona", "USA100 masuk zona SELL {{close}} - EA entry")
plot(na, "KPX")
