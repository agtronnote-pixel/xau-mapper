//@version=6
indicator("KPX Mapping BTCUSD 202611251309", overlay=true, max_lines_count=100, max_boxes_count=20, max_labels_count=60)
// Dibuat otomatis oleh Kantor Pine (BTCUSD) dari mapping 2026-11-25T06:09:13.903Z (harga 59121.65).
// Bukan nasihat keuangan. Konfirmasi di chart dan selalu gunakan stop loss.
offset = input.float(0.0, "Selisih harga broker - mapping (USD)", group="Umum", tooltip="Isi bila harga broker berbeda dari harga mapping")
showLevels = input.bool(true, "Tampilkan level kunci", group="Tampilan")
showPlans = input.bool(true, "Tampilkan rencana entry", group="Tampilan")

drawLine(float p, color c, string t, bool solid) =>
    line.new(bar_index - 1, p + offset, bar_index, p + offset, extend=extend.both, color=c, style=solid ? line.style_solid : line.style_dashed, width=1)
    label.new(bar_index + 3, p + offset, t + " " + str.tostring(p + offset, "#.00"), style=label.style_none, textcolor=c, size=size.small)

var bool drawn = false
if barstate.islast and not drawn
    drawn := true
    if showLevels
        drawLine(61682.01, color.red, "R High kemarin (PDH)", false)
        drawLine(61237.50, color.red, "R R1 harian", false)
        drawLine(60768.56, color.red, "R Swing high H1", false)
        drawLine(60248.75, color.gray, "P Pivot harian", false)
        drawLine(60106.00, color.red, "R Swing high H1", false)
        drawLine(59390.86, color.red, "R Swing low H1", false)
        drawLine(59260.00, color.red, "R Low kemarin (PDL)", false)
        drawLine(58937.50, color.green, "S Swing low H1", false)
        drawLine(58815.49, color.green, "S S1 harian", false)
        drawLine(58500.00, color.green, "S Angka bulat", false)
    if showPlans
        box.new(bar_index - 20, 59351.37 + offset, bar_index + 40, 59168.63 + offset, border_color=color.red, bgcolor=color.new(color.red, 85), text="SELL Utama 70%", text_color=color.red, text_size=size.small)
        drawLine(59762.52, color.red, "SL SELL", true)
        drawLine(58500.00, color.blue, "TP1 SELL", true)
        drawLine(57752.44, color.blue, "TP2 SELL", true)
        box.new(bar_index - 20, 59028.87 + offset, bar_index + 40, 58846.13 + offset, border_color=color.green, bgcolor=color.new(color.green, 85), text="BUY Alternatif 22%", text_color=color.green, text_size=size.small)
        drawLine(58434.98, color.red, "SL BUY", true)
        drawLine(59691.28, color.blue, "TP1 BUY", true)
        drawLine(60106.00, color.blue, "TP2 BUY", true)

inZone0 = close >= 59168.63 + offset and close <= 59351.37 + offset
alertcondition(inZone0 and not inZone0[1], "KPX SELL Utama: masuk zona", "BTCUSD masuk zona SELL {{close}} - EA entry")
inZone1 = close >= 58846.13 + offset and close <= 59028.87 + offset
alertcondition(inZone1 and not inZone1[1], "KPX BUY Alternatif: masuk zona", "BTCUSD masuk zona BUY {{close}} - EA entry")
plot(na, "KPX")
