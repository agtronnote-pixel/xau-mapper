//@version=6
indicator("KPX Mapping BTCUSD 202611260707", overlay=true, max_lines_count=100, max_boxes_count=20, max_labels_count=60)
// Dibuat otomatis oleh Kantor Pine (BTCUSD) dari mapping 2026-11-26T00:07:27.207Z (harga 60442.54).
// Bukan nasihat keuangan. Konfirmasi di chart dan selalu gunakan stop loss.
offset = input.float(0.0, "Selisih harga broker - mapping (USD)", group="Umum", tooltip="Isi bila harga broker berbeda dari harga mapping")
showLevels = input.bool(true, "Tampilkan level kunci", group="Tampilan")
showPlans = input.bool(true, "Tampilkan rencana entry", group="Tampilan")

drawLine(float p, color c, string t, bool solid) =>
    line.new(bar_index - 1, p + offset, bar_index, p + offset, extend=extend.both, color=c, style=solid ? line.style_solid : line.style_dashed, width=1)
    label.new(bar_index + 3, p + offset, t + " " + str.tostring(p + offset, "#.00"), style=label.style_none, textcolor=c, size=size.small)

var bool drawn = false
if barstate.islast and not drawn
    drawn := true
    if showLevels
        drawLine(61596.49, color.red, "R R1 harian", false)
        drawLine(61000.00, color.red, "R Angka bulat", false)
        drawLine(60568.01, color.red, "R High kemarin (PDH)", false)
        drawLine(60294.68, color.green, "S Swing high H1", false)
        drawLine(60106.00, color.green, "S Swing high H1", false)
        drawLine(59448.43, color.gray, "P Pivot harian", false)
        drawLine(58922.16, color.green, "S Swing high H1", false)
        drawLine(58633.12, color.green, "S Swing low H1", false)
        drawLine(58328.86, color.green, "S S1 harian", false)
        drawLine(57300.38, color.green, "S Low kemarin (PDL)", false)
    if showPlans
        box.new(bar_index - 20, 61141.56 + offset, bar_index + 40, 60858.44 + offset, border_color=color.red, bgcolor=color.new(color.red, 85), text="SELL Range 52%", text_color=color.red, text_size=size.small)
        drawLine(61778.59, color.red, "SL SELL", true)
        drawLine(60106.00, color.blue, "TP1 SELL", true)
        drawLine(59448.43, color.blue, "TP2 SELL", true)
        box.new(bar_index - 20, 60436.24 + offset, bar_index + 40, 60153.12 + offset, border_color=color.green, bgcolor=color.new(color.green, 85), text="BUY Range 49%", text_color=color.green, text_size=size.small)
        drawLine(59516.09, color.red, "SL BUY", true)
        drawLine(61596.49, color.blue, "TP1 BUY", true)
        drawLine(62630.45, color.blue, "TP2 BUY", true)

inZone0 = close >= 60858.44 + offset and close <= 61141.56 + offset
alertcondition(inZone0 and not inZone0[1], "KPX SELL Range: masuk zona", "BTCUSD masuk zona SELL {{close}} - EA entry")
inZone1 = close >= 60153.12 + offset and close <= 60436.24 + offset
alertcondition(inZone1 and not inZone1[1], "KPX BUY Range: masuk zona", "BTCUSD masuk zona BUY {{close}} - EA entry")
plot(na, "KPX")
