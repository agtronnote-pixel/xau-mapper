//@version=6
indicator("KPX Mapping BTCUSD 202611232107", overlay=true, max_lines_count=100, max_boxes_count=20, max_labels_count=60)
// Dibuat otomatis oleh Kantor Pine (BTCUSD) dari mapping 2026-11-23T14:07:26.453Z (harga 63029.69).
// Bukan nasihat keuangan. Konfirmasi di chart dan selalu gunakan stop loss.
offset = input.float(0.0, "Selisih harga broker - mapping (USD)", group="Umum", tooltip="Isi bila harga broker berbeda dari harga mapping")
showLevels = input.bool(true, "Tampilkan level kunci", group="Tampilan")
showPlans = input.bool(true, "Tampilkan rencana entry", group="Tampilan")

drawLine(float p, color c, string t, bool solid) =>
    line.new(bar_index - 1, p + offset, bar_index, p + offset, extend=extend.both, color=c, style=solid ? line.style_solid : line.style_dashed, width=1)
    label.new(bar_index + 3, p + offset, t + " " + str.tostring(p + offset, "#.00"), style=label.style_none, textcolor=c, size=size.small)

var bool drawn = false
if barstate.islast and not drawn
    drawn := true
    if showLevels
        drawLine(63500.00, color.red, "R Angka bulat", false)
        drawLine(63000.00, color.green, "S Angka bulat", false)
        drawLine(62371.21, color.green, "S R1 harian", false)
        drawLine(61959.93, color.green, "S Swing high H1", false)
        drawLine(61669.99, color.green, "S High kemarin (PDH)", false)
        drawLine(61464.35, color.green, "S Swing high H1", false)
        drawLine(61139.36, color.green, "S Swing low H1", false)
        drawLine(60569.86, color.gray, "P Pivot harian", false)
        drawLine(60386.00, color.green, "S Swing low H1", false)
        drawLine(59469.73, color.green, "S S1 harian", false)
        drawLine(58768.51, color.green, "S Low kemarin (PDL)", false)
    if showPlans
        box.new(bar_index - 20, 62506.83 + offset, bar_index + 40, 62235.59 + offset, border_color=color.green, bgcolor=color.new(color.green, 85), text="BUY Utama 69%", text_color=color.green, text_size=size.small)
        drawLine(61625.29, color.red, "SL BUY", true)
        drawLine(63500.00, color.blue, "TP1 BUY", true)
        drawLine(64608.97, color.blue, "TP2 BUY", true)
        box.new(bar_index - 20, 63635.62 + offset, bar_index + 40, 63364.38 + offset, border_color=color.red, bgcolor=color.new(color.red, 85), text="SELL Alternatif 33%", text_color=color.red, text_size=size.small)
        drawLine(64245.92, color.red, "SL SELL", true)
        drawLine(62371.21, color.blue, "TP1 SELL", true)
        drawLine(61959.93, color.blue, "TP2 SELL", true)

inZone0 = close >= 62235.59 + offset and close <= 62506.83 + offset
alertcondition(inZone0 and not inZone0[1], "KPX BUY Utama: masuk zona", "BTCUSD masuk zona BUY {{close}} - EA entry")
inZone1 = close >= 63364.38 + offset and close <= 63635.62 + offset
alertcondition(inZone1 and not inZone1[1], "KPX SELL Alternatif: masuk zona", "BTCUSD masuk zona SELL {{close}} - EA entry")
plot(na, "KPX")
