//@version=6
indicator("KPX Mapping BTCUSD 202611270507", overlay=true, max_lines_count=100, max_boxes_count=20, max_labels_count=60)
// Dibuat otomatis oleh Kantor Pine (BTCUSD) dari mapping 2026-11-26T22:07:26.659Z (harga 60657.94).
// Bukan nasihat keuangan. Konfirmasi di chart dan selalu gunakan stop loss.
offset = input.float(0.0, "Selisih harga broker - mapping (USD)", group="Umum", tooltip="Isi bila harga broker berbeda dari harga mapping")
showLevels = input.bool(true, "Tampilkan level kunci", group="Tampilan")
showPlans = input.bool(true, "Tampilkan rencana entry", group="Tampilan")

drawLine(float p, color c, string t, bool solid) =>
    line.new(bar_index - 1, p + offset, bar_index, p + offset, extend=extend.both, color=c, style=solid ? line.style_solid : line.style_dashed, width=1)
    label.new(bar_index + 3, p + offset, t + " " + str.tostring(p + offset, "#.00"), style=label.style_none, textcolor=c, size=size.small)

var bool drawn = false
if barstate.islast and not drawn
    drawn := true
    if showLevels
        drawLine(61583.89, color.red, "R R1 harian", false)
        drawLine(61126.33, color.red, "R Swing high H1", false)
        drawLine(61000.00, color.red, "R Angka bulat", false)
        drawLine(60568.01, color.green, "S High kemarin (PDH)", false)
        drawLine(60380.01, color.green, "S Swing low H1", false)
        drawLine(59939.24, color.green, "S Swing low H1", false)
        drawLine(59442.13, color.gray, "P Pivot harian", false)
        drawLine(58922.16, color.green, "S Swing high H1", false)
        drawLine(58316.26, color.green, "S S1 harian", false)
        drawLine(57300.38, color.green, "S Low kemarin (PDL)", false)
    if showPlans
        box.new(bar_index - 20, 61074.13 + offset, bar_index + 40, 60925.87 + offset, border_color=color.red, bgcolor=color.new(color.red, 85), text="SELL Range 57%", text_color=color.red, text_size=size.small)
        drawLine(61407.70, color.red, "SL SELL", true)
        drawLine(60568.01, color.blue, "TP1 SELL", true)
        drawLine(59939.24, color.blue, "TP2 SELL", true)
        box.new(bar_index - 20, 60642.14 + offset, bar_index + 40, 60493.88 + offset, border_color=color.green, bgcolor=color.new(color.green, 85), text="BUY Range 42%", text_color=color.green, text_size=size.small)
        drawLine(60160.31, color.red, "SL BUY", true)
        drawLine(61000.00, color.blue, "TP1 BUY", true)
        drawLine(61583.89, color.blue, "TP2 BUY", true)

inZone0 = close >= 60925.87 + offset and close <= 61074.13 + offset
alertcondition(inZone0 and not inZone0[1], "KPX SELL Range: masuk zona", "BTCUSD masuk zona SELL {{close}} - EA entry")
inZone1 = close >= 60493.88 + offset and close <= 60642.14 + offset
alertcondition(inZone1 and not inZone1[1], "KPX BUY Range: masuk zona", "BTCUSD masuk zona BUY {{close}} - EA entry")
plot(na, "KPX")
