//@version=6
indicator("KPX Mapping BTCUSD 202611241507", overlay=true, max_lines_count=100, max_boxes_count=20, max_labels_count=60)
// Dibuat otomatis oleh Kantor Pine (BTCUSD) dari mapping 2026-11-24T08:07:32.318Z (harga 60254.51).
// Bukan nasihat keuangan. Konfirmasi di chart dan selalu gunakan stop loss.
offset = input.float(0.0, "Selisih harga broker - mapping (USD)", group="Umum", tooltip="Isi bila harga broker berbeda dari harga mapping")
showLevels = input.bool(true, "Tampilkan level kunci", group="Tampilan")
showPlans = input.bool(true, "Tampilkan rencana entry", group="Tampilan")

drawLine(float p, color c, string t, bool solid) =>
    line.new(bar_index - 1, p + offset, bar_index, p + offset, extend=extend.both, color=c, style=solid ? line.style_solid : line.style_dashed, width=1)
    label.new(bar_index + 3, p + offset, t + " " + str.tostring(p + offset, "#.00"), style=label.style_none, textcolor=c, size=size.small)

var bool drawn = false
if barstate.islast and not drawn
    drawn := true
    if showLevels
        drawLine(64603.12, color.red, "R High kemarin (PDH)", false)
        drawLine(63791.07, color.red, "R R1 harian", false)
        drawLine(62088.54, color.gray, "P Pivot harian", false)
        drawLine(61941.38, color.red, "R Swing high H1", false)
        drawLine(61682.01, color.red, "R Swing high H1", false)
        drawLine(61139.36, color.red, "R Swing low H1", false)
        drawLine(61000.00, color.red, "R Angka bulat", false)
        drawLine(60768.56, color.red, "R Swing high H1", false)
        drawLine(60386.00, color.red, "R Low kemarin (PDL)", false)
        drawLine(60000.00, color.green, "S Angka bulat", false)
        drawLine(59573.95, color.green, "S S1 harian", false)
    if showPlans
        box.new(bar_index - 20, 60493.29 + offset, bar_index + 40, 60278.71 + offset, border_color=color.red, bgcolor=color.new(color.red, 85), text="SELL Utama 81%", text_color=color.red, text_size=size.small)
        drawLine(60976.09, color.red, "SL SELL", true)
        drawLine(59573.95, color.blue, "TP1 SELL", true)
        drawLine(58615.73, color.blue, "TP2 SELL", true)
        box.new(bar_index - 20, 60107.29 + offset, bar_index + 40, 59892.71 + offset, border_color=color.green, bgcolor=color.new(color.green, 85), text="BUY Alternatif 20%", text_color=color.green, text_size=size.small)
        drawLine(59409.91, color.red, "SL BUY", true)
        drawLine(60768.56, color.blue, "TP1 BUY", true)
        drawLine(61139.36, color.blue, "TP2 BUY", true)

inZone0 = close >= 60278.71 + offset and close <= 60493.29 + offset
alertcondition(inZone0 and not inZone0[1], "KPX SELL Utama: masuk zona", "BTCUSD masuk zona SELL {{close}} - EA entry")
inZone1 = close >= 59892.71 + offset and close <= 60107.29 + offset
alertcondition(inZone1 and not inZone1[1], "KPX BUY Alternatif: masuk zona", "BTCUSD masuk zona BUY {{close}} - EA entry")
plot(na, "KPX")
