//@version=6
indicator("KPX Mapping BTCUSD 202611230907", overlay=true, max_lines_count=100, max_boxes_count=20, max_labels_count=60)
// Dibuat otomatis oleh Kantor Pine (BTCUSD) dari mapping 2026-11-23T02:07:28.782Z (harga 60839.06).
// Bukan nasihat keuangan. Konfirmasi di chart dan selalu gunakan stop loss.
offset = input.float(0.0, "Selisih harga broker - mapping (USD)", group="Umum", tooltip="Isi bila harga broker berbeda dari harga mapping")
showLevels = input.bool(true, "Tampilkan level kunci", group="Tampilan")
showPlans = input.bool(true, "Tampilkan rencana entry", group="Tampilan")

drawLine(float p, color c, string t, bool solid) =>
    line.new(bar_index - 1, p + offset, bar_index, p + offset, extend=extend.both, color=c, style=solid ? line.style_solid : line.style_dashed, width=1)
    label.new(bar_index + 3, p + offset, t + " " + str.tostring(p + offset, "#.00"), style=label.style_none, textcolor=c, size=size.small)

var bool drawn = false
if barstate.islast and not drawn
    drawn := true
    if showLevels
        drawLine(62403.65, color.red, "R R1 harian", false)
        drawLine(61669.99, color.red, "R High kemarin (PDH)", false)
        drawLine(61500.00, color.red, "R Angka bulat", false)
        drawLine(61365.24, color.red, "R Swing high H1", false)
        drawLine(61000.00, color.red, "R Angka bulat", false)
        drawLine(60586.08, color.gray, "P Pivot harian", false)
        drawLine(60464.01, color.green, "S Swing low H1", false)
        drawLine(59988.00, color.green, "S Swing low H1", false)
        drawLine(59502.17, color.green, "S S1 harian", false)
        drawLine(58768.51, color.green, "S Low kemarin (PDL)", false)
    if showPlans
        box.new(bar_index - 20, 60678.84 + offset, bar_index + 40, 60493.32 + offset, border_color=color.green, bgcolor=color.new(color.green, 85), text="BUY Range 55%", text_color=color.green, text_size=size.small)
        drawLine(60075.89, color.red, "SL BUY", true)
        drawLine(61365.24, color.blue, "TP1 BUY", true)
        drawLine(61669.99, color.blue, "TP2 BUY", true)
        box.new(bar_index - 20, 61092.76 + offset, bar_index + 40, 60907.24 + offset, border_color=color.red, bgcolor=color.new(color.red, 85), text="SELL Range 45%", text_color=color.red, text_size=size.small)
        drawLine(61510.19, color.red, "SL SELL", true)
        drawLine(60464.01, color.blue, "TP1 SELL", true)
        drawLine(59988.00, color.blue, "TP2 SELL", true)

inZone0 = close >= 60493.32 + offset and close <= 60678.84 + offset
alertcondition(inZone0 and not inZone0[1], "KPX BUY Range: masuk zona", "BTCUSD masuk zona BUY {{close}} - EA entry")
inZone1 = close >= 60907.24 + offset and close <= 61092.76 + offset
alertcondition(inZone1 and not inZone1[1], "KPX SELL Range: masuk zona", "BTCUSD masuk zona SELL {{close}} - EA entry")
plot(na, "KPX")
