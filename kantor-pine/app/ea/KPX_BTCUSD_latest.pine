//@version=6
indicator("KPX Mapping BTCUSD 202611241207", overlay=true, max_lines_count=100, max_boxes_count=20, max_labels_count=60)
// Dibuat otomatis oleh Kantor Pine (BTCUSD) dari mapping 2026-11-24T05:07:31.745Z (harga 60514.17).
// Bukan nasihat keuangan. Konfirmasi di chart dan selalu gunakan stop loss.
offset = input.float(0.0, "Selisih harga broker - mapping (USD)", group="Umum", tooltip="Isi bila harga broker berbeda dari harga mapping")
showLevels = input.bool(true, "Tampilkan level kunci", group="Tampilan")
showPlans = input.bool(true, "Tampilkan rencana entry", group="Tampilan")

drawLine(float p, color c, string t, bool solid) =>
    line.new(bar_index - 1, p + offset, bar_index, p + offset, extend=extend.both, color=c, style=solid ? line.style_solid : line.style_dashed, width=1)
    label.new(bar_index + 3, p + offset, t + " " + str.tostring(p + offset, "#.00"), style=label.style_none, textcolor=c, size=size.small)

var bool drawn = false
if barstate.islast and not drawn
    drawn := true
    if showLevels
        drawLine(64603.12, color.red, "R High kemarin (PDH)", false)
        drawLine(63791.07, color.red, "R R1 harian", false)
        drawLine(62088.54, color.gray, "P Pivot harian", false)
        drawLine(61830.00, color.red, "R Swing high H1", false)
        drawLine(61139.36, color.red, "R Swing low H1", false)
        drawLine(60763.39, color.red, "R Swing low H1", false)
        drawLine(60386.00, color.green, "S Low kemarin (PDL)", false)
        drawLine(60000.00, color.green, "S Angka bulat", false)
        drawLine(59573.95, color.green, "S S1 harian", false)
    if showPlans
        box.new(bar_index - 20, 60902.11 + offset, bar_index + 40, 60624.67 + offset, border_color=color.red, bgcolor=color.new(color.red, 85), text="SELL Utama 64%", text_color=color.red, text_size=size.small)
        drawLine(61526.37, color.red, "SL SELL", true)
        drawLine(60000.00, color.blue, "TP1 SELL", true)
        drawLine(59573.95, color.blue, "TP2 SELL", true)
        box.new(bar_index - 20, 60138.72 + offset, bar_index + 40, 59861.28 + offset, border_color=color.green, bgcolor=color.new(color.green, 85), text="BUY Alternatif 34%", text_color=color.green, text_size=size.small)
        drawLine(59237.02, color.red, "SL BUY", true)
        drawLine(60763.39, color.blue, "TP1 BUY", true)
        drawLine(61830.00, color.blue, "TP2 BUY", true)

inZone0 = close >= 60624.67 + offset and close <= 60902.11 + offset
alertcondition(inZone0 and not inZone0[1], "KPX SELL Utama: masuk zona", "BTCUSD masuk zona SELL {{close}} - EA entry")
inZone1 = close >= 59861.28 + offset and close <= 60138.72 + offset
alertcondition(inZone1 and not inZone1[1], "KPX BUY Alternatif: masuk zona", "BTCUSD masuk zona BUY {{close}} - EA entry")
plot(na, "KPX")
