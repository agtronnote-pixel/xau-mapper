//@version=6
indicator("KPX Mapping BTCUSD 202611272207", overlay=true, max_lines_count=100, max_boxes_count=20, max_labels_count=60)
// Dibuat otomatis oleh Kantor Pine (BTCUSD) dari mapping 2026-11-27T15:07:30.920Z (harga 59028.42).
// Bukan nasihat keuangan. Konfirmasi di chart dan selalu gunakan stop loss.
offset = input.float(0.0, "Selisih harga broker - mapping (USD)", group="Umum", tooltip="Isi bila harga broker berbeda dari harga mapping")
showLevels = input.bool(true, "Tampilkan level kunci", group="Tampilan")
showPlans = input.bool(true, "Tampilkan rencana entry", group="Tampilan")

drawLine(float p, color c, string t, bool solid) =>
    line.new(bar_index - 1, p + offset, bar_index, p + offset, extend=extend.both, color=c, style=solid ? line.style_solid : line.style_dashed, width=1)
    label.new(bar_index + 3, p + offset, t + " " + str.tostring(p + offset, "#.00"), style=label.style_none, textcolor=c, size=size.small)

var bool drawn = false
if barstate.islast and not drawn
    drawn := true
    if showLevels
        drawLine(62248.91, color.red, "R Swing high H1", false)
        drawLine(61881.03, color.red, "R Swing high H1", false)
        drawLine(61622.38, color.red, "R High kemarin (PDH)", false)
        drawLine(61070.01, color.red, "R Swing high H1", false)
        drawLine(60704.85, color.gray, "P Pivot harian", false)
        drawLine(60380.01, color.red, "R Swing low H1", false)
        drawLine(59915.00, color.red, "R Low kemarin (PDL)", false)
        drawLine(59500.00, color.red, "R Angka bulat", false)
        drawLine(59000.00, color.green, "S Angka bulat", false)
        drawLine(58500.00, color.green, "S Angka bulat", false)
    if showPlans
        box.new(bar_index - 20, 59615.92 + offset, bar_index + 40, 59384.08 + offset, border_color=color.red, bgcolor=color.new(color.red, 85), text="SELL Utama 53%", text_color=color.red, text_size=size.small)
        drawLine(60137.57, color.red, "SL SELL", true)
        drawLine(58500.00, color.blue, "TP1 SELL", true)
        drawLine(57587.29, color.blue, "TP2 SELL", true)
        box.new(bar_index - 20, 58615.92 + offset, bar_index + 40, 58384.08 + offset, border_color=color.green, bgcolor=color.new(color.green, 85), text="BUY Alternatif 50%", text_color=color.green, text_size=size.small)
        drawLine(57862.43, color.red, "SL BUY", true)
        drawLine(59500.00, color.blue, "TP1 BUY", true)
        drawLine(59915.00, color.blue, "TP2 BUY", true)

inZone0 = close >= 59384.08 + offset and close <= 59615.92 + offset
alertcondition(inZone0 and not inZone0[1], "KPX SELL Utama: masuk zona", "BTCUSD masuk zona SELL {{close}} - EA entry")
inZone1 = close >= 58384.08 + offset and close <= 58615.92 + offset
alertcondition(inZone1 and not inZone1[1], "KPX BUY Alternatif: masuk zona", "BTCUSD masuk zona BUY {{close}} - EA entry")
plot(na, "KPX")
