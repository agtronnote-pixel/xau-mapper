//@version=6
indicator("KPX Mapping BTCUSD 202611271907", overlay=true, max_lines_count=100, max_boxes_count=20, max_labels_count=60)
// Dibuat otomatis oleh Kantor Pine (BTCUSD) dari mapping 2026-11-27T12:07:27.771Z (harga 61642.42).
// Bukan nasihat keuangan. Konfirmasi di chart dan selalu gunakan stop loss.
offset = input.float(0.0, "Selisih harga broker - mapping (USD)", group="Umum", tooltip="Isi bila harga broker berbeda dari harga mapping")
showLevels = input.bool(true, "Tampilkan level kunci", group="Tampilan")
showPlans = input.bool(true, "Tampilkan rencana entry", group="Tampilan")

drawLine(float p, color c, string t, bool solid) =>
    line.new(bar_index - 1, p + offset, bar_index, p + offset, extend=extend.both, color=c, style=solid ? line.style_solid : line.style_dashed, width=1)
    label.new(bar_index + 3, p + offset, t + " " + str.tostring(p + offset, "#.00"), style=label.style_none, textcolor=c, size=size.small)

var bool drawn = false
if barstate.islast and not drawn
    drawn := true
    if showLevels
        drawLine(62248.91, color.red, "R Swing high H1", false)
        drawLine(62000.00, color.red, "R Angka bulat", false)
        drawLine(61881.03, color.red, "R Swing high H1", false)
        drawLine(61622.38, color.green, "S High kemarin (PDH)", false)
        drawLine(61502.95, color.green, "S R1 harian", false)
        drawLine(61070.01, color.green, "S Swing high H1", false)
        drawLine(60708.98, color.gray, "P Pivot harian", false)
        drawLine(60380.01, color.green, "S Swing low H1", false)
        drawLine(59915.00, color.green, "S Low kemarin (PDL)", false)
        drawLine(59795.57, color.green, "S S1 harian", false)
    if showPlans
        box.new(bar_index - 20, 61587.27 + offset, bar_index + 40, 61418.63 + offset, border_color=color.green, bgcolor=color.new(color.green, 85), text="BUY Utama 77%", text_color=color.green, text_size=size.small)
        drawLine(61039.18, color.red, "SL BUY", true)
        drawLine(62000.00, color.blue, "TP1 BUY", true)
        drawLine(62248.91, color.blue, "TP2 BUY", true)
        box.new(bar_index - 20, 61965.35 + offset, bar_index + 40, 61796.71 + offset, border_color=color.red, bgcolor=color.new(color.red, 85), text="SELL Alternatif 25%", text_color=color.red, text_size=size.small)
        drawLine(62344.80, color.red, "SL SELL", true)
        drawLine(61070.01, color.blue, "TP1 SELL", true)
        drawLine(60708.98, color.blue, "TP2 SELL", true)

inZone0 = close >= 61418.63 + offset and close <= 61587.27 + offset
alertcondition(inZone0 and not inZone0[1], "KPX BUY Utama: masuk zona", "BTCUSD masuk zona BUY {{close}} - EA entry")
inZone1 = close >= 61796.71 + offset and close <= 61965.35 + offset
alertcondition(inZone1 and not inZone1[1], "KPX SELL Alternatif: masuk zona", "BTCUSD masuk zona SELL {{close}} - EA entry")
plot(na, "KPX")
