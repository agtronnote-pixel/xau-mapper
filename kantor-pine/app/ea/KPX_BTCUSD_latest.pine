//@version=6
indicator("KPX Mapping BTCUSD 202611252307", overlay=true, max_lines_count=100, max_boxes_count=20, max_labels_count=60)
// Dibuat otomatis oleh Kantor Pine (BTCUSD) dari mapping 2026-11-25T16:07:31.278Z (harga 58416.27).
// Bukan nasihat keuangan. Konfirmasi di chart dan selalu gunakan stop loss.
offset = input.float(0.0, "Selisih harga broker - mapping (USD)", group="Umum", tooltip="Isi bila harga broker berbeda dari harga mapping")
showLevels = input.bool(true, "Tampilkan level kunci", group="Tampilan")
showPlans = input.bool(true, "Tampilkan rencana entry", group="Tampilan")

drawLine(float p, color c, string t, bool solid) =>
    line.new(bar_index - 1, p + offset, bar_index, p + offset, extend=extend.both, color=c, style=solid ? line.style_solid : line.style_dashed, width=1)
    label.new(bar_index + 3, p + offset, t + " " + str.tostring(p + offset, "#.00"), style=label.style_none, textcolor=c, size=size.small)

var bool drawn = false
if barstate.islast and not drawn
    drawn := true
    if showLevels
        drawLine(61682.01, color.red, "R High kemarin (PDH)", false)
        drawLine(61256.01, color.red, "R R1 harian", false)
        drawLine(60258.00, color.gray, "P Pivot harian", false)
        drawLine(59489.63, color.red, "R Swing high H1", false)
        drawLine(59260.00, color.red, "R Low kemarin (PDL)", false)
        drawLine(59000.00, color.red, "R Angka bulat", false)
        drawLine(58834.00, color.red, "R S1 harian", false)
        drawLine(58633.12, color.red, "R Swing low H1", false)
        drawLine(58000.00, color.green, "S Angka bulat", false)
        drawLine(57300.38, color.green, "S Swing low H1", false)
    if showPlans
        box.new(bar_index - 20, 58757.94 + offset, bar_index + 40, 58508.30 + offset, border_color=color.red, bgcolor=color.new(color.red, 85), text="SELL Utama 79%", text_color=color.red, text_size=size.small)
        drawLine(59319.64, color.red, "SL SELL", true)
        drawLine(57300.38, color.blue, "TP1 SELL", true)
        drawLine(56573.56, color.blue, "TP2 SELL", true)
        box.new(bar_index - 20, 58124.82 + offset, bar_index + 40, 57875.18 + offset, border_color=color.green, bgcolor=color.new(color.green, 85), text="BUY Alternatif 24%", text_color=color.green, text_size=size.small)
        drawLine(57313.48, color.red, "SL BUY", true)
        drawLine(58834.00, color.blue, "TP1 BUY", true)
        drawLine(59260.00, color.blue, "TP2 BUY", true)

inZone0 = close >= 58508.30 + offset and close <= 58757.94 + offset
alertcondition(inZone0 and not inZone0[1], "KPX SELL Utama: masuk zona", "BTCUSD masuk zona SELL {{close}} - EA entry")
inZone1 = close >= 57875.18 + offset and close <= 58124.82 + offset
alertcondition(inZone1 and not inZone1[1], "KPX BUY Alternatif: masuk zona", "BTCUSD masuk zona BUY {{close}} - EA entry")
plot(na, "KPX")
