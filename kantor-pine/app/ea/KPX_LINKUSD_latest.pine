//@version=6
indicator("KPX Mapping LINKUSD 202611241107", overlay=true, max_lines_count=100, max_boxes_count=20, max_labels_count=60)
// Dibuat otomatis oleh Kantor Pine (LINKUSD) dari mapping 2026-11-24T04:07:27.217Z (harga 9.0290).
// Bukan nasihat keuangan. Konfirmasi di chart dan selalu gunakan stop loss.
offset = input.float(0.0, "Selisih harga broker - mapping (USD)", group="Umum", tooltip="Isi bila harga broker berbeda dari harga mapping")
showLevels = input.bool(true, "Tampilkan level kunci", group="Tampilan")
showPlans = input.bool(true, "Tampilkan rencana entry", group="Tampilan")

drawLine(float p, color c, string t, bool solid) =>
    line.new(bar_index - 1, p + offset, bar_index, p + offset, extend=extend.both, color=c, style=solid ? line.style_solid : line.style_dashed, width=1)
    label.new(bar_index + 3, p + offset, t + " " + str.tostring(p + offset, "#.00"), style=label.style_none, textcolor=c, size=size.small)

var bool drawn = false
if barstate.islast and not drawn
    drawn := true
    if showLevels
        drawLine(9.5580, color.red, "R High kemarin (PDH)", false)
        drawLine(9.4747, color.red, "R R1 harian", false)
        drawLine(9.1560, color.red, "R Swing high H1", false)
        drawLine(9.0933, color.gray, "P Pivot harian", false)
        drawLine(9.0500, color.red, "R Angka bulat", false)
        drawLine(8.9810, color.green, "S Swing high H1", false)
        drawLine(8.9240, color.green, "S Swing low H1", false)
        drawLine(8.8500, color.green, "S Swing high H1", false)
        drawLine(8.7120, color.green, "S Low kemarin (PDL)", false)
        drawLine(8.6287, color.green, "S S1 harian", false)
    if showPlans
        box.new(bar_index - 20, 9.0091 + offset, bar_index + 40, 8.9529 + offset, border_color=color.green, bgcolor=color.new(color.green, 85), text="BUY Range 50%", text_color=color.green, text_size=size.small)
        drawLine(8.8265, color.red, "SL BUY", true)
        drawLine(9.1560, color.blue, "TP1 BUY", true)
        drawLine(9.4747, color.blue, "TP2 BUY", true)
        box.new(bar_index - 20, 9.1214 + offset, bar_index + 40, 9.0652 + offset, border_color=color.red, bgcolor=color.new(color.red, 85), text="SELL Range 49%", text_color=color.red, text_size=size.small)
        drawLine(9.2479, color.red, "SL SELL", true)
        drawLine(8.9240, color.blue, "TP1 SELL", true)
        drawLine(8.7120, color.blue, "TP2 SELL", true)

inZone0 = close >= 8.9529 + offset and close <= 9.0091 + offset
alertcondition(inZone0 and not inZone0[1], "KPX BUY Range: masuk zona", "LINKUSD masuk zona BUY {{close}} - EA entry")
inZone1 = close >= 9.0652 + offset and close <= 9.1214 + offset
alertcondition(inZone1 and not inZone1[1], "KPX SELL Range: masuk zona", "LINKUSD masuk zona SELL {{close}} - EA entry")
plot(na, "KPX")
