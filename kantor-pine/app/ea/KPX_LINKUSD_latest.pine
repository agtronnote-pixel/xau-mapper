//@version=6
indicator("KPX Mapping LINKUSD 202611252007", overlay=true, max_lines_count=100, max_boxes_count=20, max_labels_count=60)
// Dibuat otomatis oleh Kantor Pine (LINKUSD) dari mapping 2026-11-25T13:07:25.403Z (harga 8.6280).
// Bukan nasihat keuangan. Konfirmasi di chart dan selalu gunakan stop loss.
offset = input.float(0.0, "Selisih harga broker - mapping (USD)", group="Umum", tooltip="Isi bila harga broker berbeda dari harga mapping")
showLevels = input.bool(true, "Tampilkan level kunci", group="Tampilan")
showPlans = input.bool(true, "Tampilkan rencana entry", group="Tampilan")

drawLine(float p, color c, string t, bool solid) =>
    line.new(bar_index - 1, p + offset, bar_index, p + offset, extend=extend.both, color=c, style=solid ? line.style_solid : line.style_dashed, width=1)
    label.new(bar_index + 3, p + offset, t + " " + str.tostring(p + offset, "#.00"), style=label.style_none, textcolor=c, size=size.small)

var bool drawn = false
if barstate.islast and not drawn
    drawn := true
    if showLevels
        drawLine(9.1560, color.red, "R High kemarin (PDH)", false)
        drawLine(9.0900, color.red, "R R1 harian", false)
        drawLine(8.9120, color.gray, "P Pivot harian", false)
        drawLine(8.8850, color.red, "R Swing high H1", false)
        drawLine(8.8320, color.red, "R Swing high H1", false)
        drawLine(8.7980, color.red, "R Swing high H1", false)
        drawLine(8.7340, color.red, "R Low kemarin (PDL)", false)
        drawLine(8.7090, color.red, "R Swing low H1", false)
        drawLine(8.6680, color.red, "R S1 harian", false)
        drawLine(8.5800, color.green, "S Swing low H1", false)
    if showPlans
        box.new(bar_index - 20, 8.6845 + offset, bar_index + 40, 8.6515 + offset, border_color=color.red, bgcolor=color.new(color.red, 85), text="SELL Utama 70%", text_color=color.red, text_size=size.small)
        drawLine(8.7587, color.red, "SL SELL", true)
        drawLine(8.5319, color.blue, "TP1 SELL", true)
        drawLine(8.3959, color.blue, "TP2 SELL", true)
        box.new(bar_index - 20, 8.5965 + offset, bar_index + 40, 8.5635 + offset, border_color=color.green, bgcolor=color.new(color.green, 85), text="BUY Alternatif 22%", text_color=color.green, text_size=size.small)
        drawLine(8.4893, color.red, "SL BUY", true)
        drawLine(8.7090, color.blue, "TP1 BUY", true)
        drawLine(8.7980, color.blue, "TP2 BUY", true)

inZone0 = close >= 8.6515 + offset and close <= 8.6845 + offset
alertcondition(inZone0 and not inZone0[1], "KPX SELL Utama: masuk zona", "LINKUSD masuk zona SELL {{close}} - EA entry")
inZone1 = close >= 8.5635 + offset and close <= 8.5965 + offset
alertcondition(inZone1 and not inZone1[1], "KPX BUY Alternatif: masuk zona", "LINKUSD masuk zona BUY {{close}} - EA entry")
plot(na, "KPX")
