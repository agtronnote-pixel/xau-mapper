//@version=6
indicator("KPX Mapping LINKUSD 202611270207", overlay=true, max_lines_count=100, max_boxes_count=20, max_labels_count=60)
// Dibuat otomatis oleh Kantor Pine (LINKUSD) dari mapping 2026-11-26T19:07:22.152Z (harga 9.2750).
// Bukan nasihat keuangan. Konfirmasi di chart dan selalu gunakan stop loss.
offset = input.float(0.0, "Selisih harga broker - mapping (USD)", group="Umum", tooltip="Isi bila harga broker berbeda dari harga mapping")
showLevels = input.bool(true, "Tampilkan level kunci", group="Tampilan")
showPlans = input.bool(true, "Tampilkan rencana entry", group="Tampilan")

drawLine(float p, color c, string t, bool solid) =>
    line.new(bar_index - 1, p + offset, bar_index, p + offset, extend=extend.both, color=c, style=solid ? line.style_solid : line.style_dashed, width=1)
    label.new(bar_index + 3, p + offset, t + " " + str.tostring(p + offset, "#.00"), style=label.style_none, textcolor=c, size=size.small)

var bool drawn = false
if barstate.islast and not drawn
    drawn := true
    if showLevels
        drawLine(9.3500, color.red, "R Angka bulat", false)
        drawLine(9.3077, color.red, "R R1 harian", false)
        drawLine(9.2880, color.red, "R Swing high H1", false)
        drawLine(9.2650, color.green, "S Swing high H1", false)
        drawLine(9.1370, color.green, "S High kemarin (PDH)", false)
        drawLine(9.0360, color.green, "S Swing low H1", false)
        drawLine(8.9950, color.green, "S Swing low H1", false)
        drawLine(8.8853, color.gray, "P Pivot harian", false)
        drawLine(8.6337, color.green, "S S1 harian", false)
        drawLine(8.4630, color.green, "S Low kemarin (PDL)", false)
    if showPlans
        box.new(bar_index - 20, 9.1525 + offset, bar_index + 40, 9.1215 + offset, border_color=color.green, bgcolor=color.new(color.green, 85), text="BUY Utama 72%", text_color=color.green, text_size=size.small)
        drawLine(9.0516, color.red, "SL BUY", true)
        drawLine(9.3077, color.blue, "TP1 BUY", true)
        drawLine(9.3932, color.blue, "TP2 BUY", true)
        box.new(bar_index - 20, 9.3232 + offset, bar_index + 40, 9.2922 + offset, border_color=color.red, bgcolor=color.new(color.red, 85), text="SELL Alternatif 34%", text_color=color.red, text_size=size.small)
        drawLine(9.3931, color.red, "SL SELL", true)
        drawLine(9.1370, color.blue, "TP1 SELL", true)
        drawLine(9.0360, color.blue, "TP2 SELL", true)

inZone0 = close >= 9.1215 + offset and close <= 9.1525 + offset
alertcondition(inZone0 and not inZone0[1], "KPX BUY Utama: masuk zona", "LINKUSD masuk zona BUY {{close}} - EA entry")
inZone1 = close >= 9.2922 + offset and close <= 9.3232 + offset
alertcondition(inZone1 and not inZone1[1], "KPX SELL Alternatif: masuk zona", "LINKUSD masuk zona SELL {{close}} - EA entry")
plot(na, "KPX")
