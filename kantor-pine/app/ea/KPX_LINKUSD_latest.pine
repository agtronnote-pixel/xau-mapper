//@version=6
indicator("KPX Mapping LINKUSD 202611230126", overlay=true, max_lines_count=100, max_boxes_count=20, max_labels_count=60)
// Dibuat otomatis oleh Kantor Pine (LINKUSD) dari mapping 2026-11-22T18:26:00.408Z (harga 8.8100).
// Bukan nasihat keuangan. Konfirmasi di chart dan selalu gunakan stop loss.
offset = input.float(0.0, "Selisih harga broker - mapping (USD)", group="Umum", tooltip="Isi bila harga broker berbeda dari harga mapping")
showLevels = input.bool(true, "Tampilkan level kunci", group="Tampilan")
showPlans = input.bool(true, "Tampilkan rencana entry", group="Tampilan")

drawLine(float p, color c, string t, bool solid) =>
    line.new(bar_index - 1, p + offset, bar_index, p + offset, extend=extend.both, color=c, style=solid ? line.style_solid : line.style_dashed, width=1)
    label.new(bar_index + 3, p + offset, t + " " + str.tostring(p + offset, "#.00"), style=label.style_none, textcolor=c, size=size.small)

var bool drawn = false
if barstate.islast and not drawn
    drawn := true
    if showLevels
        drawLine(8.8933, color.red, "R R1 harian", false)
        drawLine(8.8560, color.red, "R Swing high H1", false)
        drawLine(8.8000, color.green, "S Angka bulat", false)
        drawLine(8.7370, color.green, "S Swing low H1", false)
        drawLine(8.7140, color.green, "S High kemarin (PDH)", false)
        drawLine(8.6620, color.green, "S Swing high H1", false)
        drawLine(8.6210, color.green, "S Swing high H1", false)
        drawLine(8.5560, color.green, "S Swing low H1", false)
        drawLine(8.4940, color.green, "S Swing low H1", false)
        drawLine(8.4327, color.gray, "P Pivot harian", false)
        drawLine(8.1513, color.green, "S S1 harian", false)
        drawLine(7.9720, color.green, "S Low kemarin (PDL)", false)
    if showPlans
        box.new(bar_index - 20, 8.7538 + offset, bar_index + 40, 8.7202 + offset, border_color=color.green, bgcolor=color.new(color.green, 85), text="BUY Range 57%", text_color=color.green, text_size=size.small)
        drawLine(8.6446, color.red, "SL BUY", true)
        drawLine(8.8560, color.blue, "TP1 BUY", true)
        drawLine(9.0142, color.blue, "TP2 BUY", true)
        box.new(bar_index - 20, 8.8728 + offset, bar_index + 40, 8.8392 + offset, border_color=color.red, bgcolor=color.new(color.red, 85), text="SELL Range 43%", text_color=color.red, text_size=size.small)
        drawLine(8.9484, color.red, "SL SELL", true)
        drawLine(8.7370, color.blue, "TP1 SELL", true)
        drawLine(8.6620, color.blue, "TP2 SELL", true)

inZone0 = close >= 8.7202 + offset and close <= 8.7538 + offset
alertcondition(inZone0 and not inZone0[1], "KPX BUY Range: masuk zona", "LINKUSD masuk zona BUY {{close}} - EA entry")
inZone1 = close >= 8.8392 + offset and close <= 8.8728 + offset
alertcondition(inZone1 and not inZone1[1], "KPX SELL Range: masuk zona", "LINKUSD masuk zona SELL {{close}} - EA entry")
plot(na, "KPX")
