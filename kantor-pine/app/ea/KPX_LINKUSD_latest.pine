//@version=6
indicator("KPX Mapping LINKUSD 202611281807", overlay=true, max_lines_count=100, max_boxes_count=20, max_labels_count=60)
// Dibuat otomatis oleh Kantor Pine (LINKUSD) dari mapping 2026-11-28T11:07:22.532Z (harga 9.1550).
// Bukan nasihat keuangan. Konfirmasi di chart dan selalu gunakan stop loss.
offset = input.float(0.0, "Selisih harga broker - mapping (USD)", group="Umum", tooltip="Isi bila harga broker berbeda dari harga mapping")
showLevels = input.bool(true, "Tampilkan level kunci", group="Tampilan")
showPlans = input.bool(true, "Tampilkan rencana entry", group="Tampilan")

drawLine(float p, color c, string t, bool solid) =>
    line.new(bar_index - 1, p + offset, bar_index, p + offset, extend=extend.both, color=c, style=solid ? line.style_solid : line.style_dashed, width=1)
    label.new(bar_index + 3, p + offset, t + " " + str.tostring(p + offset, "#.00"), style=label.style_none, textcolor=c, size=size.small)

var bool drawn = false
if barstate.islast and not drawn
    drawn := true
    if showLevels
        drawLine(9.7180, color.red, "R High kemarin (PDH)", false)
        drawLine(9.6843, color.red, "R R1 harian", false)
        drawLine(9.5550, color.red, "R Swing low H1", false)
        drawLine(9.4320, color.red, "R Swing high H1", false)
        drawLine(9.3917, color.gray, "P Pivot harian", false)
        drawLine(9.2480, color.red, "R Swing low H1", false)
        drawLine(9.2020, color.red, "R Swing high H1", false)
        drawLine(9.1500, color.green, "S Angka bulat", false)
        drawLine(9.0990, color.green, "S Low kemarin (PDL)", false)
        drawLine(9.0820, color.green, "S Swing low H1", false)
        drawLine(9.0653, color.green, "S S1 harian", false)
    if showPlans
        box.new(bar_index - 20, 9.2153 + offset, bar_index + 40, 9.1887 + offset, border_color=color.red, bgcolor=color.new(color.red, 85), text="SELL Utama 77%", text_color=color.red, text_size=size.small)
        drawLine(9.2753, color.red, "SL SELL", true)
        drawLine(9.0990, color.blue, "TP1 SELL", true)
        drawLine(8.9821, color.blue, "TP2 SELL", true)
        box.new(bar_index - 20, 9.1123 + offset, bar_index + 40, 9.0857 + offset, border_color=color.green, bgcolor=color.new(color.green, 85), text="BUY Alternatif 25%", text_color=color.green, text_size=size.small)
        drawLine(9.0257, color.red, "SL BUY", true)
        drawLine(9.2020, color.blue, "TP1 BUY", true)
        drawLine(9.2480, color.blue, "TP2 BUY", true)

inZone0 = close >= 9.1887 + offset and close <= 9.2153 + offset
alertcondition(inZone0 and not inZone0[1], "KPX SELL Utama: masuk zona", "LINKUSD masuk zona SELL {{close}} - EA entry")
inZone1 = close >= 9.0857 + offset and close <= 9.1123 + offset
alertcondition(inZone1 and not inZone1[1], "KPX BUY Alternatif: masuk zona", "LINKUSD masuk zona BUY {{close}} - EA entry")
plot(na, "KPX")
