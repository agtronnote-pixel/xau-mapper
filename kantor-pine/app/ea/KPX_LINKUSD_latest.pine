//@version=6
indicator("KPX Mapping LINKUSD 202611250607", overlay=true, max_lines_count=100, max_boxes_count=20, max_labels_count=60)
// Dibuat otomatis oleh Kantor Pine (LINKUSD) dari mapping 2026-11-24T23:07:31.243Z (harga 8.8710).
// Bukan nasihat keuangan. Konfirmasi di chart dan selalu gunakan stop loss.
offset = input.float(0.0, "Selisih harga broker - mapping (USD)", group="Umum", tooltip="Isi bila harga broker berbeda dari harga mapping")
showLevels = input.bool(true, "Tampilkan level kunci", group="Tampilan")
showPlans = input.bool(true, "Tampilkan rencana entry", group="Tampilan")

drawLine(float p, color c, string t, bool solid) =>
    line.new(bar_index - 1, p + offset, bar_index, p + offset, extend=extend.both, color=c, style=solid ? line.style_solid : line.style_dashed, width=1)
    label.new(bar_index + 3, p + offset, t + " " + str.tostring(p + offset, "#.00"), style=label.style_none, textcolor=c, size=size.small)

var bool drawn = false
if barstate.islast and not drawn
    drawn := true
    if showLevels
        drawLine(9.5580, color.red, "R High kemarin (PDH)", false)
        drawLine(9.4773, color.red, "R R1 harian", false)
        drawLine(9.1560, color.red, "R Swing high H1", false)
        drawLine(9.0947, color.gray, "P Pivot harian", false)
        drawLine(8.9360, color.red, "R Swing high H1", false)
        drawLine(8.8890, color.red, "R Swing low H1", false)
        drawLine(8.8500, color.green, "S Angka bulat", false)
        drawLine(8.7960, color.green, "S Swing low H1", false)
        drawLine(8.7120, color.green, "S Low kemarin (PDL)", false)
        drawLine(8.6313, color.green, "S S1 harian", false)
    if showPlans
        box.new(bar_index - 20, 8.9568 + offset, bar_index + 40, 8.9152 + offset, border_color=color.red, bgcolor=color.new(color.red, 85), text="SELL Utama 63%", text_color=color.red, text_size=size.small)
        drawLine(9.0502, color.red, "SL SELL", true)
        drawLine(8.7960, color.blue, "TP1 SELL", true)
        drawLine(8.7120, color.blue, "TP2 SELL", true)
        box.new(bar_index - 20, 8.8708 + offset, bar_index + 40, 8.8292 + offset, border_color=color.green, bgcolor=color.new(color.green, 85), text="BUY Alternatif 28%", text_color=color.green, text_size=size.small)
        drawLine(8.7358, color.red, "SL BUY", true)
        drawLine(9.0213, color.blue, "TP1 BUY", true)
        drawLine(9.0947, color.blue, "TP2 BUY", true)

inZone0 = close >= 8.9152 + offset and close <= 8.9568 + offset
alertcondition(inZone0 and not inZone0[1], "KPX SELL Utama: masuk zona", "LINKUSD masuk zona SELL {{close}} - EA entry")
inZone1 = close >= 8.8292 + offset and close <= 8.8708 + offset
alertcondition(inZone1 and not inZone1[1], "KPX BUY Alternatif: masuk zona", "LINKUSD masuk zona BUY {{close}} - EA entry")
plot(na, "KPX")
